---
// Ubicacion: solo publica datos confirmados. Sin direccion/ciudad/horario
// confirmados se muestra "Por confirmar"; sin enlace de Google Maps no hay
// boton "Como llegar" enlazado ni mapa. Gancho fase 4: data-mapa (Leaflet)
// y data-pin (pin animado).
import BotonWhatsapp from './BotonWhatsapp.astro';
import Icono from './Icono.astro';
import { datoConfirmado, textos, PENDIENTE } from '../lib/negocio';

const t = textos.ubicacion;
const direccion = datoConfirmado('direccion');
const ciudad = datoConfirmado('ciudad');
const horario = datoConfirmado('horario');
const mapa = datoConfirmado('googleMaps');

const filas = [
  { etiqueta: t.etiquetaDireccion, valor: direccion, icono: 'pin' },
  { etiqueta: t.etiquetaCiudad, valor: ciudad, icono: 'ciudad' },
  { etiqueta: t.etiquetaHorario, valor: horario, icono: 'reloj' },
];
---
<section id={t.id} class="bg-blanco py-seccion" aria-labelledby="titulo-ubicacion" data-escena="ubicacion">
  <div class="contenedor grid gap-bloque lg:grid-cols-2 lg:items-center">
    <div data-revelar-hijos>
      <h2 id="titulo-ubicacion" class="text-h2">{t.titulo}</h2>
      <p class="mt-4 max-w-texto text-lead">{t.intro}</p>

      <dl class="mt-8 space-y-5">
        {filas.map((f) => (
          <div>
            <dt class="flex items-center gap-4 font-bold text-bosque">
              <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-hoja-claro text-marca-fuerte" aria-hidden="true">
                <Icono nombre={f.icono} class="size-5" />
              </span>
              {f.etiqueta}
            </dt>
            <dd class="pl-15">
              {f.valor ? <span class="text-tinta">{f.valor}</span> : <span class="pendiente">{PENDIENTE}</span>}
            </dd>
          </div>
        ))}
      </dl>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        {mapa ? (
          <a href={mapa} class="boton boton-oro" target="_blank" rel="noopener">
            <Icono nombre="pin" class="size-5" />
            {t.ctaComoLlegar}<span class="sr-only"> (se abre en una pestaña nueva)</span>
          </a>
        ) : (
          <span class="boton boton-pendiente">
            <Icono nombre="pin" class="size-5" />
            {t.ctaComoLlegar}: {PENDIENTE.toLowerCase()}
          </span>
        )}
        <BotonWhatsapp texto={t.ctaWhatsapp} />
      </div>
    </div>

    <!-- Hueco del mapa: Leaflet/OSM se carga en la fase 4 cuando haya coordenadas -->
    <div
      class="mapa-vacio relative flex aspect-[4/3] items-center justify-center overflow-hidden rounded-panel border-4 border-bosque bg-crema"
      data-mapa
      data-revelar
      data-lat=""
      data-lng=""
    >
      <div class="relative flex flex-col items-center px-6 text-center">
        <svg class="w-20" viewBox="0 0 64 84" aria-hidden="true" data-pin>
          <ellipse cx="32" cy="80" rx="14" ry="3.5" fill="#14301d" opacity=".18" />
          <path d="M32 76S6 50 6 30a26 26 0 0 1 52 0c0 20-26 46-26 46z" fill="#1b4d2b" />
          <circle cx="32" cy="30" r="17" fill="#f6f1e4" stroke="#f2b823" stroke-width="4" />
          <path d="M26 21v18M38 21v18M26 30h12" stroke="#2e8b2e" stroke-width="5" stroke-linecap="round" />
        </svg>
        <p class="mt-4 font-bold text-bosque">{t.mapaNoDisponible}</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Retícula de "plano" muy suave mientras no hay mapa real */
  .mapa-vacio {
    background-image:
      linear-gradient(var(--color-crema-oscuro) 2px, transparent 2px),
      linear-gradient(90deg, var(--color-crema-oscuro) 2px, transparent 2px);
    background-size: 48px 48px;
    background-position: center;
  }
</style>
