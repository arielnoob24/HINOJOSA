---
// Barra de navegacion entre vistas (unico mecanismo de navegacion global).
// - Anclas reales (<a href="#vista">): funcionan sin JS y con el historial.
// - router.ts pone aria-current="page" en la vista activa; aqui la pastilla
//   de fondo + peso 800 hacen que no dependa solo del color (WCAG 1.4.1).
// - >= 48rem: barra superior. < 48rem: logo arriba y los 5 enlaces abajo,
//   con icono + palabra (objetivos de 44 px o mas).
// - Etiquetas cortas hasta 64rem (no caben las largas con el logo).
// Gancho de animacion: [data-barra], a[data-nav-vista], [aria-current].
import Icono from './Icono.astro';
import { negocio, textos } from '../lib/negocio';

const enlaces = textos.navegacion;
// Etiquetas cortas e iconos (MIGRAR a textos.json > navegacion si se aprueban)
const extra: Record<string, { corto: string; icono: string }> = {
  inicio: { corto: 'Inicio', icono: 'casa' },
  nosotros: { corto: 'Nosotros', icono: 'corazon' },
  productos: { corto: 'Productos', icono: 'costal' },
  'por-que': { corto: 'Por qué', icono: 'medalla' },
  visitanos: { corto: 'Visítanos', icono: 'pin' },
};
---
<header class="barra" data-barra>
  <div class="barra-interior">
    <a href="#inicio" class="barra-logo">
      <!-- 36-40 px en pantalla: la variante de 98 px cubre hasta DPR 2,4;
           la de 263 px solo se pide en pantallas de mas densidad (QA M7) -->
      <img
        src="/img/marca/isotipo-96.webp"
        srcset="/img/marca/isotipo-96.webp 98w, /img/marca/isotipo.webp 263w"
        sizes="(min-width: 40rem) 2.5rem, 2.25rem"
        alt=""
        width="98"
        height="96"
        class="size-9 shrink-0 sm:size-10"
        decoding="async"
      />
      <span class="font-display leading-none font-extrabold text-bosque">
        <span class="block text-[0.6875rem] tracking-[0.2em] text-canela-oscuro">COMERCIAL</span>
        <span class="text-lg">Hinojosa</span><span class="sr-only">, {negocio.nombre}: ir al inicio</span>
      </span>
    </a>

    <nav aria-label={textos.comunes.etiquetaNavegacion} class="barra-nav">
      <!-- Pastilla de la vista activa que se desliza (src/lib/animacion/vistas.ts).
           Sin JS no se muestra: la pastilla la pinta el propio enlace. -->
      <span class="barra-pastilla" aria-hidden="true" data-pastilla></span>
      <ul class="barra-lista">
        {enlaces.map((e) => {
          const x = extra[e.id] ?? { corto: e.texto, icono: 'hoja' };
          const distinto = x.corto !== e.texto;
          return (
            <li>
              <a href={e.hash} class="barra-enlace" data-nav-vista={e.id}>
                <span class="barra-icono"><Icono nombre={x.icono} class="size-6" /></span>
                {distinto ? (
                  <>
                    <span class="lg:hidden">{x.corto}</span>
                    <span class="hidden lg:inline">{e.texto}</span>
                  </>
                ) : (
                  <span>{e.texto}</span>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .barra {
    position: relative;
    z-index: var(--z-barra, 50);
    background: var(--color-crema);
    box-shadow: var(--shadow-barra);
  }
  .barra-interior {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    width: 100%;
    max-width: var(--container-contenido);
    margin-inline: auto;
    padding: 0.375rem 1rem;
  }
  .barra-logo {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.625rem;
    border-radius: var(--radius-boton);
    padding-right: 0.5rem;
  }
  .barra-lista {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .barra-enlace {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.375rem;
    border-radius: var(--radius-boton);
    padding: 0.375rem 0.875rem;
    font-size: var(--text-etiqueta);
    font-weight: 400;
    color: var(--color-bosque);
    white-space: nowrap;
    transition: background-color var(--duracion-hover, 200ms) ease, color var(--duracion-hover, 200ms) ease;
  }
  .barra-enlace:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  /* Vista activa: pastilla bosque + texto blanco (9.80) + peso 800 */
  .barra-enlace[aria-current='page'] {
    background: var(--color-indicador, #1b4d2b);
    color: var(--color-blanco);
    font-weight: 800;
  }
  .barra-enlace[aria-current='page']:hover {
    text-decoration: none;
  }
  .barra-icono {
    display: none;
  }

  /* --------- Pastilla deslizante (solo con JS) ---------
     La forma rellena + peso 800 siguen siendo la senal no cromatica: la
     pastilla solo sustituye al fondo del enlace activo. */
  .barra-nav {
    position: relative;
  }
  .barra-pastilla {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    width: var(--pastilla-w, 0);
    height: var(--pastilla-h, 0);
    border-radius: var(--radius-chip);
    background: var(--color-indicador);
    opacity: 0;
    pointer-events: none;
    transform: translate3d(var(--pastilla-x, 0), var(--pastilla-y, 0), 0);
  }
  .barra-pastilla.anima {
    transition:
      transform var(--duracion-indicador) var(--ease-vista),
      width var(--duracion-indicador) var(--ease-vista),
      height var(--duracion-indicador) var(--ease-vista);
  }
  .barra-lista {
    position: relative;
    z-index: 1;
  }
  :global(html.pastilla-lista) .barra-pastilla {
    opacity: 1;
  }
  :global(html.pastilla-lista) .barra-enlace {
    transition: color var(--duracion-indicador) var(--ease-vista);
  }
  :global(html.pastilla-lista) .barra-enlace[aria-current='page'] {
    background: transparent;
  }

  /* --------- Con router: barra fija --------- */
  :global(html[data-router]) .barra {
    position: fixed;
    inset: 0 0 auto 0;
    height: var(--spacing-barra);
  }
  :global(html[data-router]) .barra-interior {
    height: 100%;
    flex-wrap: nowrap;
    padding-block: 0;
  }

  @media (min-width: 48rem) {
    .barra-interior {
      padding-inline: 1.5rem;
    }
    .barra-lista {
      flex-wrap: nowrap;
    }
  }

  /* --------- Movil con router: 5 enlaces abajo --------- */
  @media (max-width: 47.999rem) {
    :global(html[data-router]) .barra-nav {
      position: fixed;
      inset: auto 0 0 0;
      z-index: var(--z-barra, 50);
      background: var(--color-crema);
      box-shadow: var(--shadow-barra-inferior);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    :global(html[data-router]) .barra-lista {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0;
      height: var(--spacing-barra-movil);
    }
    :global(html[data-router]) .barra-enlace {
      flex-direction: column;
      justify-content: center;
      gap: 0.125rem;
      width: 100%;
      height: 100%;
      padding: 0.25rem 0.125rem;
      border-radius: 0;
      font-size: 0.8125rem;
      line-height: 1.1;
      white-space: normal;
      text-align: center;
    }
    :global(html[data-router]) .barra-icono {
      display: inline-flex;
      width: 3rem;
      height: 1.875rem;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-chip);
    }
    /* Activa en movil: la pastilla rodea el icono; texto en bosque 800 */
    :global(html[data-router]) .barra-enlace[aria-current='page'] {
      background: transparent;
      color: var(--color-bosque);
    }
    :global(html[data-router]) .barra-enlace[aria-current='page'] .barra-icono {
      background: var(--color-indicador, #1b4d2b);
      color: var(--color-blanco);
    }
    :global(html.pastilla-lista[data-router]) .barra-enlace[aria-current='page'] .barra-icono {
      background: transparent;
    }
    :global(html[data-router]) .barra-enlace:focus-visible {
      outline-offset: -3px;
    }
  }
</style>

<script>
  import '../lib/animacion/vistas';
</script>
