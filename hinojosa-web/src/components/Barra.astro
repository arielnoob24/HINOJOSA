---
// Barra de navegacion entre vistas (unico mecanismo de navegacion global).
// - Anclas reales (<a href="#vista">): funcionan sin JS y con el historial.
// - router.ts pone aria-current="page" en la vista activa; aqui la pastilla
//   de fondo + peso 800 hacen que no dependa solo del color (WCAG 1.4.1).
// - >= 48rem: barra superior. < 48rem (bloque 28a): logo a la izquierda y
//   hamburguesa a la derecha que abre un menu corto con los 4 enlaces (icono
//   + palabra, filas de 44 px o mas). Sin JS, los enlaces a la vista.
// - Etiquetas cortas hasta 64rem (no caben las largas con el logo). Si la
//   larga empieza por la corta ("Por que" / "Por que elegirnos"), el resto
//   va en sr-only: nombre accesible completo sin romper 2.5.3 (G5).
// - < 48rem con router: encabezado de 56 px + safe-area (28b) e isotipo de 32 px.
// Gancho de animacion: [data-barra], a[data-nav-vista], [aria-current].
import { ruta, rutaSrcset } from '../lib/ruta';
import Icono from './Icono.astro';
import { negocio, textos } from '../lib/negocio';

const enlaces = textos.navegacion;
// Etiquetas cortas e iconos (MIGRAR a textos.json > navegacion si se aprueban)
const extra: Record<string, { corto: string; icono: string }> = {
  inicio: { corto: 'Inicio', icono: 'casa' },
  productos: { corto: 'Productos', icono: 'costal' },
  nosotros: { corto: 'Nosotros', icono: 'corazon' },
  visitanos: { corto: 'Visítanos', icono: 'pin' },
};
---
<header class="barra" data-barra>
  <div class="barra-interior">
    <a href="#inicio" class="barra-logo">
      <!-- 36-40 px en pantalla: la variante de 98 px cubre hasta DPR 2,4;
           la de 263 px solo se pide en pantallas de mas densidad (QA M7) -->
      <img
        src={ruta('/img/marca/isotipo-96.webp')}
        srcset={rutaSrcset('/img/marca/isotipo-96.webp 98w, /img/marca/isotipo.webp 263w')}
        sizes="(min-width: 48rem) 2.5rem, 2rem"
        alt=""
        width="98"
        height="96"
        class="barra-isotipo shrink-0"
        decoding="async"
      />
      <span class="font-display leading-none font-extrabold text-bosque">
        <span class="block text-[0.75rem] tracking-[0.16em] text-canela-oscuro">COMERCIAL</span>
        <span class="text-lg">Hinojosa</span><span class="sr-only">, {negocio.nombre}: ir al inicio</span>
      </span>
    </a>

    {/* Bloque 28a (solo < 48rem con JS): hamburguesa que abre el menu de
         vistas (patron disclosure, src/lib/menu-movil.ts). En escritorio y
         sin JS va con display: none y no ocupa sitio en la barra. */}
    <button
      type="button"
      class="barra-menu-boton"
      aria-expanded="false"
      aria-controls="menu-vistas"
      aria-label={textos.comunes.menu}
      data-menu-boton
    >
      <span class="barra-menu-lineas" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <nav aria-label={textos.comunes.etiquetaNavegacion} class="barra-nav" id="menu-vistas" data-menu-vistas>
      <!-- Pastilla de la vista activa que se desliza (src/lib/animacion/vistas.ts).
           Sin JS no se muestra: la pastilla la pinta el propio enlace. -->
      <span class="barra-pastilla" aria-hidden="true" data-pastilla></span>
      <ul class="barra-lista">
        {enlaces.map((e) => {
          const x = extra[e.id] ?? { corto: e.texto, icono: 'hoja' };
          const distinto = x.corto !== e.texto;
          return (
            <li>
              <a href={e.hash} class="barra-enlace" data-nav-vista={e.id}>
                <span class="barra-icono"><Icono nombre={x.icono} class="size-6" /></span>
                {/* B1: cada rotulo reserva el ancho de su version en 800
                     (::after con attr(data-texto)): activar un enlace no
                     desplaza a los vecinos. Corto/largo se alternan con
                     clases propias (no utilidades de display de Tailwind,
                     que chocarian con el inline-flex del rotulo). */}
                {distinto ? (
                  <>
                    {e.texto.startsWith(x.corto) ? (
                      <span class="barra-texto rotulo-corto" data-texto={x.corto}><span class="barra-letras">{x.corto}</span><span class="sr-only">{e.texto.slice(x.corto.length)}</span></span>
                    ) : (
                      <span class="barra-texto rotulo-corto" data-texto={x.corto}><span class="barra-letras">{x.corto}</span></span>
                    )}
                    <span class="barra-texto rotulo-largo" data-texto={e.texto}><span class="barra-letras">{e.texto}</span></span>
                  </>
                ) : (
                  <span class="barra-texto" data-texto={e.texto}><span class="barra-letras">{e.texto}</span></span>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .barra {
    position: relative;
    z-index: var(--z-barra, 50);
    background: var(--color-crema);
    box-shadow: var(--shadow-barra);
  }
  .barra-interior {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    width: 100%;
    max-width: var(--container-contenido);
    margin-inline: auto;
    padding: 0.375rem 1rem;
  }
  .barra-logo {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.625rem;
    border-radius: var(--radius-boton);
    padding-right: 0.5rem;
  }
  .barra-isotipo {
    width: 2.5rem;
    height: 2.5rem;
  }
  .barra-lista {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .barra-enlace {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.375rem;
    border-radius: var(--radius-boton);
    padding: 0.375rem 0.875rem;
    font-size: var(--text-etiqueta);
    font-weight: 400;
    color: var(--color-bosque);
    white-space: nowrap;
  }
  .barra-enlace:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  /* B4 escritorio (bloques 18-19, 2026-10-16): al pasar el raton por un
     rotulo no activo se dibuja debajo el trazo de pincel maiz de los h2
     (sustituye al fondo hoja-claro y al subrayado). Bloque 19: cubre toda
     la palabra. El texto visible va en .barra-letras, un item flex que
     mide exactamente el rotulo en su peso normal y queda centrado en la
     caja que reserva el ancho en 800 (B1, ::after de .barra-texto); el
     trazo es el ::before de .barra-letras en position absolute, de 0 a
     100 %: coincide con la primera y la ultima letra sea cual sea el
     desfase de cada palabra, y no cambia el ancho ni el alto del enlace.
     Decorativo: no necesita 3:1. Nunca en el activo; en tactil y en la
     barra inferior (< 48rem) no aparece. Las transiciones, mas abajo, solo
     sin movimiento reducido y sin la pausa. */
  .barra-letras {
    display: block;
  }
  @media (hover: hover) and (pointer: fine) and (min-width: 48rem) {
    .barra-letras {
      position: relative;
    }
    .barra-letras::before {
      content: '';
      content: '' / '';
      position: absolute;
      left: 0;
      /* Justo bajo la linea base: el borde inferior de la caja de linea
         queda por debajo de los descendentes; se sube 0,15em */
      top: calc(100% - 0.15em);
      width: 100%;
      height: round(clamp(0.375rem, 0.9dvh, 0.5rem), 1px);
      background: var(--color-maiz);
      -webkit-mask: var(--trazo-pincel) no-repeat 0 0 / 100% 100%;
      mask: var(--trazo-pincel) no-repeat 0 0 / 100% 100%;
      transform: rotate(-1deg);
      transform-origin: left center;
      clip-path: inset(0 100% 0 0);
      pointer-events: none;
    }
    .barra-enlace:not([aria-current='page']):hover {
      text-decoration: none;
    }
    .barra-enlace:not([aria-current='page']):hover .barra-letras::before {
      clip-path: inset(0);
    }
  }
  @media (hover: hover) and (pointer: fine) and (min-width: 48rem) and (forced-colors: active) {
    /* Con colores forzados la mascara no se ve: vuelve el subrayado */
    .barra-letras::before {
      display: none;
    }
    .barra-enlace:not([aria-current='page']):hover {
      text-decoration: underline;
    }
  }
  .barra-enlace:active {
    transform: scale(0.96);
  }

  /* B1: ancho reservado en negrita. El ::after, invisible y de alto 0,
     lleva el mismo texto en 800: la caja mide siempre lo que mediria
     activa. Fuera del arbol de accesibilidad (visibility hidden + texto
     alternativo vacio). */
  .barra-texto {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
  }
  .barra-texto::after {
    content: attr(data-texto);
    content: attr(data-texto) / '';
    height: 0;
    overflow: hidden;
    visibility: hidden;
    font-weight: 800;
    pointer-events: none;
    user-select: none;
  }
  .rotulo-largo {
    display: none;
  }
  @media (min-width: 64rem) {
    .rotulo-corto {
      display: none;
    }
    .rotulo-largo {
      display: inline-flex;
    }
  }
  /* Vista activa: pastilla bosque + texto blanco (9.80) + peso 800 */
  .barra-enlace[aria-current='page'] {
    background: var(--color-indicador, #1b4d2b);
    color: var(--color-blanco);
    font-weight: 800;
  }
  .barra-enlace[aria-current='page']:hover {
    text-decoration: none;
  }
  .barra-icono {
    display: none;
  }

  /* --------- Pastilla deslizante (solo con JS) ---------
     La forma rellena + peso 800 siguen siendo la senal no cromatica: la
     pastilla solo sustituye al fondo del enlace activo. */
  .barra-nav {
    position: relative;
  }
  .barra-pastilla {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    width: var(--pastilla-w, 0);
    height: var(--pastilla-h, 0);
    border-radius: var(--radius-chip);
    background: var(--color-indicador);
    opacity: 0;
    pointer-events: none;
    transform: translate3d(var(--pastilla-x, 0), var(--pastilla-y, 0), 0);
  }
  /* Mientras se desliza (vistas.ts, Web Animations: estiramiento
     direccional; .anima no se retira hasta que termina) */
  .barra-pastilla.anima {
    will-change: transform, width;
  }
  .barra-lista {
    position: relative;
    z-index: 1;
  }
  :global(html.pastilla-lista) .barra-pastilla {
    opacity: 1;
  }
  :global(html.pastilla-lista) .barra-enlace[aria-current='page'] {
    background: transparent;
  }

  /* Transiciones de la barra (B3, B4). Solo sin movimiento reducido y sin
     la pausa del sitio (global.css ademas las anula con la pausa).
     - El que se activa pasa a blanco con 80 ms de retraso: cuando la
       pastilla ya esta debajo (B3, version basica).
     - El que deja de estar activo vuelve a bosque en 150 ms mientras la
       pastilla se aparta.
     - Hover 150 ms; pulsacion 90 ms. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-movimiento='pausado'])) .barra-enlace {
      transition:
        background-color var(--duracion-hover-barra) ease,
        color var(--duracion-hover-barra) ease,
        transform var(--duracion-presion) ease-out;
    }
    :global(html.pastilla-lista:not([data-movimiento='pausado'])) .barra-enlace[aria-current='page'] {
      transition:
        background-color var(--duracion-hover-barra) ease,
        color 0s linear var(--retraso-texto-activo),
        transform var(--duracion-presion) ease-out;
    }
  }
  /* Trazo del hover (bloque 19): se dibuja de izquierda a derecha en
     400 ms (--ease-vista) y se recoge en 250 ms (--ease-salida). Sin esta
     regla (reduced motion o pausa) aparece y desaparece sin transicion. */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) and (min-width: 48rem) {
    :global(html:not([data-movimiento='pausado'])) .barra-letras::before {
      transition: clip-path 250ms var(--ease-salida);
    }
    :global(html:not([data-movimiento='pausado'])) .barra-enlace:not([aria-current='page']):hover .barra-letras::before {
      transition: clip-path 400ms var(--ease-vista);
    }
  }

  /* --------- Con router: barra fija --------- */
  :global(html[data-router]) .barra {
    position: fixed;
    inset: 0 0 auto 0;
    height: var(--spacing-barra);
  }
  :global(html[data-router]) .barra-interior {
    height: 100%;
    flex-wrap: nowrap;
    padding-block: 0;
  }

  @media (min-width: 48rem) {
    .barra-interior {
      padding-inline: 1.5rem;
    }
    .barra-lista {
      flex-wrap: nowrap;
    }
  }

  /* --------- Movil --------- */
  @media (max-width: 47.999rem) {
    .barra-isotipo {
      width: 2rem;
      height: 2rem;
    }
    /* G5: barra superior de 44 px: --spacing-barra en tokens.css (movil) */
  }

  /* --------- Movil con router: hamburguesa + menu desplegable (bloque 28a) ---------
     Sin barra inferior. El boton (44x44, tres lineas bosque que pasan a X)
     abre una tarjeta crema bajo el encabezado, alineada a la derecha, con
     los 4 enlaces de siempre (icono + palabra, filas de 44 px o mas).
     Patron disclosure (no modal): src/lib/menu-movil.ts pone
     aria-expanded y [data-abierto] en el nav. Sin JS no hay data-router:
     el boton no se ve y los enlaces quedan a la vista en la cabecera.
     La pastilla deslizante y el pop del icono no existen en movil: la
     vista activa la marca su propia pastilla bosque (texto crema 8.69 +
     peso 800, no solo color). */
  .barra-menu-boton {
    display: none;
  }
  @media (max-width: 47.999rem) {
    :global(html[data-router]) .barra-interior {
      padding-top: env(safe-area-inset-top, 0px);
    }
    /* Centro optico: el bloque del logo baja 2 px (aire sobre "COMERCIAL"
       y mismo centro que la hamburguesa) */
    .barra-logo {
      padding-top: 0.125rem;
    }
    :global(html[data-router]) .barra-menu-boton {
      display: inline-flex;
      flex: 0 0 auto;
      width: 2.75rem;
      height: 2.75rem;
      margin-right: -0.375rem; /* las lineas quedan alineadas con el margen de 1rem */
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-boton);
      color: var(--color-bosque);
    }
    :global(html[data-router]) .barra-menu-boton:active {
      background: var(--color-hoja-claro);
    }
    .barra-menu-lineas {
      position: relative;
      display: block;
      width: 1.375rem;
      height: 1rem;
    }
    .barra-menu-lineas > span {
      position: absolute;
      left: 0;
      width: 100%;
      height: 2.5px;
      border-radius: 2px;
      background: currentColor;
    }
    .barra-menu-lineas > span:nth-child(1) {
      top: 0;
    }
    .barra-menu-lineas > span:nth-child(2) {
      top: calc(50% - 1.25px);
    }
    .barra-menu-lineas > span:nth-child(3) {
      bottom: 0;
    }
    .barra-menu-boton[aria-expanded='true'] .barra-menu-lineas > span:nth-child(1) {
      transform: translateY(calc(0.5rem - 1.25px)) rotate(45deg);
    }
    .barra-menu-boton[aria-expanded='true'] .barra-menu-lineas > span:nth-child(2) {
      opacity: 0;
    }
    .barra-menu-boton[aria-expanded='true'] .barra-menu-lineas > span:nth-child(3) {
      transform: translateY(calc(-0.5rem + 1.25px)) rotate(-45deg);
    }

    /* Tarjeta del menu: cerrada, invisible y fuera del orden de tabulacion
       (visibility hidden); abierta con [data-abierto]. */
    :global(html[data-router]) .barra-nav {
      position: absolute;
      top: calc(100% + 0.375rem);
      right: 1rem;
      min-width: 12.5rem;
      border-radius: var(--radius-tarjeta);
      background: var(--color-crema);
      box-shadow: var(--shadow-elevada);
      padding: 0.375rem;
      /* Despliega desde la hamburguesa: baja 6 px y crece del 96 % desde
         la esquina superior derecha (sin el scale el origen no se notaba) */
      transform-origin: top right;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.375rem) scale(0.96);
    }
    :global(html[data-router]) .barra-nav[data-abierto] {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    :global(html[data-router]) .barra-pastilla {
      display: none;
    }
    :global(html[data-router]) .barra-lista {
      display: flex;
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0.125rem;
    }
    :global(html[data-router]) .barra-enlace {
      display: flex;
      width: 100%;
      min-height: 3rem;
      gap: 0.75rem;
      padding: 0.5rem 1rem 0.5rem 0.875rem;
      border-radius: calc(var(--radius-tarjeta) - 0.375rem);
      font-size: 1rem;
    }
    :global(html[data-router]) .barra-icono {
      display: inline-flex;
      flex: 0 0 auto;
    }
    /* El rotulo va a la izquierda, junto al icono */
    :global(html[data-router]) .barra-texto {
      align-items: flex-start;
    }
    :global(html[data-router]) .barra-nav .barra-enlace[aria-current='page'],
    :global(html.pastilla-lista[data-router]) .barra-nav .barra-enlace[aria-current='page'] {
      background: var(--color-indicador, #1b4d2b);
      color: var(--color-crema);
    }
    :global(html[data-router]) .barra-nav .barra-enlace:not([aria-current='page']):hover {
      text-decoration: none;
    }
    :global(html[data-router]) .barra-nav .barra-enlace:not([aria-current='page']):active {
      background: var(--color-hoja-claro);
    }
    :global(html[data-router]) .barra-enlace:focus-visible {
      outline-offset: -3px;
    }

    /* Movimiento: abre en 200 ms (--ease-vista), cierra en 150 ms. Con
       reduced motion o la pausa del sitio no hay transicion (instantaneo). */
    @media (prefers-reduced-motion: no-preference) {
      :global(html[data-router]:not([data-movimiento='pausado'])) .barra-nav {
        transition:
          opacity 150ms var(--ease-salida, ease-in),
          transform 150ms var(--ease-salida, ease-in),
          visibility 0s linear 150ms;
      }
      :global(html[data-router]:not([data-movimiento='pausado'])) .barra-nav[data-abierto] {
        transition:
          opacity 200ms var(--ease-vista),
          transform 200ms var(--ease-vista),
          visibility 0s linear 0s;
      }
      :global(html[data-router]:not([data-movimiento='pausado'])) .barra-menu-lineas > span {
        transition:
          transform 200ms var(--ease-vista),
          opacity 150ms ease;
      }
    }
  }
</style>

<script>
  import '../lib/animacion/vistas';
  import '../lib/menu-movil';
</script>
