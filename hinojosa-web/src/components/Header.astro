---
import Icono from './Icono.astro';
import { textos } from '../lib/negocio';

const enlaces = textos.navegacion;
---
<header class="top-0 z-40 border-b border-crema-oscuro bg-crema/95 backdrop-blur-sm" data-header>
  <div class="contenedor relative flex flex-wrap items-center justify-between gap-x-4 gap-y-2 py-3 lg:flex-nowrap">
    <a
      href="#inicio"
      class="flex min-h-12 items-center gap-2.5 rounded-boton pr-2"
    >
      <img
        src="/img/marca/isotipo.webp"
        alt=""
        width="263"
        height="257"
        class="size-10 shrink-0"
        decoding="async"
      />
      <!-- Nombre accesible = texto visible ("Comercial Hinojosa") + destino -->
      <span class="font-display text-lg leading-none font-extrabold text-bosque">
        <span class="block text-[0.7rem] tracking-[0.2em] text-canela-oscuro">Comercial</span>{' '}Hinojosa<span class="sr-only">, ir al inicio</span>
      </span>
    </a>

    <nav aria-label="Principal" class="w-full lg:w-auto" data-menu>
      <button
        type="button"
        class="boton-menu boton-terciario boton absolute top-3 right-4 min-h-12 gap-2 px-4 sm:right-6"
        aria-expanded="false"
        aria-controls="menu-principal"
        data-boton-menu
      >
        <Icono nombre="menu" class="size-5" />
        <span>Menú</span>
      </button>
      <ul
        id="menu-principal"
        class="menu-lista flex flex-wrap gap-x-1 gap-y-1 pb-1 lg:flex-nowrap lg:items-center lg:gap-1 lg:pb-0"
      >
        {enlaces.map((e) => (
          <li>
            <a
              href={`#${e.id}`}
              class="flex min-h-11 items-center rounded-boton px-3 font-bold text-bosque decoration-hoja decoration-[3px] underline-offset-[6px] hover:bg-hoja-claro hover:underline"
            >
              {e.texto}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-menu]');
  const boton = nav?.querySelector<HTMLButtonElement>('[data-boton-menu]');
  const lista = nav?.querySelector<HTMLUListElement>('#menu-principal');
  const escritorio = window.matchMedia('(min-width: 64rem)');

  if (nav && boton && lista) {
    const etiqueta = boton.querySelector('span');

    const abrir = () => {
      lista.classList.add('abierta');
      boton.setAttribute('aria-expanded', 'true');
      if (etiqueta) etiqueta.textContent = 'Cerrar';
      lista.querySelector<HTMLAnchorElement>('a')?.focus();
    };

    const cerrar = (devolverFoco = false) => {
      if (boton.getAttribute('aria-expanded') !== 'true') return;
      lista.classList.remove('abierta');
      boton.setAttribute('aria-expanded', 'false');
      if (etiqueta) etiqueta.textContent = 'Menú';
      if (devolverFoco) boton.focus();
    };

    boton.addEventListener('click', () => {
      if (boton.getAttribute('aria-expanded') === 'true') cerrar();
      else abrir();
    });

    // Escape cierra y devuelve el foco al boton
    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && boton.getAttribute('aria-expanded') === 'true') {
        cerrar(true);
      }
    });

    // Elegir un enlace cierra el menu (el ancla mueve el foco a la seccion)
    lista.addEventListener('click', (ev) => {
      if ((ev.target as HTMLElement).closest('a')) cerrar();
    });

    // Clic fuera o foco que sale del menu: cerrar
    document.addEventListener('click', (ev) => {
      if (!nav.contains(ev.target as Node)) cerrar();
    });
    nav.addEventListener('focusout', (ev) => {
      const siguiente = ev.relatedTarget as Node | null;
      if (siguiente && !nav.contains(siguiente)) cerrar();
    });

    escritorio.addEventListener('change', () => cerrar());
  }
</script>
