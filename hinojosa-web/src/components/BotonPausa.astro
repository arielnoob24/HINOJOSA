---
// "Pausar animacion" (WCAG 2.2.2). Boton conmutador: nombre fijo +
// aria-pressed. Pone data-movimiento="pausado" en <html>, lo guarda en
// localStorage (con try/catch) y emite el evento "hinojosa:movimiento"
// (detail.pausado) en window. El bucle del perrito, el paralaje y
// cualquier video decorativo DEBEN escucharlo y detenerse de verdad.
// Sin JS no tendria efecto, por eso empieza oculto.
import Icono from './Icono.astro';
import { textos } from '../lib/negocio';

interface Props {
  class?: string;
  tema?: 'claro' | 'oscuro';
}
const { class: clase = '', tema = 'oscuro' } = Astro.props;
const t = textos.inicio;
---
<button
  type="button"
  class:list={['boton-pausa', `boton-pausa-${tema}`, clase]}
  aria-pressed="false"
  title={t.pausarAnimacion}
  data-boton-pausa
  data-texto-pausar={t.pausarAnimacion}
  data-texto-reanudar={t.reanudarAnimacion}
  hidden
>
  <span class="sr-only">{t.pausarAnimacion}</span>
  <span data-icono-pausa><Icono nombre="pausa" class="size-5" /></span>
  <span data-icono-play hidden><Icono nombre="play" class="size-5" /></span>
</button>

<style>
  .boton-pausa {
    display: inline-flex;
    width: var(--spacing-objetivo, 2.75rem);
    height: var(--spacing-objetivo, 2.75rem);
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 2px solid currentColor;
    transition: background-color var(--duracion-hover, 200ms) ease;
  }
  .boton-pausa[hidden] {
    display: none;
  }
  /* Sobre bosque: crema (8.69) y foco oro (5.44) */
  .boton-pausa-oscuro {
    --color-foco: var(--color-foco-oscuro);
    color: var(--color-crema);
    background: var(--color-pausa-oscuro);
  }
  .boton-pausa-oscuro:hover {
    background: var(--color-bosque-noche);
  }
  .boton-pausa-claro {
    color: var(--color-bosque);
    background: var(--color-blanco);
  }
  .boton-pausa-claro:hover {
    background: var(--color-hoja-claro);
  }
</style>

<script>
  const CLAVE = 'hinojosa-movimiento';
  const html = document.documentElement;

  const leer = () => html.getAttribute('data-movimiento') === 'pausado';

  const pintar = (pausado: boolean) => {
    document.querySelectorAll<HTMLButtonElement>('[data-boton-pausa]').forEach((b) => {
      b.setAttribute('aria-pressed', String(pausado));
      b.title = (pausado ? b.dataset.textoReanudar : b.dataset.textoPausar) ?? '';
      b.querySelector<HTMLElement>('[data-icono-pausa]')!.hidden = pausado;
      b.querySelector<HTMLElement>('[data-icono-play]')!.hidden = !pausado;
    });
  };

  const aplicar = (pausado: boolean) => {
    if (pausado) html.setAttribute('data-movimiento', 'pausado');
    else html.removeAttribute('data-movimiento');
    try {
      if (pausado) localStorage.setItem(CLAVE, 'pausado');
      else localStorage.removeItem(CLAVE);
    } catch {
      /* almacenamiento no disponible: el estado vale solo para esta visita */
    }
    pintar(pausado);
    window.dispatchEvent(new CustomEvent('hinojosa:movimiento', { detail: { pausado } }));
  };

  document.querySelectorAll<HTMLButtonElement>('[data-boton-pausa]').forEach((b) => {
    b.hidden = false;
    b.addEventListener('click', () => aplicar(!leer()));
  });
  pintar(leer());
</script>
