---
// Boton flotante de WhatsApp.
// - Numero confirmado: enlace wa.me con 3 pulsos a los 4 s (data-pulso).
// - Sin confirmar: NO enlaza a WhatsApp. Lleva a la seccion Contacto y lo
//   dice tanto en el texto visible ("Por confirmar") como en el nombre
//   accesible, sin pulso para no llamar la atencion sobre un canal inexistente.
//   En movil se reduce a un circulo de 48 px con solo el icono.
import Icono from './Icono.astro';
import { enlaceWhatsapp, textos, PENDIENTE } from '../lib/negocio';

const href = enlaceWhatsapp();
---
{href ? (
  <a
    href={href}
    class="pulso fixed right-4 bottom-4 z-30 inline-flex size-14 items-center justify-center rounded-full bg-marca-fuerte text-blanco shadow-elevada hover:bg-bosque sm:right-6 sm:bottom-6"
    aria-label={`${textos.comunes.etiquetaFlotanteWhatsapp} (se abre en una pestaña nueva)`}
    title={textos.comunes.botonFlotanteWhatsapp}
    target="_blank"
    rel="noopener"
    data-whatsapp-flotante
    data-pulso
  >
    <Icono nombre="whatsapp" class="size-7" />
  </a>
) : (
  <a
    href="#contacto"
    class="fixed right-3 bottom-3 z-30 inline-flex size-12 items-center justify-center gap-2 rounded-full border-2 border-dashed border-bosque bg-blanco text-bosque shadow-elevada hover:bg-hoja-claro sm:right-6 sm:bottom-6 sm:size-auto sm:min-h-14 sm:justify-start sm:py-2 sm:pr-4 sm:pl-3"
    data-whatsapp-flotante="pendiente"
  >
    <Icono nombre="whatsapp" class="size-6 shrink-0" />
    <!-- Movil (< 640 px): solo el icono, para no tapar contenido; el texto
         sigue en el nombre accesible -->
    <span class="sr-only flex-col text-left leading-tight sm:not-sr-only sm:flex">
      <span class="text-chico font-bold">WhatsApp</span>
      <span class="text-xs font-semibold text-tinta-suave"> {PENDIENTE}</span>
    </span>
    <span class="sr-only">: ir a Contacto</span>
  </a>
)}
