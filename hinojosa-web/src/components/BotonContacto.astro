---
// Boton de contacto que respeta la regla de datos sin confirmar:
// - con enlace: <a> con nombre accesible explicito (y aviso de pestana
//   nueva si corresponde);
// - sin enlace: texto NO interactivo y sin forma de boton (icono en gris +
//   "<canal>: Muy pronto publicaremos este dato."), para no publicar un
//   enlace roto ni un dato inventado. El marcador PENDIENTE_CONFIRMAR vive
//   solo en negocio.json: nunca llega a la pantalla (auditoria V1).
// Visitanos no usa esta rama: agrupa los canales pendientes en una sola
// linea (ver VistaVisitanos.astro). Queda como respaldo para otros usos.
// Sustituye a BotonWhatsapp.astro (se generalizo a Maps/WhatsApp/Llamar/Facebook).
// Variantes (guia 3.4): cta (oro; con borde bosque sobre claro, sin borde
// dentro de .tema-oscuro), primario (bosque + blanco, sobre claro),
// invertido (secundario invertido: borde y texto crema, para bloques
// bosque), enlace (marca-fuerte sobre claro; crema dentro de .tema-oscuro).
import Icono from './Icono.astro';
import { textos } from '../lib/negocio';

interface Props {
  href: string | null;
  texto: string;
  nombreAccesible: string;
  icono: string;
  variante?: 'cta' | 'primario' | 'invertido' | 'enlace';
  pestanaNueva?: boolean;
  class?: string;
}
const { href, texto, nombreAccesible, icono, variante = 'primario', pestanaNueva = true, class: clase = '' } = Astro.props;
const aviso = textos.comunes.abreEnPestanaNueva;
---
{href ? (
  <a
    href={href}
    class:list={['contacto', `contacto-${variante}`, clase]}
    aria-label={pestanaNueva ? `${nombreAccesible} ${aviso}` : nombreAccesible}
    target={pestanaNueva ? '_blank' : undefined}
    rel={pestanaNueva ? 'noopener' : undefined}
    data-contacto={icono}
  >
    <Icono nombre={icono} class="size-5 shrink-0" />
    <span>{texto}</span>
    {pestanaNueva && <span aria-hidden="true">↗</span>}
  </a>
) : (
  <span class:list={['contacto-pendiente', clase]} data-contacto={icono} data-pendiente>
    <Icono nombre={icono} class="contacto-pendiente-icono size-5 shrink-0" />
    <span>{texto}: {textos.comunes.datoPendiente}</span>
  </span>
)}

<style>
  .contacto {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: var(--radius-boton);
    padding: 0.5rem 1.25rem;
    font-weight: 800;
    line-height: 1.15;
    text-align: center;
    transition: background-color var(--duracion-hover) ease, transform var(--duracion-presion) ease-out;
  }
  a.contacto:active {
    transform: scale(0.96);
  }
  .contacto-cta {
    border: 2px solid var(--color-cta-borde);
    background: var(--color-cta-fondo);
    color: var(--color-cta-texto);
  }
  .contacto-cta:hover {
    background: var(--color-cta-hover);
  }
  /* Sobre bosque el oro ya contrasta (5.44): sin borde */
  :global(.tema-oscuro) .contacto-cta {
    border-color: transparent;
  }
  /* Secundario invertido: borde 2 px y texto crema (8.69 sobre bosque);
     hover crema al 12 % */
  .contacto-invertido {
    border: 2px solid var(--color-crema);
    background: transparent;
    color: var(--color-crema);
  }
  .contacto-invertido:hover {
    background: rgb(246 241 228 / 0.12);
  }
  .contacto-primario {
    background: var(--color-boton-fondo);
    color: var(--color-boton-texto);
  }
  .contacto-primario:hover {
    background: var(--color-boton-hover);
  }
  .contacto-enlace {
    min-height: 2.75rem;
    padding-inline: 0.25rem;
    color: var(--color-marca-fuerte);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* marca-fuerte no sirve sobre bosque: crema (8.69) */
  :global(.tema-oscuro) .contacto-enlace {
    color: var(--color-crema);
  }
  /* Aviso de dato pendiente: texto corrido, sin borde, fondo ni alto de
     boton (un "boton" que no hace nada parece un sitio roto). */
  .contacto-pendiente {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-chico);
    line-height: var(--text-chico--line-height);
    color: var(--color-tinta-suave);
  }
  .contacto-pendiente :global(.contacto-pendiente-icono) {
    opacity: 0.7;
  }
  /* Sobre bosque: texto crema (8.69), icono pendiente-oscuro (5.17) */
  :global(.tema-oscuro) .contacto-pendiente {
    color: var(--color-crema);
  }
  :global(.tema-oscuro) .contacto-pendiente :global(.contacto-pendiente-icono) {
    opacity: 1;
    color: var(--color-pendiente-oscuro);
  }
</style>
