---
// Separador ondulado (como la franja inferior de los afiches). Decorativo.
interface Props {
  color?: string; // clase de texto Tailwind: el SVG usa currentColor
  invertida?: boolean;
  class?: string;
}
const { color = 'text-bosque', invertida = false, class: clase = '' } = Astro.props;
---
<svg
  class:list={['block h-8 w-full sm:h-12 lg:h-16', color, invertida && 'rotate-180', clase]}
  viewBox="0 0 1440 80"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    fill="currentColor"
    d="M0 48c160-30 330-40 520-18s380 44 560 22 260-40 360-32V80H0z"
  />
</svg>
