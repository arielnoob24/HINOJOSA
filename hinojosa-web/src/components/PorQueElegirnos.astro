---
// Por que elegirnos: 4 razones + contadores calculados desde los JSON
// (no a mano). Gancho fase 4: data-contador + data-valor (animar de 0 al
// valor). Sin JS ya se muestra el numero final.
import Icono from './Icono.astro';
import { textos, contadores, altDe } from '../lib/negocio';

const t = textos['por-que-elegirnos'];
const iconos = ['medalla', 'costal', 'conversacion', 'pin'];
const cifras = contadores();
---
<section id={t.id} class="bg-crema py-seccion" aria-labelledby="titulo-elegirnos" data-escena="por-que-elegirnos">
  <div class="contenedor">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center" data-revelar>
      <img
        src="/img/canela/canela-pulgar.webp"
        width="332"
        height="332"
        alt={altDe('/img/canela/canela-pulgar.webp')}
        loading="lazy"
        decoding="async"
        class="size-24 shrink-0 sm:size-28"
      />
      <div>
        <h2 id="titulo-elegirnos" class="text-h2">{t.titulo}</h2>
        <p class="mt-2 font-script text-acento text-marca-fuerte">{t.intro}</p>
      </div>
    </div>

    <ul class="mt-bloque grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {t.razones.map((r, i) => (
        <li class="tarjeta p-6" data-tilt data-revelar>
          <span class="inline-flex size-12 items-center justify-center rounded-full bg-hoja-claro text-marca-fuerte">
            <Icono nombre={iconos[i] ?? 'estrella'} class="size-6" />
          </span>
          <h3 class="mt-4 text-h3">{r.titulo}</h3>
          <p class="mt-2 text-tinta">{r.texto}</p>
        </li>
      ))}
    </ul>

    <ul data-revelar class="mt-bloque grid grid-cols-2 gap-4 rounded-panel bg-blanco p-6 shadow-suave sm:p-8 lg:grid-cols-4">
      {cifras.map((c) => (
        <li class="flex flex-col">
          <span class="cifra font-display text-display font-extrabold text-marca-fuerte" data-contador data-valor={c.valor}>
            {c.valor}{c.sufijo}
          </span>
          <span class="mt-1 text-chico font-semibold text-tinta">{c.etiqueta}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
