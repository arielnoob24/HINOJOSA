---
// Que vendemos: una tarjeta por categoria de productos.json.
// Movil: fila horizontal con scroll-snap (dentro de su propio contenedor, sin
// desbordar la pagina). Escritorio: rejilla con giro tipo costal ligado al
// scroll (CSS, mejora progresiva). Gancho fase 4: data-escena="categorias"
// y data-categoria en cada tarjeta (carrusel 3D de costales).
// `sizes` refleja el ancho real de la tarjeta (64 % del contenedor en movil):
// a 375 px con densidad 2 se elige la variante de 480 px, no la nativa.
import BotonWhatsapp from './BotonWhatsapp.astro';
import { catalogo, textos, altDe } from '../lib/negocio';
import { imagenResponsiva } from '../lib/imagenes';

const t = textos.categorias;
const conteo = (id: string) => catalogo.productos.filter((p) => p.categoria === id).length;
const categorias = catalogo.categorias.map((c) => ({
  ...c,
  img: imagenResponsiva(c.imagen),
  alt: altDe(c.imagen),
  total: conteo(c.id),
}));
---
<section id={t.id} class="bg-crema py-seccion" aria-labelledby="titulo-categorias" data-escena="categorias">
  <div class="contenedor" data-revelar-hijos>
    <h2 id="titulo-categorias" class="text-h2">{t.titulo}</h2>
    <p class="mt-4 max-w-texto text-lead">{t.intro}</p>
  </div>

  <div class="contenedor mt-bloque">
    <ul
      class="relative -mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-4 sm:-mx-6 sm:px-6 lg:mx-0 lg:grid lg:grid-cols-5 lg:gap-5 lg:overflow-visible lg:px-0 lg:pb-0"
      aria-label="Categorías de productos"
    >
      {categorias.map((c) => (
        <li class="tarjeta-categoria relative w-[64%] shrink-0 snap-start sm:w-[42%] md:w-[30%] lg:w-auto" data-categoria={c.id}>
          <article class="tarjeta flex h-full flex-col overflow-hidden" aria-labelledby={`cat-${c.id}`}>
            <img
              src={c.img.src}
              srcset={c.img.srcset}
              sizes="(min-width: 1152px) 202px, (min-width: 1024px) calc(20vw - 29px), (min-width: 768px) calc(30vw - 15px), (min-width: 640px) calc(42vw - 20px), calc(64vw - 21px)"
              width={c.img.width}
              height={c.img.height}
              alt={c.alt}
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              class="aspect-[4/5] w-full bg-crema-oscuro object-cover object-top"
            />
            <div class="flex flex-1 flex-col p-4">
              <h3 id={`cat-${c.id}`} class="text-xl leading-tight">{c.nombre}</h3>
              <p class="mt-2 flex-1 text-chico text-tinta-suave">{c.descripcion}</p>
              <a
                href={`#grupo-${c.id}`}
                class="mt-3 inline-flex min-h-11 items-center font-bold text-marca-fuerte underline decoration-2 underline-offset-4 hover:text-bosque"
                data-ver-categoria={c.id}
              >
                {t.ctaTarjeta}<span class="sr-only">: {c.nombre}</span>
                <span class="ml-1 text-chico font-semibold text-tinta-suave no-underline">({c.total})</span>
              </a>
            </div>
          </article>
        </li>
      ))}
    </ul>

    <div data-revelar class="mt-bloque flex flex-col items-start gap-4 rounded-tarjeta bg-hoja-claro p-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-display text-h3 font-bold text-bosque">{t.ctaFinal}</p>
      <BotonWhatsapp />
    </div>
  </div>
</section>
