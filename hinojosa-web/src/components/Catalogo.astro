---
// Catalogo desde productos.json, agrupado por categoria.
// Sin JS: se ven todas las categorias (los filtros ni se muestran).
// Con JS: botones de filtro con aria-pressed y conteo anunciado con aria-live.
// Gancho fase 4: data-escena="catalogo", data-producto (tarjeta) y
// data-visual-producto (hueco para <model-viewer> cuando existan los .glb).
import BotonWhatsapp from './BotonWhatsapp.astro';
import { catalogo, textos, formatoPrecio, enlaceWhatsapp } from '../lib/negocio';

const t = textos.catalogo;
const tabla = catalogo.tablaProteinaTilapia;

const grupos = catalogo.categorias
  .map((c) => ({ ...c, productos: catalogo.productos.filter((p) => p.categoria === c.id) }))
  .filter((g) => g.productos.length > 0);

const total = catalogo.productos.length;

// Alto estimado de cada grupo para content-visibility (filas por columnas de
// la rejilla 1/2/3/4 + cabecera; la tabla de la tilapia suma lo suyo). Solo
// sirve hasta que el grupo se pinta: luego el navegador recuerda el real.
const filasGrupo = (n: number, tabla: boolean) =>
  [1, 2, 3, 4].map((c) => `--filas-${c}:${Math.ceil(n / c)}`).join(';') + `;--extra:${tabla ? 420 : 0}px`;
const textoTotal = `Mostrando los ${total} productos de ${grupos.length} categorías.`;
---
<section id={t.id} class="bg-blanco py-seccion" aria-labelledby="titulo-catalogo" data-escena="catalogo">
  <div class="contenedor">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-revelar-hijos>
      <div class="lg:col-span-7">
        <h2 id="titulo-catalogo" class="text-h2">{t.titulo}</h2>
        <p class="mt-4 max-w-texto text-lead">{t.intro}</p>
      </div>
      <p class="flex items-start gap-3 rounded-tarjeta border-l-4 border-maiz bg-crema px-4 py-3 font-semibold text-tinta lg:col-span-5">
        {t.avisoPrecios}
      </p>
    </div>

    <!-- Filtros (se muestran solo con JS) -->
    <div class="mt-bloque" data-filtros hidden>
      <p id="etiqueta-filtro" class="font-bold text-bosque">{t.etiquetaFiltro}</p>
      <div class="mt-3 flex flex-wrap gap-2" role="group" aria-labelledby="etiqueta-filtro">
        <button type="button" class="chip-filtro" aria-pressed="true" data-filtro="todos">{t.filtroTodos}</button>
        {grupos.map((g) => (
          <button type="button" class="chip-filtro" aria-pressed="false" data-filtro={g.id}>{g.nombre}</button>
        ))}
      </div>
    </div>
    <p class="mt-4 text-chico font-semibold text-tinta-suave" aria-live="polite" data-resultados data-total={total}>
      {textoTotal}
    </p>

    <div class="mt-6 space-y-bloque">
      {grupos.map((g) => (
        <section
          id={`grupo-${g.id}`}
          aria-labelledby={`titulo-grupo-${g.id}`}
          data-grupo={g.id}
          data-nombre={g.nombre}
          style={filasGrupo(g.productos.length, g.id === 'tilapia')}
        >
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-b-2 border-crema-oscuro pb-3">
            <h3 id={`titulo-grupo-${g.id}`} class="text-h3">{g.nombre}</h3>
            <p class="text-chico font-semibold text-tinta-suave">
              {g.productos.length} {g.productos.length === 1 ? 'producto' : 'productos'}
            </p>
          </div>

          <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {g.productos.map((p) => {
              const wa = enlaceWhatsapp(`${textos.comunes.mensajeWhatsapp}${p.nombre}.`);
              return (
                <li class="tarjeta tarjeta-producto flex flex-col overflow-hidden" data-producto={p.id}>
                  <div class="bg-bosque px-4 py-3" data-visual-producto>
                    <h4 class="font-serif text-producto font-bold text-crema">{p.nombre}</h4>
                  </div>
                  <div class="flex flex-1 flex-col gap-3 p-4">
                    <p class="text-chico text-tinta-suave">{p.descripcion}</p>
                    {(p.marca || p.presentacion) && (
                      <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-chico">
                        {p.marca && (
                          <>
                            <dt class="font-semibold text-tinta-suave">{t.etiquetaMarca}</dt>
                            <dd class="font-bold text-tinta">{p.marca}</dd>
                          </>
                        )}
                        {p.presentacion && (
                          <>
                            <dt class="font-semibold text-tinta-suave">{t.etiquetaPresentacion}</dt>
                            <dd class="font-bold text-tinta">{p.presentacion}</dd>
                          </>
                        )}
                      </dl>
                    )}
                    <div class="mt-auto flex flex-wrap items-center justify-between gap-2 pt-1">
                      {p.precio !== null ? (
                        <p class="cifra rounded-chip bg-maiz px-3 py-1 font-bold text-tinta">
                          {formatoPrecio(p.precio, p.precioDesde)}
                          <span class="sr-only"> (precio referencial)</span>
                        </p>
                      ) : (
                        <p class="rounded-chip bg-crema-oscuro px-3 py-1 text-chico font-bold text-tinta">{t.sinPrecio}</p>
                      )}
                      {wa && (
                        <a href={wa} class="text-chico font-bold text-marca-fuerte underline underline-offset-4" target="_blank" rel="noopener">
                          {t.ctaProducto}<span class="sr-only">: {p.nombre} (se abre en una pestaña nueva)</span>
                        </a>
                      )}
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>

          {g.id === 'tilapia' && (
            <div class="mt-6 max-w-xl">
              <p class="text-tinta-suave">{t.tablaTilapia.intro}</p>
              <div class="mt-3 overflow-x-auto rounded-tarjeta border border-crema-oscuro">
                <table class="w-full text-left">
                  <caption class="bg-hoja-claro px-4 py-3 text-left font-display text-lg font-bold text-bosque">
                    {t.tablaTilapia.titulo}
                  </caption>
                  <thead class="bg-bosque text-crema">
                    <tr>
                      <th scope="col" class="px-4 py-2 font-bold">{t.tablaTilapia.columnaEtapa}</th>
                      <th scope="col" class="px-4 py-2 text-right font-bold">{t.tablaTilapia.columnaProteina}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {tabla.etapas.map((e, i) => (
                      <tr class:list={[i % 2 === 1 && 'bg-crema']}>
                        <th scope="row" class="px-4 py-2 font-semibold">{e.etapa}</th>
                        <td class="cifra px-4 py-2 text-right font-bold">{e.proteina}{tabla.unidad}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </section>
      ))}
    </div>

    <div class="mt-bloque flex flex-col gap-4 border-t-2 border-crema-oscuro pt-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="text-chico text-tinta-suave">
        <p>{catalogo.avisoPrecios}</p>
        <p class="mt-1">{catalogo.avisoMarcas}</p>
      </div>
      <BotonWhatsapp />
    </div>
  </div>
</section>

<style>
  /* A2 (informe de QA): los grupos fuera de pantalla no se maquetan ni se
     pintan hasta acercarse; asi "Todos" no relayoutea los 48 productos. */
  [data-grupo] {
    content-visibility: auto;
    contain-intrinsic-size: auto calc(var(--filas-1) * 15rem + 5rem + var(--extra, 0px));
  }
  @media (min-width: 40rem) {
    [data-grupo] {
      contain-intrinsic-size: auto calc(var(--filas-2) * 15rem + 5rem + var(--extra, 0px));
    }
  }
  @media (min-width: 64rem) {
    [data-grupo] {
      contain-intrinsic-size: auto calc(var(--filas-3) * 15rem + 5rem + var(--extra, 0px));
    }
  }
  @media (min-width: 80rem) {
    [data-grupo] {
      contain-intrinsic-size: auto calc(var(--filas-4) * 15rem + 5rem + var(--extra, 0px));
    }
  }
  /* Que el header fijo no tape los chips al desplazarse hasta ellos (B6) */
  [data-filtros] {
    scroll-margin-top: 5.5rem;
  }

  .chip-filtro {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border-radius: var(--radius-chip);
    border: 2px solid var(--color-bosque);
    background: var(--color-blanco);
    padding: 0.375rem 1rem;
    font-weight: 700;
    color: var(--color-bosque);
    cursor: pointer;
    transition: background-color var(--duracion-rapida) ease, color var(--duracion-rapida) ease;
  }
  .chip-filtro:hover {
    background: var(--color-hoja-claro);
  }
  .chip-filtro[aria-pressed='true'] {
    background: var(--color-bosque);
    color: var(--color-blanco);
  }
</style>

<script>
  const filtros = document.querySelector<HTMLElement>('[data-filtros]');
  const resultados = document.querySelector<HTMLElement>('[data-resultados]');
  const grupos = Array.from(document.querySelectorAll<HTMLElement>('[data-grupo]'));
  const botones = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filtro]'));

  const contar = (g: HTMLElement) => g.querySelectorAll('[data-producto]').length;

  function filtrar(id: string) {
    let visibles = 0;
    grupos.forEach((g) => {
      const mostrar = id === 'todos' || g.dataset.grupo === id;
      g.hidden = !mostrar;
      if (mostrar) visibles += contar(g);
    });
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === id)));
    if (resultados) {
      if (id === 'todos') {
        resultados.textContent = `Mostrando los ${visibles} productos de ${grupos.length} categorías.`;
      } else {
        const nombre = grupos.find((g) => g.dataset.grupo === id)?.dataset.nombre ?? '';
        resultados.textContent = `Mostrando ${visibles} ${visibles === 1 ? 'producto' : 'productos'} de ${nombre}.`;
      }
    }
  }

  if (filtros && grupos.length) {
    filtros.hidden = false;
    botones.forEach((b) => b.addEventListener('click', () => filtrar(b.dataset.filtro ?? 'todos')));

    // "Ver productos" en las tarjetas de categoria: filtra y deja que el
    // ancla (#grupo-id) haga el desplazamiento.
    document.querySelectorAll<HTMLAnchorElement>('[data-ver-categoria]').forEach((a) => {
      a.addEventListener('click', () => filtrar(a.dataset.verCategoria ?? 'todos'));
    });
  }
</script>
