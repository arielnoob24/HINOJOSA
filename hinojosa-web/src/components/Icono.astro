    '<path d="M8 4.5h8l-1 2.5c2.7 1.6 4 4.8 4 8.3 0 3-2 4.7-7 4.7s-7-1.7-7-4.7C5 11.8 6.3 8.6 9 7z"/><path d="M9 7h6M9.5 14h5"/>',
