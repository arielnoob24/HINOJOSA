const trazo = trazos[nombre];
if (!trazo) throw new Error(`Icono desconocido: ${nombre}`);
---
<svg
  class={clase}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={trazo}
/>
