    '<path d="M4.5 18.5V7a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2H8.5z"/><path d="M9 10.5h.01M12 10.5h.01M15 10.5h.01"/>',
  escudo: '<path d="M12 3.5l7 2.5v5.5c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6z"/><path d="M9 12l2.2 2.2L15.5 10"/>',
  verificado: '<circle cx="12" cy="12" r="8.5"/><path d="M8.5 12.2l2.4 2.4 4.6-4.8"/>',
  manos:
    '<path d="M3 11l4-4 3 1.5 2-1.5 2 1.5 3-1.5 4 4"/><path d="M7 11l4.5 4.5a1.4 1.4 0 0 0 2-2L10 10M13.5 13.5l1.5 1.5a1.4 1.4 0 0 0 2-2l-2.5-2.5M5 13l3.5 3.5a1.4 1.4 0 0 0 2-2"/>',
  hoja: '<path d="M5 19c0-8 5-13.5 14-14-0.5 9-6 14-14 14z"/><path d="M5 19c3-4 6-7 10-9.5"/>',
