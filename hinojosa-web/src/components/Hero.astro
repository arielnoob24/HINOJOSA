---
// Hero v1 sin 3D (storyboard-hero.md): logo como h1; la insignia de Canela
// es la imagen LCP medida (fetchpriority="high"; el logo queda en auto);
// granos y hojas en SVG inline animados con CSS, franja verde con los
// diferenciales y boton "Pausar animaciones".
// Ganchos para la fase 4: data-escena="hero", data-capa y data-profundidad
// (paralaje), y data-canela-hero (hueco donde ira el <canvas> de Three.js).
import BotonWhatsapp from './BotonWhatsapp.astro';
import BotonPausa from './BotonPausa.astro';
import Icono from './Icono.astro';
import Onda from './Onda.astro';
import { negocio, textos, altDe } from '../lib/negocio';

const t = textos.hero;
const tc = textos.canela; // frase y pista de la Canela interactiva
const frase = negocio.esloganesSecundarios[0]; // "Calidad que alimenta, amor que se siente"
const iconosDiferenciales = ['pin', 'costal', 'conversacion', 'medalla'];

// Granos: posicion (% del contenedor de la escena), tamano, retraso de caida y
// desfase del bucle. Los 4 primeros se ven en movil.
const granos = [
  { x: 8, y: 14, s: 22, r: 600, d: -0.5, g: 30 },
  { x: 86, y: 10, s: 18, r: 670, d: -2.4, g: -25 },
  { x: 90, y: 62, s: 26, r: 740, d: -4.1, g: 40 },
  { x: 4, y: 70, s: 16, r: 810, d: -5.6, g: -35 },
  { x: 24, y: 4, s: 14, r: 880, d: -1.3, g: 20, escritorio: true },
  { x: 70, y: 2, s: 20, r: 950, d: -3.2, g: -40, escritorio: true },
  { x: 96, y: 36, s: 12, r: 1020, d: -6, g: 25, escritorio: true },
];
const pellets = [
  { x: 14, y: 88, s: 12, r: 1090, d: -2, escritorio: true },
  { x: 78, y: 84, s: 10, r: 1160, d: -4.6, escritorio: true },
];
---
<section
  id={t.id}
  class="relative overflow-hidden bg-linear-to-b from-blanco to-crema"
  aria-labelledby="titulo-hero"
  data-escena="hero"
>
  <!-- Capa 1: hojas grandes desenfocadas en las esquinas -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true" data-capa="hojas-fondo" data-profundidad="0.1">
    <svg class="deriva absolute -top-10 -left-12 w-48 text-hoja opacity-30 blur-[3px] sm:w-64" viewBox="0 0 100 100">
      <path fill="currentColor" d="M10 90C10 45 40 12 92 8c-3 50-34 80-82 82z" />
    </svg>
    <svg class="deriva absolute -right-14 bottom-24 w-56 rotate-180 text-hoja opacity-30 blur-[3px] sm:w-72" style="--desfase:-6s" viewBox="0 0 100 100">
      <path fill="currentColor" d="M10 90C10 45 40 12 92 8c-3 50-34 80-82 82z" />
    </svg>
  </div>

  <div class="contenedor relative grid items-center gap-y-8 pt-8 pb-10 md:grid-cols-12 md:gap-x-8 md:pt-12 lg:pt-16 lg:pb-14">
    <!-- Capa 5: texto, logo y CTA (nunca se mueven con el paralaje) -->
    <div class="text-center md:col-span-7 md:text-left lg:col-span-6">
      <h1 id="titulo-hero" class="mx-auto w-[min(80vw,300px)] md:mx-0 md:w-[min(100%,420px)] lg:w-[460px]">
        <img
          src="/img/marca/logo.webp"
          srcset="/img/marca/logo-480.webp 480w, /img/marca/logo.webp 929w"
          sizes="(min-width: 1024px) 460px, (min-width: 768px) 420px, min(80vw, 300px)"
          width="929"
          height="489"
          alt={altDe('/img/marca/logo.webp')}
          loading="eager"
          class="h-auto w-full"
        />
      </h1>

      <p class="entrada mx-auto mt-5 max-w-texto text-lead font-semibold text-tinta-suave md:mx-0" style="--retraso:300ms">
        {t.subtitulo}
      </p>

      <p class="entrada mt-4 hidden font-script text-acento text-marca-fuerte min-[400px]:block" style="--retraso:400ms">
        <span class="subrayado">{frase}</span>
      </p>

      <div class="mt-7 flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center md:justify-start">
        <div class="entrada flex" style="--retraso:450ms">
          <BotonWhatsapp texto={t.ctaPrimario} ancho="completo" class="min-h-[52px] w-full" />
        </div>
        <a href={t.ctaSecundarioAncla} class="entrada boton boton-oro min-h-[52px]" style="--retraso:530ms">
          {t.ctaSecundario}
        </a>
      </div>
    </div>

    <!-- Capa 2: insignia de Canela + halo; capas 3 y 4: granos y hojas -->
    <div class="relative mx-auto w-60 md:col-span-5 md:w-full md:max-w-[380px] lg:col-span-6 lg:max-w-[400px]" data-canela-hero>
      <div class="absolute inset-[-12%] rounded-full bg-hoja-claro/60 blur-2xl" aria-hidden="true"></div>

      <div class="entrada-insignia relative" data-capa="insignia" data-profundidad="0.15">
        <!-- Canela interactiva (fase 4): al pulsar salta y saluda. El nombre
             accesible incluye la pista visible y el alt de la imagen. -->
        <button
          type="button"
          class="canela-boton"
          data-canela-boton
          data-titulo={tc.titulo}
          data-frase={`${tc.frase}.`}
          aria-controls="globo-canela"
        >
          <img
            src="/img/canela/canela-insignia.webp"
            srcset="/img/canela/canela-insignia-480.webp 480w, /img/canela/canela-insignia.webp 792w"
            sizes="(min-width: 1024px) 400px, (min-width: 768px) 38vw, 240px"
            width="792"
            height="871"
            alt={altDe('/img/canela/canela-insignia.webp')}
            fetchpriority="high"
            loading="eager"
            class="balanceo h-auto w-full drop-shadow-[0_18px_24px_rgb(20_48_29/0.22)]"
          />
          <span class="canela-pista absolute -bottom-9 left-1/2 -translate-x-1/2 -rotate-2 rounded-chip bg-maiz px-3 py-1 text-chico font-bold whitespace-nowrap text-tinta shadow-suave">
            {tc.interaccion}
          </span>
        </button>
        <!-- Globo: region viva siempre presente; vacia hasta que Canela saluda -->
        <p
          id="globo-canela"
          class="globo-canela rounded-tarjeta border-2 border-maiz bg-blanco px-4 py-3 text-left shadow-elevada"
          role="status"
          data-globo-canela
        ></p>
      </div>

      <div class="pointer-events-none absolute inset-[-8%]" aria-hidden="true" data-capa="granos" data-profundidad="0.3">
        {granos.map((g) => (
          <span
            class:list={['grano-caida absolute', g.escritorio && 'hidden md:block']}
            style={`left:${g.x}%;top:${g.y}%;--retraso:${g.r}ms;--giro:${g.g}deg`}
          >
            <svg class="grano-flota block" style={`width:${g.s}px;--desfase:${g.d}s`} viewBox="0 0 20 26">
              <ellipse cx="10" cy="13" rx="8.5" ry="11.5" fill="#f2b823" />
              <ellipse cx="7" cy="9" rx="3" ry="5" fill="#fff" opacity=".35" />
              <path d="M4 20c3 4 9 4 12 0" fill="none" stroke="#c98a3a" stroke-width="2" stroke-linecap="round" />
            </svg>
          </span>
        ))}
        {pellets.map((p) => (
          <span
            class:list={['grano-caida absolute', p.escritorio && 'hidden md:block']}
            style={`left:${p.x}%;top:${p.y}%;--retraso:${p.r}ms`}
          >
            <svg class="grano-flota block" style={`width:${p.s}px;--desfase:${p.d}s`} viewBox="0 0 12 12">
              <rect x="1" y="2" width="10" height="8" rx="3.5" fill="#8a5a1f" />
            </svg>
          </span>
        ))}
      </div>

      <div class="pointer-events-none absolute inset-0" aria-hidden="true" data-capa="hojas-cerca" data-profundidad="0.35">
        <span class="grano-caida absolute -top-2 left-[2%]" style="--retraso:800ms;--giro:15deg">
          <svg class="grano-flota block w-9 text-marca" style="--desfase:-3s" viewBox="0 0 40 40">
            <path fill="currentColor" d="M4 36C4 18 16 5 37 3c-1 20-13 32-33 33z" />
            <path d="M6 34C14 24 22 16 32 9" stroke="#eaf4dc" stroke-width="1.6" fill="none" stroke-linecap="round" />
          </svg>
        </span>
        <span class="grano-caida absolute right-[0%] bottom-[18%] hidden md:block" style="--retraso:860ms;--giro:-15deg">
          <svg class="grano-flota block w-7 text-hoja" style="--desfase:-5s" viewBox="0 0 40 40">
            <path fill="currentColor" d="M4 36C4 18 16 5 37 3c-1 20-13 32-33 33z" />
          </svg>
        </span>
      </div>
    </div>
  </div>

  <!-- Franja verde con los diferenciales del afiche -->
  <div class="relative" data-capa="franja">
    <Onda color="text-bosque" class="-mb-px" />
    <div class="tema-oscuro">
      <div class="contenedor flex flex-col gap-4 py-6 sm:flex-row sm:items-center sm:gap-6">
        <ul class="grid flex-1 grid-cols-2 gap-x-4 gap-y-4 lg:grid-cols-4" aria-label="Lo que nos distingue">
          {negocio.diferenciales.map((d, i) => (
            <li class="flex items-start gap-2.5 text-chico font-semibold text-crema">
              <Icono nombre={iconosDiferenciales[i] ?? 'hoja'} class="mt-0.5 size-5 shrink-0 text-maiz" />
              <span>{d}</span>
            </li>
          ))}
        </ul>
        <BotonPausa class="self-end sm:self-center" />
      </div>
    </div>
  </div>
</section>

<script>
  // Canela saluda (sin 3D ni librerias): salto corto + globo anunciado por
  // role="status". Con reduced motion o animaciones pausadas no hay salto,
  // solo el globo. Escape lo cierra.
  const boton = document.querySelector<HTMLButtonElement>('[data-canela-boton]');
  const globo = document.querySelector<HTMLElement>('[data-globo-canela]');

  if (boton && globo) {
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pausado = () => document.documentElement.getAttribute('data-movimiento') === 'pausado';
    let temporizador = 0;

    const cerrar = () => {
      globo.classList.remove('visible');
      boton.removeAttribute('data-saludando');
      window.setTimeout(() => {
        if (!globo.classList.contains('visible')) globo.replaceChildren();
      }, 300);
    };

    boton.addEventListener('click', () => {
      if (!reducido.matches && !pausado()) {
        boton.classList.remove('canela-saluda');
        void boton.offsetWidth; // reinicia la animacion si se pulsa seguido
        boton.classList.add('canela-saluda');
      }

      // Vaciar y volver a escribir para que se anuncie en cada pulsacion.
      globo.replaceChildren();
      requestAnimationFrame(() => {
        const titulo = document.createElement('span');
        titulo.className = 'block font-script text-2xl leading-tight text-marca-fuerte';
        titulo.textContent = boton.dataset.titulo ?? '';
        const frase = document.createElement('span');
        frase.className = 'mt-1 block font-bold leading-snug text-tinta';
        frase.textContent = ` ${boton.dataset.frase ?? ''}`;
        globo.replaceChildren(titulo, frase);
        globo.classList.add('visible');
        boton.setAttribute('data-saludando', '');
      });

      window.clearTimeout(temporizador);
      temporizador = window.setTimeout(cerrar, 6000);
    });

    boton.addEventListener('animationend', (ev) => {
      if (ev.animationName === 'saludar') boton.classList.remove('canela-saluda');
    });

    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && globo.classList.contains('visible')) {
        window.clearTimeout(temporizador);
        cerrar();
      }
    });
  }
</script>
