---
// Vista 1 - Inicio, rediseno 0-C (bloque 22; PLAN.md 0-C, "Ajustes del
// 2026-10-17 (tarde)" y "(cierre, bloque 27)"). Fondo en DOS CAPAS sobre el
// encuadre 1920x1080 del time-lapse original: el CIELO en video
// (public/video/cielo*.{webm,mp4}, filas 0-540, bucle de 8,5 s) y el CESPED
// fijo (public/img/escena/suelo*, filas 440-1080, alfa fundida arriba), los
// dos volcados en <canvas>. Solo el cielo se mueve: la hierba ya no "hierve"
// por la compresion ni se ve doble en el empalme del bucle.
// Sin tarjeta: logo, acento, subtitulo, botones y accesos van directamente
// sobre el fondo con un velo oscuro que se funde con la escena. Los animales
// posan como una FOTO DE FAMILIA a la derecha (bloque 27): atras la vaca en
// el centro con el cerdo y el perro a los lados; en medio pato y gato; en la
// fila de delante conejos, aves (gallo, gallina y pollitos, grandes), cuyes y
// la pecera de vidrio con agua y las tilapias. Abajo, la franja de Canela
// como SEGUNDA FILA del grid: corre por delante del grupo.
//
// Ganchos:
//   [data-escena="inicio"]                  raiz de la escena (grid de 2 filas)
//   .inicio-paisaje [data-paisaje]          fondo decorativo (aria-hidden), ocupa
//                                           las 2 filas
//     .inicio-campo                         caja 16:9 (9:16 aprox. en vertical)
//                                           con encaje tipo cover
//       canvas[data-video-lienzo]           cielo: poster y cuadros del video
//                                           (src/lib/escena-lienzos.ts)
//       canvas[data-suelo-lienzo]           cesped fijo, pintado una vez
//     video[data-video-fondo]               fuente del lienzo (no se ve; muted,
//                                           playsinline, loop, preload="none")
//     .inicio-velo [data-velo]              velo oscuro para el texto (no se mueve)
//   [data-capa="granja"]                    area de los animales (paralaje 0.3)
//     .inicio-familia                       grupo; --u = alto de la vaca
//       [data-animal="<slug>"] style="--fase; --x --y --h --z (escritorio,
//                                           en unidades de --u); --mx --my --mh --mz (movil)"
//         [data-animal-cuerpo]              lo que se anima (idle). Origen abajo
//           canvas[data-animal-lienzo]      el animal, pintado tras el LCP
//         [data-sombra]                     sombra de contacto
//       [data-movil]                        los que se ven por debajo de 64rem (6)
//       [data-capa="pecera"]                pecera de las tilapias (solo
//                                           escritorio): agua (SVG), volumen
//                                           recortado con [data-animal="tilapias"]
//                                           dentro y el vidrio en un canvas
//                                           (img/escena/pecera)
//   html[data-escena-gsap]                  lo pone escena-inicio.ts mientras GSAP
//                                           anima la escena (se apaga la
//                                           respiracion CSS de respaldo)
//   [data-abrir-categoria="<id>"]           acceso por categoria (catalogo.ts)
//   [data-entra] style="--orden: N"         entrada al llegar desde otra vista
//   [data-cascada] style="--paso: N"        entrada I9 solo en carga directa
//   [data-perrito-pista] .franja-canela     pista de Canela (canela-carrera.ts)
//   (Sin boton de pausa desde el bloque 14: decision del usuario, riesgo
//   WCAG 2.2.2 registrado. html[data-movimiento="pausado"] para el video,
//   la carrera y la respiracion si se pone por codigo.)
//
// LCP: el logo. El video y los animales se pintan en <canvas>, que no es
// candidato a LCP (un <video> o un <img> grande pintado despues del logo
// pasaria a ser el LCP: medido, ver informe). Todo se pide despues de `load`
// y del primer LCP. Sin JS: <noscript> con el poster y los animales en <img>.
import { ruta, rutaSrcset } from '../../lib/ruta';
import Vista from '../Vista.astro';
import Icono from '../Icono.astro';
import { textos, altDe } from '../../lib/negocio';

const t = textos.inicio;

// Animales (public/img/animales, 480 px de alto y variante -240, recortados
// al animal). `ancho` = ancho real de la variante de 480 (prop = ancho/480).
// Posiciones en unidades de --u (alto de la vaca), desde la esquina inferior
// izquierda del grupo: x = borde izquierdo, y = pies sobre la base, h = alto.
// e = escritorio (>= 64rem), m = movil (null = no se muestra).
interface Pose {
  x: number;
  y: number;
  h: number;
  z: number;
}
interface Animal {
  slug: string;
  ancho: number;
  fase: number;
  e: Pose;
  m: Pose | null;
}
// Foto de familia (bloque 27): ancho del grupo 2,64 u en escritorio y 2,35 u
// en movil (alli las aves, delante, casi tan altas como la vaca), simetrico
// alrededor de la vaca. z = orden de apilado por profundidad (los de delante
// encima).
const animales: Animal[] = [
  // Fila de atras: vaca en el centro, cerdo y perro a sus lados
  { slug: 'vaca', ancho: 675, fase: 0.0, e: { x: 0.6, y: 0.46, h: 1, z: 1 }, m: { x: 0.52, y: 0.4, h: 0.92, z: 1 } },
  { slug: 'cerdo', ancho: 555, fase: 0.55, e: { x: 0.02, y: 0.38, h: 0.6, z: 2 }, m: { x: 0, y: 0.34, h: 0.54, z: 2 } },
  { slug: 'perro', ancho: 367, fase: 0.15, e: { x: 1.98, y: 0.38, h: 0.64, z: 2 }, m: { x: 1.84, y: 0.3, h: 0.58, z: 2 } },
  // Fila del medio (gato bajo la vaca, pato delante de sus patas)
  { slug: 'pato', ancho: 498, fase: 0.9, e: { x: 1.64, y: 0.22, h: 0.34, z: 4 }, m: { x: 1.98, y: 0, h: 0.36, z: 6 } },
  { slug: 'gato', ancho: 465, fase: 0.65, e: { x: 1.1, y: 0.25, h: 0.42, z: 4 }, m: { x: 1.58, y: 0.02, h: 0.42, z: 5 } },
  // Fila de delante (pies en la base): aves grandes para que se vean los pollitos
  { slug: 'conejos', ancho: 802, fase: 0.8, e: { x: 0, y: 0, h: 0.3, z: 7 }, m: null },
  { slug: 'aves', ancho: 959, fase: 0.3, e: { x: 0.44, y: 0, h: 0.52, z: 6 }, m: { x: 0, y: 0, h: 0.8, z: 4 } },
  { slug: 'cuyes', ancho: 902, fase: 0.4, e: { x: 1.45, y: 0, h: 0.28, z: 7 }, m: null },
];
// Pecera de vidrio con las tilapias, al final de la fila de delante
// (escritorio). Proporcion del vidrio: 621 x 400.
const pecera = { x: 1.96, y: 0, h: 0.44, z: 6 };
const tilapias = { slug: 'tilapias', ancho: 1352, fase: 0.25 };

const estilo = (a: Animal) =>
  [
    `--fase:${a.fase}`,
    `--prop:${(a.ancho / 480).toFixed(3)}`,
    `--x:${a.e.x}`,
    `--y:${a.e.y}`,
    `--h:${a.e.h}`,
    `--z:${a.e.z}`,
    ...(a.m ? [`--mx:${a.m.x}`, `--my:${a.m.y}`, `--mh:${a.m.h}`, `--mz:${a.m.z}`] : []),
  ].join(';');
---
<Vista id="inicio" nombre={textos.navegacion.find((n) => n.id === 'inicio')!.texto} class="vista-inicio" cuerpo="inicio-cuerpo">
  <div class="inicio-escena" data-escena="inicio">
    <!-- Escena (decorativa): cielo en video + cesped fijo (lienzos), velo y animales -->
    <div class="inicio-paisaje" aria-hidden="true" data-paisaje>
      <div class="inicio-campo">
        <canvas class="inicio-fondo inicio-cielo" data-video-lienzo width="0" height="0"></canvas>
        <canvas
          class="inicio-fondo inicio-suelo"
          data-suelo-lienzo
          data-fuente-escritorio={ruta('/img/escena/suelo')}
          data-fuente-movil={ruta('/img/escena/suelo-movil')}
          width="0"
          height="0"></canvas>
        <noscript>
          <picture>
            <source type="image/avif" media="(orientation: portrait)" srcset={rutaSrcset('/video/cielo-movil-poster.avif')} />
            <source type="image/webp" media="(orientation: portrait)" srcset={rutaSrcset('/video/cielo-movil-poster.webp')} />
            <source type="image/avif" srcset={rutaSrcset('/video/cielo-poster.avif')} />
            <img class="inicio-cielo inicio-fondo-sinjs" src={ruta('/video/cielo-poster.webp')} alt="" width="1280" height="360" />
          </picture>
          <picture>
            <source type="image/avif" media="(orientation: portrait)" srcset={rutaSrcset('/img/escena/suelo-movil.avif')} />
            <source type="image/webp" media="(orientation: portrait)" srcset={rutaSrcset('/img/escena/suelo-movil.webp')} />
            <source type="image/avif" srcset={rutaSrcset('/img/escena/suelo.avif')} />
            <img class="inicio-suelo inicio-fondo-sinjs" src={ruta('/img/escena/suelo.webp')} alt="" width="1281" height="427" />
          </picture>
        </noscript>
      </div>
      <video
        class="inicio-video"
        data-video-fondo
        data-fuente-escritorio={ruta('/video/cielo')}
        data-fuente-movil={ruta('/video/cielo-movil')}
        muted
        playsinline
        loop
        preload="none"
        disablepictureinpicture
        disableRemotePlayback
        tabindex="-1"
        aria-hidden="true"></video>
      <div class="inicio-velo" data-velo></div>

      <!-- Granja: foto de familia de los animales, a la derecha de la columna -->
      <div class="inicio-granja" data-capa="granja" data-paralaje data-profundidad="0.3">
        <div class="inicio-familia">
          {animales.map((a) => (
            <div
              class:list={['animal', `animal-${a.slug}`, !a.m && 'solo-escritorio']}
              data-animal={a.slug}
              data-movil={a.m ? '' : undefined}
              style={estilo(a)}
            >
              <span class="animal-sombra" data-sombra></span>
              <div class="animal-cuerpo" data-animal-cuerpo>
                <canvas class="animal-lienzo" data-animal-lienzo data-slug={a.slug} width="0" height="0"></canvas>
                <noscript><img class="animal-sinjs" src={ruta(`/img/animales/${a.slug}-240.webp`)} width={Math.round(a.ancho / 2)} height="240" alt="" /></noscript>
              </div>
            </div>
          ))}

          <!-- Pecera: coordenadas del SVG = pixeles del vidrio (621 x 400).
               Agua: frente (10,94)-(493,82), costado (493,82)-(610,90),
               fondo del vidrio (10,328)-(493,384)-(610,334). -->
          <div class="pecera solo-escritorio" data-capa="pecera" style={`--x:${pecera.x};--y:${pecera.y};--h:${pecera.h};--z:${pecera.z}`}>
            <span class="pecera-sombra"></span>
            <svg class="pecera-capa" viewBox="0 0 621 400" preserveAspectRatio="none" focusable="false">
              <defs>
                <linearGradient id="pecera-agua-fondo" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#dfe9e2" stop-opacity="0.16" />
                  <stop offset="0.55" stop-color="#9fb5aa" stop-opacity="0.2" />
                  <stop offset="1" stop-color="#5f786c" stop-opacity="0.32" />
                </linearGradient>
                <pattern id="pecera-grava" width="22" height="12" patternUnits="userSpaceOnUse">
                  <rect width="22" height="12" fill="#a99572" />
                  <ellipse cx="5" cy="4" rx="4.5" ry="3" fill="#cdbb92" />
                  <ellipse cx="15" cy="3" rx="3.5" ry="2.5" fill="#8b7656" />
                  <ellipse cx="11" cy="9" rx="4" ry="2.6" fill="#e0d2ad" />
                  <ellipse cx="20" cy="9.5" rx="3" ry="2.2" fill="#76664a" />
                  <ellipse cx="1" cy="10" rx="2.5" ry="1.8" fill="#bca77c" />
                </pattern>
              </defs>
              <polygon points="10,94 493,82 610,90 610,334 493,384 10,328" fill="url(#pecera-agua-fondo)" />
              <polygon points="10,304 173,294 610,316 610,334 493,384 10,328" fill="url(#pecera-grava)" opacity="0.92" />
              <polygon points="10,304 173,294 610,316 610,322 173,300 10,310" fill="#5d4d34" opacity="0.25" />
            </svg>
            <div class="pecera-volumen">
              <div class="animal animal-tilapias" data-animal={tilapias.slug} style={`--fase:${tilapias.fase};--prop:${(tilapias.ancho / 480).toFixed(3)}`}>
                <div class="animal-cuerpo" data-animal-cuerpo>
                  <canvas class="animal-lienzo" data-animal-lienzo data-slug={tilapias.slug} width="0" height="0"></canvas>
                  <noscript><img class="animal-sinjs" src={ruta(`/img/animales/${tilapias.slug}-240.webp`)} width={Math.round(tilapias.ancho / 2)} height="240" alt="" /></noscript>
                </div>
              </div>
              <span class="pecera-velo-agua"></span>
            </div>
            <svg class="pecera-capa" viewBox="0 0 621 400" preserveAspectRatio="none" focusable="false">
              <!-- Superficie: menisco claro y linea de brillo -->
              <polygon points="10,94 493,82 610,90 610,97 493,90 10,102" fill="#ffffff" opacity="0.16" />
              <polyline points="10,94 493,82 610,90" fill="none" stroke="#ffffff" stroke-opacity="0.8" stroke-width="2.5" />
              <polyline points="40,99 300,92" fill="none" stroke="#ffffff" stroke-opacity="0.35" stroke-width="1.5" stroke-linecap="round" />
              <!-- Burbujas sutiles -->
              <g fill="none" stroke="#ffffff" stroke-opacity="0.55" stroke-width="1.5">
                <circle cx="448" cy="150" r="5" />
                <circle cx="438" cy="122" r="3.5" />
                <circle cx="452" cy="104" r="2.5" />
                <circle cx="118" cy="132" r="3" />
              </g>
            </svg>
            <canvas class="pecera-vidrio" data-animal-lienzo data-ruta={ruta('/img/escena/pecera')} data-alto-chico="200" width="0" height="0"></canvas>
            <noscript><img class="pecera-vidrio" src={ruta('/img/escena/pecera-200.webp')} width="310" height="200" alt="" /></noscript>
          </div>
        </div>
      </div>
    </div>

    <!-- Columna de texto (izquierda en >= 64rem), sin tarjeta: sobre el velo -->
    <div class="inicio-columna">
      <div class="inicio-texto" data-entra style="--orden: 0">
        <h1 id="titulo-inicio" tabindex="-1" data-titulo-vista class="inicio-insignia">
          <img
            src={ruta('/img/marca/logo.webp')}
            srcset={rutaSrcset('/img/marca/logo-480.webp 480w, /img/marca/logo.webp 929w')}
            sizes="(min-width: 48rem) 400px, 60vw"
            width="929"
            height="489"
            alt={altDe('/img/marca/logo.webp')}
            loading="eager"
            fetchpriority="high"
            class="inicio-logo"
            data-logo-inicio
          />
        </h1>
        <p class="inicio-acento" data-cascada style="--paso: 0">{t.acento}</p>
        <p class="inicio-subtitulo" data-cascada style="--paso: 1">{t.subtitulo}</p>
        <div class="inicio-botones" data-cascada style="--paso: 2">
          <a href={t.ctaDestino} class="boton boton-oro inicio-boton inicio-boton-oro" data-cta-inicio><Icono nombre="costal" class="inicio-boton-icono" /><span>{t.cta}</span></a>
          <a href={t.ctaSecundarioDestino} class="boton inicio-boton inicio-boton-secundario" data-cta-como-llegar><Icono nombre="pin" class="inicio-boton-icono" /><span>{t.ctaSecundario}</span></a>
        </div>
        <ul class="inicio-accesos" aria-label={t.etiquetaAccesos} data-cascada style="--paso: 3">
          {t.accesos.map((a) => (
            <li>
              <a href="#productos" class="inicio-acceso" data-abrir-categoria={a.categoria}>{a.texto}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="franja-canela" data-franja-perrito data-perrito-pista>
      <div class="canela-cruce" aria-hidden="true" data-perrito>
        <span class="canela-sombra canela-sombra-reposo"></span>
        <picture data-perrito-reposo>
          <source type="image/avif" srcset={rutaSrcset('/img/canela/canela-franja.avif 1x, /img/canela/canela-franja@2x.avif 2x')} />
          <img
            src={ruta('/img/canela/canela-franja.webp')}
            srcset={rutaSrcset('/img/canela/canela-franja.webp 1x, /img/canela/canela-franja@2x.webp 2x')}
            width="153"
            height="200"
            alt=""
            decoding="async"
            class="canela-salto"
          />
        </picture>
      </div>
      <div class="canela-recorrido" aria-hidden="true" data-canela-recorrido>
        <span class="canela-sombra canela-sombra-carrera" data-canela-sombra></span>
        <div class="canela-caja" data-canela-caja></div>
      </div>
    </div>
  </div>
</Vista>

<style>
  /* Respaldo del acento mientras llega Caveat Brush (font-display: swap).
     Estas caras NO descargan nada (local()) y ajustan el ancho al de Caveat
     Brush (283 px): Arial/Helvetica 361 px -> 78 %, Roboto 325 px -> 87 %. */
  @font-face {
    font-family: 'Acento respaldo';
    src: local('Arial'), local('Helvetica'), local('Liberation Sans');
    size-adjust: 78%;
  }
  @font-face {
    font-family: 'Acento respaldo android';
    src: local('Roboto');
    size-adjust: 87%;
  }

  /* ---------- Fondo de respaldo ----------
     Colores medios del poster por altura (cielo de atardecer, horizonte al
     44 %, campo): se ve mientras llega el video y si falla. Sin azul. */
  :global(.vista-inicio) {
    background: linear-gradient(180deg, #c49a8a 0%, #bc855d 15%, #e0a060 32%, #e8ad66 42%, #8a6c2a 47%, #6c6711 56%, #5b6017 72%, #47511a 86%, #323e19 100%);
  }
  :global(.inicio-cuerpo) {
    display: flex;
  }
  .inicio-escena {
    --hueco: clamp(0.5rem, 2.2dvh, 1.25rem);
    position: relative;
    isolation: isolate;
    display: grid;
    flex: 1 0 auto;
    /* min-content: si la columna no cabe (pantallas por debajo de 360x640),
       la fila crece y la vista se desplaza (excepcion de scroll de
       vistas-hinojosa) en vez de montarse sobre la franja de Canela */
    grid-template-rows: minmax(min-content, 1fr) var(--franja-canela);
    grid-template-columns: minmax(0, 1fr);
    overflow-x: clip;
  }

  /* ---------- Paisaje (fondo decorativo, ocupa las 2 filas) ---------- */
  .inicio-paisaje {
    position: relative;
    grid-row: 1 / -1;
    grid-column: 1;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    container-type: size;
  }
  /* Caja del campo: el cuadro 1920x1080 del time-lapse original (en
     vertical, la columna 656-1264: 608x1080) con encaje tipo cover,
     centrada. Dentro, el cielo (filas 0-540: top 0, alto 50 %) y el cesped
     (filas 440-1080: top 40,74 %, alto 59,26 %; sus 40 primeras filas
     funden con el cielo por alfa). */
  .inicio-campo {
    --campo-ar: calc(16 / 9);
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100cqw, 100cqh * var(--campo-ar));
    height: max(100cqh, 100cqw / var(--campo-ar));
    translate: -50% -50%;
  }
  @media (orientation: portrait) {
    .inicio-campo {
      --campo-ar: calc(608 / 1080);
    }
  }
  /* Lienzos del cielo y del cesped. Aparecen con un fundido cuando tienen
     algo pintado. */
  .inicio-fondo {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    opacity: 0;
  }
  .inicio-cielo {
    top: 0;
    height: 50%;
  }
  .inicio-suelo {
    top: 40.7407%;
    height: 59.2593%;
  }
  .inicio-fondo[data-lista] {
    opacity: 1;
  }
  /* La fuente del lienzo no se ve (1 px transparente: no es candidato a LCP
     y el navegador la sigue decodificando) */
  .inicio-video {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  :global(.inicio-fondo-sinjs) {
    position: absolute;
    left: 0;
    display: block;
    width: 100%;
    max-width: none;
  }
  :global(.inicio-fondo-sinjs.inicio-cielo) {
    top: 0;
    height: 50%;
  }
  :global(.inicio-fondo-sinjs.inicio-suelo) {
    top: 40.7407%;
    height: 59.2593%;
  }

  /* Velo oscuro (sin bordes de tarjeta): bosque-noche detras del texto que
     se desvanece hacia la escena. Opacidades elegidas midiendo el pixel mas
     claro del video tras el velo en 5 cuadros (0, 2, 4, 6 y 8 s): ver informe.
     Movil: centrado arriba, detras de la columna; escritorio: desde la
     izquierda. */
  .inicio-velo {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse var(--velo-ancho, 80%) 52% at 50% 38%, rgb(16 48 27 / 0.86) 0%, rgb(16 48 27 / 0.82) 62%, rgb(16 48 27 / 0.5) 84%, rgb(16 48 27 / 0) 100%),
      linear-gradient(180deg, rgb(16 48 27 / 0.35) 0%, rgb(16 48 27 / 0) 12%);
  }

  /* Tableta vertical: el velo no pasa del ancho del bloque de texto */
  @media (min-width: 40rem) {
    .inicio-velo {
      --velo-ancho: 24rem;
    }
  }

  .solo-escritorio {
    display: none;
  }

  /* ---------- Granja: foto de familia ----------
     Movil (< 64rem): grupo de 5 bajo los botones, apoyado abajo; Canela
     pasa por delante (la franja va por encima del paisaje). */
  .inicio-granja {
    position: absolute;
    inset: 0;
    container-type: size;
  }
  .inicio-familia {
    --u: min(20.5cqh, 31cqw);
    position: absolute;
    left: 0;
    bottom: 0.5cqh;
    /* A la izquierda de Canela sentada (su hueco a la derecha queda libre) */
    right: calc(var(--spacing-vista) + var(--canela-alto) * var(--canela-proporcion));
    width: calc(var(--u) * 2.35);
    height: calc(var(--u) * 1.32);
