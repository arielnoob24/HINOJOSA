     fill-mode both: si el script fallara, todo termina visible. Al llegar
     desde otra vista NO se repite (data-cascada-hecha; entra el panel con
     [data-entra], vistas.ts). */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js:not([data-movimiento='pausado'])) :global(#inicio:not([data-cascada-hecha])) [data-cascada] {
