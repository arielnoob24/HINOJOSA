---
// Vista 4 - Por que elegirnos (guia-estilo 7.4 y mapa de color 2.2):
//   cabecera SIEMPRE arriba (Q6); debajo, el grupo de bandas centrado en
//   vertical con margin-block: auto:
//   1. 4 pilares de esencia en bloques bosque (.tema-oscuro): el bloque
//      verde de la vista. Icono en circulo interior hoja-claro con aro maiz
//      3 px: es la UNICA familia con circulo (G2).
//   2. 4 diferenciales en banda canela oscuro (.tema-canela) A SANGRE.
//   3. Animales que atendemos en banda hoja-claro: icono SUELTO + palabra.
//      Cada animal es un enlace a #productos con el buscador filtrado por
//      ese animal (Q4, data-abrir-animal; oyente en src/lib/catalogo.ts).
//      Sellos de costal real junto a Aves, Cerdos, Vacas y Cuyes (Q1).
// Sin contadores ni cifras inventadas. Textos de pilares y diferenciales
// sin cambios (pendientes de aprobacion, bloque 10).
// Ganchos: [data-icono-animado="pilar-N" | "animal-<icono>"] (entradas.ts),
//          [data-banda], a[data-abrir-animal].
import Vista from '../Vista.astro';
import Icono from '../Icono.astro';
import { negocio, textos, catalogo, miniaturaDe } from '../../lib/negocio';
import { miniaturaLista } from '../../lib/srcset-producto';

const t = textos.porQue;
const iconosPilares = ['hoja', 'escudo', 'medalla', 'brote'];
const iconosDiferenciales = ['pin', 'costal', 'conversacion', 'verificado'];
// Palabra visible -> icono y clave del campo `animales` de productos.json
const animal: Record<string, { icono: string; clave: string }> = {
  Aves: { icono: 'ave', clave: 'ave' },
  Cerdos: { icono: 'cerdo', clave: 'cerdo' },
  Conejos: { icono: 'conejo', clave: 'conejo' },
  Cuyes: { icono: 'cuy', clave: 'cuy' },
  Vacas: { icono: 'vaca', clave: 'vaca' },
  Perros: { icono: 'perro', clave: 'perro' },
  Gatos: { icono: 'gato', clave: 'gato' },
  Tilapias: { icono: 'pez', clave: 'tilapia' },
};
// Sellos de costal (Q1): el costal real de la especie, miniatura -thumb-80
// (~4 kB). Decorativos: la palabra del animal es el texto.
const productoSello: Record<string, string> = {
  Aves: 'nutri-pollos',
  Cerdos: 'nutri-cerdos',
  Vacas: 'nutri-vacas',
  Cuyes: 'nutri-cuyes',
};
function sello(nombre: string) {
  const id = productoSello[nombre];
  const prod = id ? catalogo.productos.find((p) => p.id === id) : null;
  return prod ? miniaturaLista(miniaturaDe(prod.imagen)) : null;
}
---
<Vista id="por-que" nombre={textos.navegacion[3].texto} cuerpo="porque-cuerpo">
  <div class="pq-marco">
    <div class="pq-cabecera" data-entra style="--orden: 0">
      <h2 id="titulo-por-que" tabindex="-1" data-titulo-vista class="text-h2 titulo-vista">{t.titulo}</h2>
      <p class="pq-frase">{t.frase}</p>
    </div>

    <div class="pq-bandas">
      <section aria-labelledby="pq-pilares" data-banda="pilares" data-entra style="--orden: 1">
        <h3 id="pq-pilares" class="sr-only">{t.tituloPilares}</h3>
        <ul class="pq-pilares">
          {t.pilares.map((p, i) => (
            <li class="pq-pilar tema-oscuro">
              <span class="pq-pilar-icono" aria-hidden="true" data-icono-animado={`pilar-${i}`}>
                <Icono nombre={iconosPilares[i] ?? 'hoja'} class="size-full" />
              </span>
              <span class="pq-pilar-titulo">{p.titulo}</span>
              <span class="pq-pilar-texto">{p.texto}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="pq-banda tema-canela" aria-labelledby="pq-diferenciales" data-banda="diferenciales" data-entra style="--orden: 2">
        <h3 id="pq-diferenciales" class="sr-only">{t.tituloDiferenciales}</h3>
        <ul class="pq-diferenciales">
          {t.diferenciales.map((d, i) => (
            <li class="pq-diferencial">
              <Icono nombre={iconosDiferenciales[i] ?? 'estrella'} class="pq-dif-icono shrink-0" />
              <span>{d}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="pq-banda-animales" aria-labelledby="pq-animales" data-banda="animales" data-entra style="--orden: 2">
        <h3 id="pq-animales" class="pq-eyebrow">{t.tituloAnimales}</h3>
        <ul class="pq-animales">
          {negocio.animalesAtendidos.map((a) => {
            const info = animal[a] ?? { icono: 'hoja', clave: '' };
            const s = sello(a);
            return (
              <li>
                <a href="#productos" class="pq-animal" data-abrir-animal={info.clave || undefined}>
                  <span class="pq-animal-figura">
                    <span class="pq-animal-icono" aria-hidden="true" data-icono-animado={`animal-${info.icono}`}>
                      <Icono nombre={info.icono} class="size-full" />
                    </span>
                    {s && (
                      <span class="pq-sello" aria-hidden="true">
                        <img src={s.src} srcset={s.srcset} alt="" width={s.w} height={s.h} loading="lazy" decoding="async" />
                      </span>
                    )}
                  </span>
                  <span class="pq-animal-nombre">{a}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    </div>
  </div>
</Vista>

<style>
  /* Q6: la cabecera va arriba, como en las demas vistas; solo el grupo de
     bandas se centra en el alto que sobra (margin-block: auto). */
  .pq-marco {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: clamp(0.75rem, 2.6dvh, 1.75rem);
    width: 100%;
    max-width: var(--container-contenido);
    margin-inline: auto;
    padding: var(--spacing-vista) 1rem;
  }
  .pq-cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.25rem;
  }
  /* Acento Caveat: canela oscuro, siempre >= 24 px (5.22 sobre crema) */
  .pq-frase {
    display: none; /* adorno: en movil no cabe sin empujar contenido */
    font-family: var(--font-script);
    font-size: var(--text-acento);
    line-height: var(--text-acento--line-height);
    color: var(--color-canela-oscuro);
  }
  .pq-bandas {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 3.1dvh, 1.75rem);
    margin-block: auto;
  }

  /* ---------- Pilares: bloques bosque (.tema-oscuro), sin sombra ---------- */
  .pq-pilares {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-mosaico);
  }
  .pq-pilar {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    border-radius: var(--radius-tarjeta);
    padding: 0.5rem 0.625rem;
  }
  /* Unica familia con circulo (G2): interior hoja-claro, icono bosque
     (8.62), aro maiz 3 px (5.44 contra el bosque del bloque). */
  .pq-pilar-icono {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 3px solid var(--color-maiz);
    border-radius: 50%;
    background: var(--color-hoja-claro);
    color: var(--color-bosque);
  }
  /* El icono ocupa el 56 % del circulo a cualquier alto de pantalla */
  .pq-pilar-icono :global(svg) {
    width: 56%;
    height: 56%;
  }
  /* Titulo blanco 800 (9.80); descripcion crema (8.69) */
  .pq-pilar-titulo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1rem, var(--text-h3), 1.625rem);
    line-height: var(--text-h3--line-height);
    color: var(--color-blanco);
  }
  .pq-pilar-texto {
    display: none;
    color: var(--color-crema);
  }
  /* Reflujo (WCAG 1.4.10, QA M-2): por debajo de 360 px el titulo no cabe
     a la derecha del circulo ("Sostenibles" se salia 18 px del bloque
     bosque). Se apila el circulo encima del titulo, centrados, en las mismas
     2 columnas. A 360 px o mas no cambia nada. min-width: 0 y
     overflow-wrap son la red para textos mas largos o zoom de texto. */
  @media (max-width: 22.499rem) {
    .pq-pilar {
      flex-direction: column;
      justify-content: center;
      gap: 0.375rem;
      text-align: center;
    }
    .pq-pilar-titulo {
      min-width: 0;
      max-width: 100%;
      overflow-wrap: break-word;
    }
  }

  /* ---------- Diferenciales: banda canela oscuro A SANGRE (.tema-canela) ----------
     El margen negativo la lleva de borde a borde de la vista y el relleno
     devuelve el contenido a la columna. Texto blanco 5.88; iconos maiz
     (3.27, solo icono); filetes kraft al 40 % (decorativos). */
  .pq-banda {
    margin-inline: calc(50% - 50vw);
    padding: 0.875rem calc(50vw - 50%);
  }
  .pq-diferenciales {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1rem;
  }
  .pq-diferencial {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    line-height: 1.3;
    color: var(--color-blanco);
  }
  .pq-diferencial :global(.pq-dif-icono) {
    width: 1.75rem;
    height: 1.75rem;
    color: var(--color-maiz);
  }

  /* ---------- Animales: banda hoja-claro ---------- */
  .pq-banda-animales {
    border-radius: var(--radius-tarjeta);
    background: var(--color-hoja-claro);
    padding: 0.75rem 0.75rem 0.5rem;
  }
  /* Antetitulo canela oscuro sobre hoja-claro: 5.18 */
  .pq-eyebrow {
    margin-bottom: 0.25rem;
    font-family: var(--font-sans);
    font-size: var(--text-etiqueta);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-canela-oscuro);
  }
  .pq-animales {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.25rem 0.375rem;
  }
  /* Enlace (Q4): icono suelto bosque (8.62) + palabra tinta (12.57). Foco
     bosque 3 px (8.63 contra hoja-claro); subrayado al pasar el raton. */
  .pq-animal {
    display: flex;
    min-height: var(--spacing-objetivo);
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    border-radius: var(--radius-miniatura);
    padding: 0.25rem 0.125rem;
    text-align: center;
    color: var(--color-tinta);
  }
  .pq-animal:focus-visible {
    outline-offset: 0;
  }
  .pq-animal-figura {
    position: relative;
    display: inline-flex;
  }
  .pq-animal-icono {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    color: var(--color-bosque);
  }
  .pq-animal-nombre {
    font-size: var(--text-etiqueta);
    line-height: 1.2;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .pq-animal:hover .pq-animal-nombre {
    text-decoration-color: currentColor;
  }
  /* Sello de costal (Q1): miniatura real sobre una etiqueta kraft girada
     -6 grados, borde filete canela. 28 px en movil, 44 px en escritorio. */
  .pq-sello {
    position: absolute;
    top: -0.25rem;
    left: calc(100% + 0.125rem);
    display: inline-flex;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid var(--color-filete-canela);
    border-radius: var(--radius-miniatura);
    background: var(--color-kraft);
    transform: rotate(-6deg);
  }
  .pq-sello img {
    width: auto;
    height: 1.625rem;
  }

  @media (min-width: 48rem) {
    .pq-marco {
      padding-inline: var(--spacing-vista);
    }
    .pq-pilares {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .pq-frase {
      display: block;
    }
    .pq-pilar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding: clamp(1rem, 2.6dvh, 1.75rem) 1.25rem;
      text-align: left;
    }
    .pq-pilar-icono {
      width: clamp(3rem, 7dvh, 4rem);
      height: clamp(3rem, 7dvh, 4rem);
    }
    .pq-pilar-texto {
      display: block;
    }
    .pq-banda {
      padding-block: clamp(1rem, 2.9dvh, 1.625rem);
    }
    .pq-diferenciales {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .pq-diferencial {
      font-size: var(--text-cuerpo);
    }
    .pq-diferencial :global(.pq-dif-icono) {
      width: 2rem;
      height: 2rem;
    }
    .pq-diferencial + .pq-diferencial {
      border-left: 1px solid rgb(227 207 166 / 0.4); /* kraft al 40 % (decorativo) */
      padding-left: 1rem;
    }
    .pq-banda-animales {
      padding: clamp(0.75rem, 2dvh, 1.25rem) 1.5rem clamp(0.5rem, 1.6dvh, 1rem);
    }
    .pq-eyebrow {
      margin-bottom: 0.5rem;
    }
    .pq-animales {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
    .pq-animal-icono {
      width: clamp(2.25rem, 4.5dvh, 2.5rem);
      height: clamp(2.25rem, 4.5dvh, 2.5rem);
    }
    .pq-sello {
      top: -0.375rem;
      left: calc(100% + 0.25rem);
      width: 2.75rem;
      height: 2.75rem;
    }
    .pq-sello img {
      height: 2.5rem;
    }
  }

  /* Pilares: no son pulsables, solo se elevan (sin tilt). Solo raton, con
     movimiento y sin la pausa del sitio. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    :global(html:not([data-movimiento='pausado'])) .pq-pilar {
      transition: transform var(--duracion-hover) var(--ease-vista), box-shadow var(--duracion-hover) ease;
    }
    :global(html:not([data-movimiento='pausado'])) .pq-pilar:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-suave);
    }
  }
  @media (forced-colors: active) {
    .pq-pilar,
    .pq-banda,
    .pq-banda-animales {
      border: 1px solid CanvasText;
    }
  }
</style>

<script>
  // Entradas unicas de iconos (Nosotros, Por que) y del pin (Visitanos)
  import '../../lib/animacion/entradas';
</script>
