---
// Vista 5 - Visitanos (guia-estilo 7.5): mapa a sangre + tarjeta OPACA con
// direccion, estado y horario, referencias, contacto; pie de una linea.
// Solo se publica lo confirmado en negocio.json. El marcador
// PENDIENTE_CONFIRMAR vive solo en los datos (auditoria V1): en pantalla,
// cada dato pendiente dice textos.comunes.datoPendiente y los canales de
// contacto pendientes se agrupan en UNA linea, sin forma de boton.
//
// Sin coordenadas (V2, V3): el fondo comun de huellas y hojas sobre salvia
// (FondoHuellas, bloque 27; sin calles falsas), marca de agua del trebol, pin
// grande y aviso "Muy pronto, el mapa" en un bloque canela oscuro.
// V4: el CTA se llama "Como llegar" y el dato, "Referencias".
// Reparto del color (guia 2.2, bloque 13): tarjeta de datos bosque opaca
// (.tema-oscuro, el bloque verde de la vista): etiquetas maiz, valores
// blanco, datoPendiente crema, CTA oro sin borde, WhatsApp/Llamar en
// secundario invertido; aviso del mapa en .tema-canela.
//
// Ganchos: [data-mapa] (src/lib/mapa.ts, carga diferida al entrar),
//          [data-mapa-vacio], [data-estado-horario] (src/lib/horario.ts),
//          [data-dato-pendiente], [data-contacto-pendiente] (linea unica de
//          canales pendientes), [data-fachada] (hueco para la foto/video de
//          la fachada: aun no hay activo, por eso no se pinta).
import Vista from '../Vista.astro';
import BotonContacto from '../BotonContacto.astro';
import Icono from '../Icono.astro';
import FondoHuellas from '../FondoHuellas.astro';
import {
  negocio,
  textos,
  datoConfirmado,
  referenciasConfirmadas,
  horarioConfirmado,
  coordenadasConfirmadas,
  enlaceWhatsapp,
  telefonosConfirmados,
  enlaceCorreo,
} from '../../lib/negocio';

const t = textos.visitanos;
const pendiente = textos.comunes.datoPendiente;
const direccion = datoConfirmado('direccion');
const ciudad = datoConfirmado('ciudad');
const referencias = referenciasConfirmadas();
const horario = horarioConfirmado();
const coords = coordenadasConfirmadas();
const maps = datoConfirmado('googleMaps');
const whatsapp = enlaceWhatsapp();
const telefonos = telefonosConfirmados();
const correo = datoConfirmado('correo');
const facebook = datoConfirmado('facebook');

// Canales en el orden de la tarjeta. Los confirmados son enlaces reales;
// los pendientes solo aportan su icono (en gris) a la linea agrupada.
const canales = [
  { href: maps, texto: t.ctaMaps, nombre: t.nombreAccesibleMaps, icono: 'mapa', variante: 'cta' as const, ancho: true, pestana: true },
  { href: whatsapp, texto: t.ctaWhatsapp, nombre: t.nombreAccesibleWhatsapp, icono: 'whatsapp', variante: 'invertido' as const, ancho: false, pestana: true },
  // Un boton por telefono, con el numero a la vista (2026-10-16: dos)
  ...(telefonos.length
    ? telefonos.map((tel, i) => ({
        href: tel.href,
        texto: tel.texto,
        nombre: t.nombreAccesibleLlamar.replace('{numero}', tel.texto),
        icono: 'telefono',
        variante: 'invertido' as const,
        ancho: true, // el numero entero en una linea
        pestana: false,
        // Bloque 28d (solo movil): telefonos lado a lado, el primero en oro
        extra: i === 0 ? 'vis-accion-telefono vis-accion-principal' : 'vis-accion-telefono',
      }))
    : [{ href: null, texto: t.ctaLlamar, nombre: t.nombreAccesibleLlamar, icono: 'telefono', variante: 'invertido' as const, ancho: false, pestana: false }]),
  { href: enlaceCorreo(), texto: correo ?? t.ctaCorreo, nombre: t.nombreAccesibleCorreo.replace('{correo}', correo ?? ''), icono: 'correo', variante: 'enlace' as const, ancho: true, pestana: false },
  { href: facebook, texto: t.ctaFacebook, nombre: t.nombreAccesibleFacebook, icono: 'facebook', variante: 'enlace' as const, ancho: true, pestana: true },
];
const confirmados = canales.filter((c) => c.href);
const pendientes = canales.filter((c) => !c.href);
const textoPendientes = confirmados.length ? t.contactoPendienteParcial : t.contactoPendiente;
const anio = new Date().getFullYear();
// Bloque 28d (solo movil): mientras falten horario y referencias, una sola
// linea "Horario y referencias: muy pronto"; si llega uno, vuelven sus filas.
const juntarPendientes = !horario && !referencias;

// Textura del fondo sin mapa: hojas y granos al 8 % (tesela de 160 px,
// ~1 kB en linea). Decorativa: sin calles ni manzanas que se lean como
// una ubicacion real.
const textura =
  '<svg xmlns="http://www.w3.org/2000/svg" width="160" height="160" viewBox="0 0 160 160"><g opacity=".08">' +
  '<path transform="translate(14 22) rotate(-24)" d="M0 26C0 11 11 0 28 0c0 16-11 26-28 26z" fill="#1b4d2b"/>' +
  '<path transform="translate(96 92) rotate(38)" d="M0 22C0 9 9 0 24 0c0 14-9 22-24 22z" fill="#2e8b2e"/>' +
  '<path transform="translate(128 18) rotate(80)" d="M0 16C0 7 7 0 18 0c0 10-7 16-18 16z" fill="#1b4d2b"/>' +
  '<path transform="translate(8 134) rotate(-60)" d="M0 14C0 6 6 0 16 0c0 9-6 14-16 14z" fill="#2e8b2e"/>' +
  '<ellipse cx="112" cy="40" rx="6" ry="8.5" transform="rotate(28 112 40)" fill="#c98a3a"/>' +
  '<ellipse cx="44" cy="120" rx="6" ry="8.5" transform="rotate(-32 44 120)" fill="#c98a3a"/>' +
  '<ellipse cx="66" cy="62" rx="4.5" ry="6.5" transform="rotate(12 66 62)" fill="#f2b823"/>' +
  '<ellipse cx="146" cy="134" rx="4.5" ry="6.5" transform="rotate(-18 146 134)" fill="#c98a3a"/>' +
  '</g></svg>';
const estiloTextura = `--textura-mapa: url("data:image/svg+xml,${encodeURIComponent(textura)}")`;
// Trebol del isotipo redibujado (el mismo trazado que la marca de agua de
// VistaInicio.astro). Inline y no como fondo CSS: no compite como LCP.
// Marca de agua (maiz al 15 %) y simbolo del aviso del mapa (kraft).
const trebol =
  'M48.7 16.4Q50 16.7 51.3 16.4Q52.7 16 54.2 15.1Q55.7 14.1 57.5 12.8Q59.2 11.5 61.2 10.4Q63.2 9.2 65.5 8.3Q67.7 7.4 70.1 6.7Q72.4 5.9 75 5.5Q77.6 5 80.2 4.9Q82.9 4.8 85.6 5Q88.3 5.1 90.9 5.8Q93.5 6.5 95.4 8.1Q97.2 9.7 97.9 12.2Q98.6 14.7 98.8 17.3Q99 20 99 22.5Q99 25 98.8 27.4Q98.6 29.9 98.2 32.2Q97.7 34.5 97 36.7Q96.3 38.9 95.3 40.9Q94.3 43 92.6 44.9Q90.9 46.8 89.8 48.4Q88.6 50 89.8 51.6Q90.9 53.2 92.6 55.1Q94.3 57 95.3 59.1Q96.3 61.1 97 63.3Q97.7 65.5 98.2 67.8Q98.6 70.1 98.8 72.6Q99 75 99 77.5Q99 80 98.8 82.7Q98.6 85.3 97.9 87.8Q97.2 90.3 95.4 91.9Q93.5 93.5 90.9 94.2Q88.3 94.9 85.6 95Q82.9 95.2 80.2 95.1Q77.6 95 75 94.5Q72.4 94.1 70.1 93.3Q67.7 92.6 65.5 91.7Q63.2 90.8 61.2 89.6Q59.2 88.5 57.5 87.2Q55.7 85.9 54.2 84.9Q52.7 84 51.3 83.6Q50 83.3 48.7 83.6Q47.3 84 45.8 84.9Q44.3 85.9 42.5 87.2Q40.8 88.5 38.8 89.6Q36.8 90.8 34.5 91.7Q32.3 92.6 29.9 93.3Q27.6 94.1 25 94.5Q22.4 95 19.8 95.1Q17.1 95.2 14.4 95Q11.7 94.9 9.1 94.2Q6.5 93.5 4.6 91.9Q2.8 90.3 2.1 87.8Q1.4 85.3 1.2 82.7Q1 80 1 77.5Q1 75 1.2 72.6Q1.4 70.1 1.8 67.8Q2.3 65.5 3 63.3Q3.7 61.1 4.7 59.1Q5.7 57 7.4 55.1Q9.1 53.2 10.2 51.6Q11.4 50 10.2 48.4Q9.1 46.8 7.4 44.9Q5.7 43 4.7 40.9Q3.7 38.9 3 36.7Q2.3 34.5 1.8 32.2Q1.4 29.9 1.2 27.4Q1 25 1 22.5Q1 20 1.2 17.3Q1.4 14.7 2.1 12.2Q2.8 9.7 4.6 8.1Q6.5 6.5 9.1 5.8Q11.7 5.1 14.4 5Q17.1 4.8 19.8 4.9Q22.4 5 25 5.5Q27.6 5.9 29.9 6.7Q32.3 7.4 34.5 8.3Q36.8 9.2 38.8 10.4Q40.8 11.5 42.5 12.8Q44.3 14.1 45.8 15.1Q47.3 16 48.7 16.4Z';
---
<Vista id="visitanos" nombre={textos.navegacion.find((n) => n.id === 'visitanos')!.texto} cuerpo="visitanos-cuerpo">
  <div class="vis-escena">
    <div
      class:list={['vis-mapa', !coords && 'vis-mapa-sin-ubicacion']}
      style={estiloTextura}
      data-mapa
      data-captura-flechas
      data-lat={coords ? String(coords.lat) : ''}
      data-lng={coords ? String(coords.lng) : ''}
      data-nombre={negocio.nombre}
    >
      {!coords && (
        <svg class="vis-marca-agua" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><path fill="currentColor" d={trebol} /></svg>
      )}
      <div class="vis-mapa-vacio" data-mapa-vacio data-entra style="--orden: 1" aria-hidden={coords ? 'true' : undefined}>
        <svg class="vis-pin" viewBox="0 0 64 84" aria-hidden="true">
          <ellipse cx="32" cy="80" rx="14" ry="3.5" fill="#14301d" opacity=".18" />
          <path d="M32 76S6 50 6 30a26 26 0 0 1 52 0c0 20-26 46-26 46z" fill="#1b4d2b" />
          <circle cx="32" cy="30" r="17" fill="#fff" stroke="#f2b823" stroke-width="4" />
          <path d="M26 21v18M38 21v18M26 30h12" stroke="#1b4d2b" stroke-width="5" stroke-linecap="round" />
        </svg>
        {!coords && (
          <div class="vis-pronto tema-canela">
            <svg class="vis-pronto-isotipo" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><path fill="currentColor" d={trebol} /></svg>
            <p class="vis-pronto-texto">
              <strong class="vis-pronto-titulo">{t.mapaProntoTitulo}</strong>
              <span>{t.mapaPendiente}</span>
            </p>
          </div>
        )}
      </div>
      <p class="vis-mapa-error" role="status" data-mapa-estado hidden>{t.mapaNoDisponible}</p>
    </div>

    <article class="vis-tarjeta tema-oscuro" aria-labelledby="titulo-visitanos" data-entra style="--orden: 0">
      {/* Bloque 28d: pin H pequeno en la esquina (solo movil, decorativo) */}
      <svg class="vis-pin-esquina" viewBox="0 0 64 84" aria-hidden="true" focusable="false">
        <path d="M32 76S6 50 6 30a26 26 0 0 1 52 0c0 20-26 46-26 46z" fill="#f6f1e4" />
        <circle cx="32" cy="30" r="17" fill="#fff" stroke="#f2b823" stroke-width="4" />
        <path d="M26 21v18M38 21v18M26 30h12" stroke="#1b4d2b" stroke-width="5" stroke-linecap="round" />
      </svg>
      <p class="vis-eyebrow">{t.titulo}</p>
      <h2 id="titulo-visitanos" tabindex="-1" data-titulo-vista class="vis-nombre titulo-vista">{negocio.nombre}</h2>

      {horario && horario.zona && (
        <p
          class="vis-estado"
          data-estado-horario
          data-tramos={JSON.stringify(horario.tramos)}
          data-zona={horario.zona}
          data-texto-abierto={t.abierto}
          data-texto-cerrado={t.cerrado}
          hidden
        >
          <span data-icono-abierto><Icono nombre="verificado" class="size-4" /></span>
          <span data-icono-cerrado hidden><Icono nombre="reloj" class="size-4" /></span>
          <span data-estado-texto></span>
        </p>
      )}

      <dl class="vis-datos">
        <div class="vis-dato-direccion">
          <dt>{t.etiquetaDireccion}</dt>
          <dd>
            <span class="vis-dato-icono" aria-hidden="true"><Icono nombre="pin" class="size-5" /></span>
            {direccion ? (
              <>{direccion}{ciudad && <>, {ciudad}</>}</>
            ) : (
              <span class="vis-pendiente" data-dato-pendiente>{pendiente}</span>
            )}
          </dd>
        </div>
        {/* Antes de Horario y no al final: el :last-child de la variante baja
            de escritorio sigue siendo Referencias */}
        {juntarPendientes && (
          <div class="vis-dato-junto">
            <dt>{t.etiquetaHorarioReferencias}<span aria-hidden="true">:</span></dt>
            <dd><span class="vis-pendiente">{t.horarioReferenciasPendiente}</span></dd>
          </div>
        )}
        <div class:list={[juntarPendientes && 'vis-dato-separado']}>
          <dt>{t.etiquetaHorario}</dt>
          <dd>{horario?.texto ?? <span class="vis-pendiente" data-dato-pendiente>{pendiente}</span>}</dd>
        </div>
        <div class:list={[juntarPendientes && 'vis-dato-separado']}>
          <dt>{t.etiquetaReferencias}</dt>
          <dd>
            {referencias ? (
              <ul class="vis-referencias">{referencias.map((r) => <li>{r}</li>)}</ul>
            ) : (
              <span class="vis-pendiente" data-dato-pendiente>{pendiente}</span>
            )}
          </dd>
        </div>
      </dl>

      {confirmados.length > 0 && (
        <div class="vis-acciones">
          {confirmados.map((c) => (
            <BotonContacto
              href={c.href}
              texto={c.texto}
              nombreAccesible={c.nombre}
              icono={c.icono}
              variante={c.variante}
              pestanaNueva={c.pestana}
              class={[c.ancho ? 'vis-accion-ancha' : '', 'extra' in c ? c.extra : ''].filter(Boolean).join(' ')}
            />
          ))}
        </div>
      )}
      {pendientes.length > 0 && (
        <p class="vis-contacto-pendiente" data-contacto-pendiente>
          <span class="vis-contacto-iconos" aria-hidden="true">
            {pendientes.map((c) => <Icono nombre={c.icono} class="size-5" />)}
          </span>
          <span>{textoPendientes}</span>
        </p>
      )}
    </article>
  </div>

  <footer class="vis-pie">
    <p>
      <span class="vis-pie-lema">{t.pie.lema}</span>
      <span class="vis-pie-lema" aria-hidden="true"> · </span>
      <span>{t.pie.copyright.replace('{anio}', String(anio))}</span>
      <span aria-hidden="true"> · </span>
      <span>{t.pie.avisoMarcas}</span>
    </p>
  </footer>
  {/* Fondo comun de huellas y hojas sobre salvia (bloque 27). Se ve donde
      no hay mapa; con coordenadas, las teselas de Leaflet lo tapan */}
  <FondoHuellas id="visitanos" slot="fuera" />
</Vista>

<style>
  .vis-escena {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
  }
  /* Fondo del mapa: crema + textura de hojas y granos al 8 % (V3). Con
     coordenadas, las teselas de Leaflet lo cubren. */
  .vis-mapa {
    position: relative;
    height: 12.5rem;
    flex: 0 0 auto;
    overflow: hidden;
    background-color: var(--color-crema);
    background-image: var(--textura-mapa);
    background-size: 160px 160px;
    background-position: center;
  }
  /* Sin mapa (bloque 27): transparente, se ve el fondo comun de huellas y
     hojas sobre salvia (FondoHuellas) en lugar de la textura crema. Encima
     solo van superficies propias: el pin, el aviso canela y la tarjeta. */
  .vis-mapa-sin-ubicacion {
    height: 11rem;
    background: none;
  }
  .vis-mapa :global(.mapa-lienzo) {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .vis-mapa-vacio {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    padding: 1rem 1rem 2.25rem; /* abajo: la tarjeta monta 1.5rem */
  }
  .vis-mapa-vacio[hidden] {
    display: none;
  }
  /* Marca de agua del trebol (V3): maiz al 15 %, centrada en la zona libre
     de la tarjeta. Decorativa, por debajo del pin y del aviso. */
  .vis-marca-agua {
    position: absolute;
    top: 50%;
    left: 50%;
    height: 92%;
    aspect-ratio: 1;
    translate: -50% -50%;
    color: var(--color-maiz);
    opacity: 0.15;
    pointer-events: none;
  }
  .vis-pin {
    width: 4rem;
    flex: 0 0 auto;
  }
  /* "Muy pronto, el mapa": el bloque canela de la vista (.tema-canela).
     Texto blanco (5.88); trebol kraft (3.85, solo simbolo). */
  .vis-pronto {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 19rem;
    border-radius: var(--radius-tarjeta);
    padding: 0.75rem 1rem 0.75rem 0.75rem;
    box-shadow: var(--shadow-suave);
  }
  .vis-pronto-isotipo {
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    color: var(--color-kraft);
  }
  .vis-pronto-texto {
    display: grid;
    gap: 0.125rem;
    font-size: var(--text-chico);
    line-height: var(--text-chico--line-height);
    color: var(--color-blanco);
  }
  .vis-pronto-titulo {
    font-size: var(--text-etiqueta);
    font-weight: 800;
    color: var(--color-blanco);
  }
  .vis-pin {
    position: relative;
  }
  .vis-mapa-error {
    position: absolute;
    left: 50%;
    top: 1rem;
    max-width: 30ch;
    translate: -50% 0;
    border-radius: var(--radius-tarjeta);
    background: var(--color-blanco);
    padding: 0.5rem 0.875rem;
    font-size: var(--text-chico);
    color: var(--color-tinta);
    text-align: center;
    box-shadow: var(--shadow-suave);
  }
  .vis-mapa-error[hidden] {
    display: none;
  }

  /* Tarjeta: bosque 100 % opaca (.tema-oscuro; nunca cristal sobre el
     mapa). Es el bloque verde de la vista. */
  .vis-tarjeta {
    position: relative;
    z-index: var(--z-flotante);
    margin: -1.5rem 0 0;
    border-radius: var(--radius-tarjeta-grande) var(--radius-tarjeta-grande) 0 0;
    padding: 1.25rem 1rem 1.5rem;
    box-shadow: var(--shadow-flotante);
  }
  /* Antetitulo maiz (5.44 sobre bosque); h2 blanco (9.80) con el trazo
     maiz (global.css) */
  .vis-eyebrow {
    font-size: var(--text-etiqueta);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-maiz);
  }
  .vis-nombre {
    font-size: min(var(--text-h2), 1.75rem);
    line-height: 1.1;
  }
  .vis-estado {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.5rem;
    border-radius: var(--radius-chip);
    padding: 0.25rem 0.75rem;
    font-weight: 800;
  }
  .vis-estado[hidden] {
    display: none;
  }
  .vis-estado[data-abierto='true'] {
    background: var(--color-estado-abierto-fondo);
    color: var(--color-bosque);
  }
  .vis-estado[data-abierto='false'] {
    background: var(--color-estado-cerrado-fondo);
    color: var(--color-tinta);
  }
  .vis-datos {
    display: grid;
    gap: 0.625rem;
    margin-top: 0.875rem;
  }
  /* Etiquetas maiz 800 (5.44), valores blanco (9.80) */
  .vis-datos dt {
    font-size: var(--text-chico);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-maiz);
  }
  .vis-datos dd {
    color: var(--color-blanco);
  }
  /* Dato pendiente: texto humano en crema (8.69 sobre bosque) */
  .vis-pendiente {
    color: var(--color-crema);
  }
  .vis-referencias {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .vis-acciones {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 1.125rem;
  }
  .vis-acciones :global(.vis-accion-ancha) {
    grid-column: 1 / -1;
  }
  /* Canales pendientes: UNA linea de texto con sus iconos en gris. Sin
     borde, fondo ni alto de boton: no es un control (V1). */
  /* Iconos pendiente-oscuro (crema al 70 %: 5.17 sobre bosque), texto
     crema (8.69); filete hoja al 40 % (decorativo) */
  .vis-contacto-pendiente {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    border-top: 1px solid var(--color-horizonte-fuerte);
    padding-top: 0.875rem;
    font-size: var(--text-chico);
    line-height: var(--text-chico--line-height);
    color: var(--color-crema);
  }
  .vis-contacto-iconos {
    display: inline-flex;
    flex: 0 0 auto;
    gap: 0.375rem;
    color: var(--color-pendiente-oscuro);
  }
  .vis-acciones + .vis-contacto-pendiente {
    border-top: 0;
    padding-top: 0;
    margin-top: 0.75rem;
  }
  .vis-pie {
    --color-foco: var(--color-foco-oscuro);
    flex: 0 0 auto;
    background: var(--color-bosque-noche);
    padding: 0.5rem 1rem;
    font-size: var(--text-chico);
    line-height: var(--text-chico--line-height);
    color: var(--color-crema);
    text-align: center;
  }

  /* Movil: la escena no se encoge. Con flex-shrink 1 + min-height 0 se
     quedaba mas baja que la tarjeta, y la tarjeta (z-index flotante) tapaba
     el pie, que no se llegaba a ver ni desplazando (QA fase 5, 360x640). */
  @media (max-width: 47.999rem) {
    .vis-escena {
      flex-shrink: 0;
    }
  }

  /* Piezas solo de movil (bloque 28d): fuera de < 48rem no se pintan */
  .vis-pin-esquina,
