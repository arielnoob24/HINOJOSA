---
// Vista 5 - Visitanos (guia-estilo 7.5): mapa a sangre + tarjeta OPACA con
// direccion, estado y horario, referencias, contacto; pie de una linea.
// Solo se publica lo confirmado en negocio.json. El marcador
// PENDIENTE_CONFIRMAR vive solo en los datos (auditoria V1): en pantalla,
// cada dato pendiente dice textos.comunes.datoPendiente y los canales de
// contacto pendientes se agrupan en UNA linea, sin forma de boton.
//
// Sin coordenadas (V2, V3): fondo crema con textura de hojas y granos al
// 8 % (sin calles falsas), pin grande y tarjeta "Muy pronto, el mapa".
// V4: el CTA se llama "Como llegar" y el dato, "Referencias".
//
// Ganchos: [data-mapa] (src/lib/mapa.ts, carga diferida al entrar),
//          [data-mapa-vacio], [data-estado-horario] (src/lib/horario.ts),
//          [data-dato-pendiente], [data-contacto-pendiente] (linea unica de
//          canales pendientes), [data-fachada] (hueco para la foto/video de
//          la fachada: aun no hay activo, por eso no se pinta).
import Vista from '../Vista.astro';
import BotonContacto from '../BotonContacto.astro';
import Icono from '../Icono.astro';
import {
  negocio,
  textos,
  datoConfirmado,
  referenciasConfirmadas,
  horarioConfirmado,
  coordenadasConfirmadas,
  enlaceWhatsapp,
  enlaceTelefono,
} from '../../lib/negocio';

const t = textos.visitanos;
const pendiente = textos.comunes.datoPendiente;
const direccion = datoConfirmado('direccion');
const ciudad = datoConfirmado('ciudad');
const referencias = referenciasConfirmadas();
const horario = horarioConfirmado();
const coords = coordenadasConfirmadas();
const maps = datoConfirmado('googleMaps');
const whatsapp = enlaceWhatsapp();
const telefono = enlaceTelefono();
const facebook = datoConfirmado('facebook');

// Canales en el orden de la tarjeta. Los confirmados son enlaces reales;
// los pendientes solo aportan su icono (en gris) a la linea agrupada.
const canales = [
  { href: maps, texto: t.ctaMaps, nombre: t.nombreAccesibleMaps, icono: 'mapa', variante: 'cta' as const, ancho: true, pestana: true },
  { href: whatsapp, texto: t.ctaWhatsapp, nombre: t.nombreAccesibleWhatsapp, icono: 'whatsapp', variante: 'primario' as const, ancho: false, pestana: true },
  { href: telefono, texto: t.ctaLlamar, nombre: t.nombreAccesibleLlamar, icono: 'telefono', variante: 'primario' as const, ancho: false, pestana: false },
  { href: facebook, texto: t.ctaFacebook, nombre: t.nombreAccesibleFacebook, icono: 'facebook', variante: 'enlace' as const, ancho: true, pestana: true },
];
const confirmados = canales.filter((c) => c.href);
const pendientes = canales.filter((c) => !c.href);
const textoPendientes = confirmados.length ? t.contactoPendienteParcial : t.contactoPendiente;
const anio = new Date().getFullYear();

// Textura del fondo sin mapa: hojas y granos al 8 % (tesela de 160 px,
// ~1 kB en linea). Decorativa: sin calles ni manzanas que se lean como
// una ubicacion real.
const textura =
  '<svg xmlns="http://www.w3.org/2000/svg" width="160" height="160" viewBox="0 0 160 160"><g opacity=".08">' +
  '<path transform="translate(14 22) rotate(-24)" d="M0 26C0 11 11 0 28 0c0 16-11 26-28 26z" fill="#1b4d2b"/>' +
  '<path transform="translate(96 92) rotate(38)" d="M0 22C0 9 9 0 24 0c0 14-9 22-24 22z" fill="#2e8b2e"/>' +
  '<path transform="translate(128 18) rotate(80)" d="M0 16C0 7 7 0 18 0c0 10-7 16-18 16z" fill="#1b4d2b"/>' +
  '<path transform="translate(8 134) rotate(-60)" d="M0 14C0 6 6 0 16 0c0 9-6 14-16 14z" fill="#2e8b2e"/>' +
  '<ellipse cx="112" cy="40" rx="6" ry="8.5" transform="rotate(28 112 40)" fill="#c98a3a"/>' +
  '<ellipse cx="44" cy="120" rx="6" ry="8.5" transform="rotate(-32 44 120)" fill="#c98a3a"/>' +
  '<ellipse cx="66" cy="62" rx="4.5" ry="6.5" transform="rotate(12 66 62)" fill="#f2b823"/>' +
  '<ellipse cx="146" cy="134" rx="4.5" ry="6.5" transform="rotate(-18 146 134)" fill="#c98a3a"/>' +
  '</g></svg>';
const estiloTextura = `--textura-mapa: url("data:image/svg+xml,${encodeURIComponent(textura)}")`;
---
<Vista id="visitanos" nombre={textos.navegacion[4].texto} cuerpo="visitanos-cuerpo">
  <div class="vis-escena">
    <div
      class:list={['vis-mapa', !coords && 'vis-mapa-sin-ubicacion']}
      style={estiloTextura}
      data-mapa
      data-captura-flechas
      data-lat={coords ? String(coords.lat) : ''}
      data-lng={coords ? String(coords.lng) : ''}
      data-nombre={negocio.nombre}
    >
      <div class="vis-mapa-vacio" data-mapa-vacio aria-hidden={coords ? 'true' : undefined}>
        <svg class="vis-pin" viewBox="0 0 64 84" aria-hidden="true">
          <ellipse cx="32" cy="80" rx="14" ry="3.5" fill="#14301d" opacity=".18" />
          <path d="M32 76S6 50 6 30a26 26 0 0 1 52 0c0 20-26 46-26 46z" fill="#1b4d2b" />
          <circle cx="32" cy="30" r="17" fill="#fff" stroke="#f2b823" stroke-width="4" />
          <path d="M26 21v18M38 21v18M26 30h12" stroke="#1b4d2b" stroke-width="5" stroke-linecap="round" />
        </svg>
        {!coords && (
          <div class="vis-pronto">
            <img
              src="/img/marca/isotipo-96.webp"
              alt=""
              width="98"
              height="96"
              decoding="async"
              class="vis-pronto-isotipo"
            />
            <p class="vis-pronto-texto">
              <strong class="vis-pronto-titulo">{t.mapaProntoTitulo}</strong>
              <span>{t.mapaPendiente}</span>
            </p>
          </div>
        )}
      </div>
      <p class="vis-mapa-error" role="status" data-mapa-estado hidden>{t.mapaNoDisponible}</p>
    </div>

    <article class="vis-tarjeta" aria-labelledby="titulo-visitanos">
      <p class="vis-eyebrow">{t.titulo}</p>
      <h2 id="titulo-visitanos" tabindex="-1" data-titulo-vista class="vis-nombre">{negocio.nombre}</h2>

      {horario && horario.zona && (
        <p
          class="vis-estado"
          data-estado-horario
          data-tramos={JSON.stringify(horario.tramos)}
          data-zona={horario.zona}
          data-texto-abierto={t.abierto}
          data-texto-cerrado={t.cerrado}
          hidden
        >
          <span data-icono-abierto><Icono nombre="verificado" class="size-4" /></span>
          <span data-icono-cerrado hidden><Icono nombre="reloj" class="size-4" /></span>
          <span data-estado-texto></span>
        </p>
      )}

      <dl class="vis-datos">
        <div>
          <dt>{t.etiquetaDireccion}</dt>
          <dd>
            {direccion ? (
              <>{direccion}{ciudad && <>, {ciudad}</>}</>
            ) : (
              <span class="vis-pendiente" data-dato-pendiente>{pendiente}</span>
            )}
          </dd>
        </div>
        <div>
          <dt>{t.etiquetaHorario}</dt>
          <dd>{horario?.texto ?? <span class="vis-pendiente" data-dato-pendiente>{pendiente}</span>}</dd>
        </div>
        <div>
          <dt>{t.etiquetaReferencias}</dt>
          <dd>
            {referencias ? (
              <ul class="vis-referencias">{referencias.map((r) => <li>{r}</li>)}</ul>
            ) : (
              <span class="vis-pendiente" data-dato-pendiente>{pendiente}</span>
            )}
          </dd>
        </div>
      </dl>

      {confirmados.length > 0 && (
        <div class="vis-acciones">
          {confirmados.map((c) => (
            <BotonContacto
              href={c.href}
              texto={c.texto}
              nombreAccesible={c.nombre}
              icono={c.icono}
              variante={c.variante}
              pestanaNueva={c.pestana}
              class={c.ancho ? 'vis-accion-ancha' : ''}
            />
          ))}
        </div>
      )}
      {pendientes.length > 0 && (
        <p class="vis-contacto-pendiente" data-contacto-pendiente>
          <span class="vis-contacto-iconos" aria-hidden="true">
            {pendientes.map((c) => <Icono nombre={c.icono} class="size-5" />)}
          </span>
          <span>{textoPendientes}</span>
        </p>
      )}
    </article>
  </div>

  <footer class="vis-pie">
    <p>
      <span>{t.pie.lema}</span>
      <span aria-hidden="true"> · </span>
      <span>{t.pie.copyright.replace('{anio}', String(anio))}</span>
      <span aria-hidden="true"> · </span>
      <span>{t.pie.avisoMarcas}</span>
    </p>
  </footer>
</Vista>

<style>
  .vis-escena {
    position: relative;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
  }
  /* Fondo del mapa: crema + textura de hojas y granos al 8 % (V3). Con
     coordenadas, las teselas de Leaflet lo cubren. */
  .vis-mapa {
    position: relative;
    height: 12.5rem;
    flex: 0 0 auto;
    overflow: hidden;
    background-color: var(--color-crema);
    background-image: var(--textura-mapa);
    background-size: 160px 160px;
    background-position: center;
  }
  .vis-mapa-sin-ubicacion {
    height: 11rem;
  }
  .vis-mapa :global(.mapa-lienzo) {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .vis-mapa-vacio {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    padding: 1rem 1rem 2.25rem; /* abajo: la tarjeta monta 1.5rem */
  }
  .vis-mapa-vacio[hidden] {
    display: none;
  }
  .vis-pin {
    width: 4rem;
    flex: 0 0 auto;
  }
  /* "Muy pronto, el mapa": tarjeta opaca con el isotipo */
  .vis-pronto {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 19rem;
    border: 1px solid var(--color-crema-oscuro);
    border-radius: var(--radius-tarjeta);
    background: var(--color-superficie);
    padding: 0.75rem 1rem 0.75rem 0.75rem;
    box-shadow: var(--shadow-suave);
  }
  .vis-pronto-isotipo {
    width: 2.5rem;
    height: auto;
    flex: 0 0 auto;
  }
  .vis-pronto-texto {
    display: grid;
    gap: 0.125rem;
    font-size: var(--text-chico);
    line-height: var(--text-chico--line-height);
    color: var(--color-tinta-suave);
  }
  .vis-pronto-titulo {
    font-size: var(--text-etiqueta);
    font-weight: 800;
    color: var(--color-bosque);
  }
  .vis-mapa-error {
    position: absolute;
    left: 50%;
    top: 1rem;
    max-width: 30ch;
    translate: -50% 0;
    border-radius: var(--radius-tarjeta);
    background: var(--color-blanco);
    padding: 0.5rem 0.875rem;
    font-size: var(--text-chico);
    color: var(--color-tinta);
    text-align: center;
    box-shadow: var(--shadow-suave);
  }
  .vis-mapa-error[hidden] {
    display: none;
  }

  /* Tarjeta: blanca 100 % opaca (nunca cristal sobre el mapa) */
  .vis-tarjeta {
    position: relative;
    z-index: var(--z-flotante);
    margin: -1.5rem 0 0;
    border: 1px solid var(--color-crema-oscuro);
    border-radius: var(--radius-tarjeta-grande) var(--radius-tarjeta-grande) 0 0;
    background: var(--color-superficie);
    padding: 1.25rem 1rem 1.5rem;
    box-shadow: var(--shadow-flotante);
  }
  .vis-eyebrow {
    font-size: var(--text-etiqueta);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-canela-oscuro);
  }
  .vis-nombre {
    font-size: min(var(--text-h2), 1.75rem);
    line-height: 1.1;
  }
  .vis-estado {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.5rem;
    border-radius: var(--radius-chip);
    padding: 0.25rem 0.75rem;
    font-weight: 800;
  }
  .vis-estado[hidden] {
    display: none;
  }
  .vis-estado[data-abierto='true'] {
    background: var(--color-estado-abierto-fondo);
    color: var(--color-bosque);
  }
  .vis-estado[data-abierto='false'] {
    background: var(--color-estado-cerrado-fondo);
    color: var(--color-tinta);
  }
  .vis-datos {
    display: grid;
    gap: 0.625rem;
    margin-top: 0.875rem;
  }
  .vis-datos dt {
    font-size: var(--text-chico);
    font-weight: 800;
    color: var(--color-tinta-suave);
  }
  .vis-datos dd {
    color: var(--color-tinta);
  }
  /* Dato pendiente: texto humano en tinta suave (7.64 sobre blanco) */
  .vis-pendiente {
    color: var(--color-tinta-suave);
  }
  .vis-referencias {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .vis-acciones {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 1.125rem;
  }
  .vis-acciones :global(.vis-accion-ancha) {
    grid-column: 1 / -1;
  }
  /* Canales pendientes: UNA linea de texto con sus iconos en gris. Sin
     borde, fondo ni alto de boton: no es un control (V1). */
  .vis-contacto-pendiente {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    border-top: 1px solid var(--color-crema-oscuro);
    padding-top: 0.875rem;
    font-size: var(--text-chico);
    line-height: var(--text-chico--line-height);
    color: var(--color-tinta-suave);
  }
  .vis-contacto-iconos {
    display: inline-flex;
    flex: 0 0 auto;
    gap: 0.375rem;
    opacity: 0.7;
  }
  .vis-acciones + .vis-contacto-pendiente {
    border-top: 0;
    padding-top: 0;
    margin-top: 0.75rem;
  }
  .vis-pie {
    --color-foco: var(--color-foco-oscuro);
    flex: 0 0 auto;
    background: var(--color-bosque-noche);
    padding: 0.5rem 1rem;
    font-size: var(--text-chico);
    line-height: var(--text-chico--line-height);
    color: var(--color-crema);
    text-align: center;
  }

  /* Movil: la escena no se encoge. Con flex-shrink 1 + min-height 0 se
     quedaba mas baja que la tarjeta, y la tarjeta (z-index flotante) tapaba
     el pie, que no se llegaba a ver ni desplazando (QA fase 5, 360x640). */
  @media (max-width: 47.999rem) {
    .vis-escena {
      flex-shrink: 0;
    }
  }

  @media (min-width: 48rem) {
    :global(html[data-router] .visitanos-cuerpo) {
      overflow: hidden;
    }
    .vis-mapa {
      position: absolute;
      inset: 0;
      height: auto;
    }
    .vis-mapa-vacio {
      /* el marcador se centra en la mitad derecha, libre de la tarjeta */
      left: calc(var(--container-tarjeta-mapa) + var(--spacing-vista));
      flex-direction: column;
      gap: 1rem;
      padding: 1rem;
    }
    .vis-pin {
      width: 4.5rem;
    }
    .vis-pronto {
      flex-direction: column;
      gap: 0.5rem;
      max-width: 17rem;
      padding: 1.25rem 1.5rem 1.375rem;
      text-align: center;
    }
    .vis-pronto-isotipo {
      width: 3rem;
    }
    .vis-pronto-texto {
      gap: 0.25rem;
    }
    .vis-escena {
      justify-content: center;
      padding: var(--spacing-vista);
      padding-bottom: 3rem; /* la atribucion del mapa queda libre */
    }
    .vis-tarjeta {
      width: 100%;
      max-width: var(--container-tarjeta-mapa);
      max-height: 100%;
      overflow-y: auto;
      margin: 0;
      border-radius: var(--radius-tarjeta-grande);
      padding: 1.75rem;
    }
  }

  /* Pantallas bajas de escritorio (1366x650, 1440x700...): la tarjeta
     tenia scroll propio de ~100 px (QA M2). Se compacta: tarjeta algo mas
     ancha, datos y acciones en dos columnas, menos aire. La atribucion de
     Leaflet va abajo a la DERECHA, libre de la tarjeta (que esta a la
     izquierda), asi que el margen inferior puede bajar. */
  @media (min-width: 48rem) and (max-height: 43.75rem) {
    .vis-escena {
      padding-block: 1rem;
    }
    .vis-tarjeta {
      max-width: min(32rem, 46vw);
      padding: 1.125rem 1.25rem 1.25rem;
    }
    .vis-mapa-vacio {
      left: calc(min(32rem, 46vw) + var(--spacing-vista));
    }
    .vis-datos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem 1rem;
      margin-top: 0.625rem;
    }
    .vis-datos > div:last-child {
      grid-column: 1 / -1;
    }
    .vis-acciones {
      gap: 0.5rem;
      margin-top: 0.75rem;
    }
    .vis-acciones :global(.vis-accion-ancha) {
      grid-column: auto;
    }
    .vis-acciones :global(.contacto) {
      min-height: 2.75rem;
      padding-inline: 0.625rem;
    }
    .vis-contacto-pendiente {
      margin-top: 0.75rem;
      padding-top: 0.625rem;
    }
  }
</style>

<script>
  import '../../lib/mapa';
  import '../../lib/horario';
</script>
