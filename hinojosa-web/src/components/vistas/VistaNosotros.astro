---
// Vista 3 - Nosotros (2026-10-16, opcion A "Canela presenta"). Absorbe lo
// mejor de "Por que elegirnos", que deja de ser vista propia.
//   - Escenario: Canela jugando, GRANDE y sin tarjeta (video con alfa) sobre
//     un circulo crema-oscuro, en el crema de la vista.
//   - Columna de texto: antetitulo NOSOTROS + h2 "Somos parte de tu
//     familia" (sistema de titulos; "familia" en Caveat canela oscuro, 5.22
//     sobre crema, siempre >= 24 px), la mision como parrafo y las 3
//     razones (icono en circulo con aro maiz: la UNICA familia con circulo,
//     G2). Textos de las razones en propuesta (textos.json >
//     _estadoRazones). El bloque de razones lleva id="por-que": los enlaces
//     viejos a #por-que abren esta vista con el foco ahi (router.ts).
//   - Banda bosque a sangre al pie: animales que atendemos, cada uno enlace
//     a #productos filtrado (Q4, data-abrir-animal; oyente en catalogo.ts).
//     Solo icono + nombre (bloque 25, 0-C): sin sellos de costal.
// Fuera de pantalla: Vision y los 6 valores (siguen en negocio.json para
// metadatos y JSON-LD), pilares y diferenciales (resumidos en las razones).
//
// Video: canela-jugando-alfa.webm (VP9 con alfa), muted loop playsinline,
// preload="none", poster con alfa diferido. Safari/iOS no reproduce el alfa
// de VP9: video-vista.ts no lo reproduce ahi (data-alfa) y queda el poster.
// Solo se reproduce con la vista activa, sin reduced motion y sin la pausa
// del sitio. Sin boton de pausa (bloque 14; riesgo WCAG 2.2.2).
// Ganchos: [data-escenario], video[data-video-vista][data-alfa],
//          [data-icono-animado="razon-N" | "animal-<icono>"] (entradas.ts),
//          a[data-abrir-animal], [data-banda="animales"].
import Vista from '../Vista.astro';
import Icono from '../Icono.astro';
import { negocio, textos } from '../../lib/negocio';

const t = textos.nosotros;
const p = negocio.pantalla;
const [antes, despues] = t.frase.includes('familia') ? t.frase.split('familia') : [t.frase, null];
// Poster con alfa diferido (QA M4): data-poster -> poster al entrar en la
// vista (video-vista.ts). Sin JS se pinta como fondo del escenario.
const poster = '/video/canela-jugando-alfa-poster.webp';

// Palabra visible -> icono y clave del campo `animales` de productos.json
const animal: Record<string, { icono: string; clave: string }> = {
  Aves: { icono: 'ave', clave: 'ave' },
  Cerdos: { icono: 'cerdo', clave: 'cerdo' },
  Conejos: { icono: 'conejo', clave: 'conejo' },
  Cuyes: { icono: 'cuy', clave: 'cuy' },
  Vacas: { icono: 'vaca', clave: 'vaca' },
  Perros: { icono: 'perro', clave: 'perro' },
  Gatos: { icono: 'gato', clave: 'gato' },
  Tilapias: { icono: 'pez', clave: 'tilapia' },
};
---
<Vista id="nosotros" nombre={textos.navegacion.find((n) => n.id === 'nosotros')!.texto} cuerpo="nosotros-cuerpo">
  <div class="nos-marco">
    <header class="nos-cabecera" data-entra style="--orden: 0">
      <p class="nos-antetitulo">{t.antetitulo}</p>
      <h2 id="titulo-nosotros" tabindex="-1" data-titulo-vista class="text-h2 titulo-vista nos-titulo">
        {despues !== null ? (
          <>{antes}<span class="nos-familia">familia</span>{despues}</>
        ) : (
          t.frase
        )}
      </h2>
    </header>

    <div class="nos-escenario" data-escenario data-entra style={`--orden: 1; --poster-video: url(${poster})`}>
      <div class="nos-canela">
      <video
        muted
        loop
        playsinline
        preload="none"
        data-poster={poster}
        width="606"
        height="480"
        aria-hidden="true"
        tabindex="-1"
        disablepictureinpicture
        data-video-vista="nosotros"
        data-alfa
      >
        <source src="/video/canela-jugando-alfa.webm" type="video/webm" />
      </video>
      </div>
    </div>

    <div class="nos-cuerpo" data-entra style="--orden: 2">
      <p class="nos-mision">
        <span class="sr-only">{t.tituloMision}: </span>{p.mision}
      </p>

      <section class="nos-razones" aria-labelledby="por-que">
        <h3 id="por-que" tabindex="-1" class="nos-razones-titulo">{t.tituloRazones}</h3>
        <ul class="nos-lista-razones">
          {t.razones.map((r, i) => (
            <li class="nos-razon">
              <span class="nos-razon-icono" aria-hidden="true" data-icono-animado={`razon-${i}`}>
                <Icono nombre={r.icono} class="size-full" />
              </span>
              <span class="nos-razon-textos">
                <span class="nos-razon-titulo">{r.titulo}</span>
                {r.enlace ? (
                  <a href={r.enlace} class="nos-razon-enlace">{r.texto}<span aria-hidden="true"> →</span></a>
                ) : (
                  <span class="nos-razon-texto">{r.texto}</span>
                )}
              </span>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section class="nos-animales tema-oscuro" aria-labelledby="nos-animales" data-banda="animales" data-entra style="--orden: 2">
      <div class="nos-animales-interior">
        <h3 id="nos-animales" class="nos-animales-titulo">{t.tituloAnimales}</h3>
        <ul class="nos-lista-animales">
          {negocio.animalesAtendidos.map((a) => {
            const info = animal[a] ?? { icono: 'hoja', clave: '' };
            return (
              <li>
                <a href="#productos" class="nos-animal" data-abrir-animal={info.clave || undefined}>
                  <span class="nos-animal-icono" aria-hidden="true" data-icono-animado={`animal-${info.icono}`}>
                    <Icono nombre={info.icono} class="size-full" />
                  </span>
                  <span class="nos-animal-nombre">{a}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  </div>
</Vista>

<style>
  /* Movil (base): cabecera, Canela, mision + razones y banda, en columna */
  .nos-marco {
    display: grid;
    flex: 1 1 auto;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 1rem;
    width: 100%;
    max-width: var(--container-contenido);
    margin-inline: auto;
    padding: var(--spacing-vista) 1rem 0;
  }

  /* ---------- Cabecera: antetitulo + h2 (sistema de titulos, G3) ---------- */
  .nos-antetitulo {
    margin-bottom: 0.25rem;
    font-size: var(--text-etiqueta);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-canela-oscuro); /* 5.22 sobre crema */
  }
  .nos-titulo {
    font-size: clamp(1.75rem, min(3.6vw, 6.2dvh), 3.5rem);
    line-height: 1.05;
  }
  /* Acento Caveat canela oscuro (5.22 sobre crema; >= 24 px siempre) */
  .nos-familia {
    font-family: var(--font-script);
    font-weight: 400;
    font-size: 1.12em;
    color: var(--color-canela-oscuro);
  }

  /* ---------- Escenario de Canela ----------
     .nos-canela es la caja de Canela; el circulo crema-oscuro (decorativo)
     va detras, centrado. El video (606x480, solo el tramo sentada en ida y
     vuelta: la gorra nunca toca el borde) ocupa todo el alto de la caja y
     se desplaza para que el centro de Canela, que en el video cae al 65 %
     del ancho, quede en el centro de la caja y del circulo. Lo que sobra a
     los lados es transparente. El video ya trae su sombra. */
  .nos-escenario {
    position: relative;
    height: clamp(11rem, 32dvh, 16rem);
  }
  .nos-canela {
    --centro-canela: 65%;
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    isolation: isolate;
  }
  .nos-canela::before {
    content: '';
    position: absolute;
    z-index: -1;
    bottom: 3%;
    left: 50%;
    height: 94%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-crema-oscuro);
    transform: translateX(-50%);
  }
  /* Sin JS nadie asigna el poster: se pinta como fondo con el mismo encuadre */
  :global(html:not(.js)) .nos-canela {
    background: var(--poster-video) 62% 100% / auto 100% no-repeat;
  }
  .nos-canela video {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: auto;
    max-width: none;
    height: 100%;
    transform: translateX(calc(var(--centro-canela) * -1));
    background: transparent;
    /* Lados difuminados: la sombra del suelo del video no se corta en seco
       en el borde de la caja */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 14%, #000 86%, transparent);
  }

  /* ---------- Mision y razones ---------- */
  .nos-cuerpo {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .nos-mision {
    max-width: 34rem;
    font-size: var(--text-lead);
    line-height: var(--text-lead--line-height);
    color: var(--color-tinta);
  }
  .nos-razones-titulo {
    margin-bottom: 0.625rem;
    font-size: var(--text-etiqueta);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-bosque); /* 8.69 */
  }
  .nos-lista-razones {
    display: flex;
    flex-direction: column;
    gap: clamp(0.625rem, 1.6dvh, 1rem);
  }
  .nos-razon {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  /* Unica familia con circulo (G2): interior hoja-claro, icono bosque
     (8.62), aro maiz 3 px (decorativo). */
  .nos-razon-icono {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: clamp(2.75rem, 6dvh, 3.25rem);
    height: clamp(2.75rem, 6dvh, 3.25rem);
    border: 3px solid var(--color-maiz);
    border-radius: 50%;
    background: var(--color-hoja-claro);
    color: var(--color-bosque);
  }
  .nos-razon-icono :global(svg) {
    width: 56%;
    height: 56%;
  }
  .nos-razon-textos {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }
  .nos-razon-titulo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.2;
    color: var(--color-bosque);
  }
  .nos-razon-texto {
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--color-tinta-suave); /* 6.78 */
  }
  /* Enlace de texto: marca-fuerte sobre crema (4.77), subrayado */
  .nos-razon-enlace {
    align-self: flex-start;
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1.35;
    color: var(--color-marca-fuerte);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .nos-razon-enlace:hover {
    color: var(--color-bosque);
  }

  /* ---------- Banda bosque a sangre: animales ----------
     .tema-oscuro: foco maiz. Titulo maiz (5.44), iconos crema, nombres
     blanco (9.80). El margen negativo la lleva de borde a borde. */
  .nos-animales {
    margin-inline: calc(50% - 50vw);
    padding: 0.875rem calc(50vw - 50%) 0.75rem;
  }
  .nos-animales-titulo {
    margin-bottom: 0.375rem;
    font-size: var(--text-etiqueta);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-maiz);
  }
  .nos-lista-animales {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.25rem 0.375rem;
  }
  .nos-animal {
    display: flex;
    min-height: var(--spacing-objetivo);
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    border-radius: var(--radius-miniatura);
    padding: 0.25rem 0.125rem;
    text-align: center;
    color: var(--color-blanco);
  }
  /* Bloque 25: solo icono + nombre; el icono gana tamaño al quedar solo */
  .nos-animal-icono {
    display: inline-flex;
    width: 2.375rem;
    height: 2.375rem;
    color: var(--color-crema);
    transition: color 150ms ease-out;
  }
  @media (hover: hover) {
    .nos-animal:hover .nos-animal-icono {
      color: var(--color-maiz);
    }
  }
  .nos-animal-nombre {
    font-size: var(--text-etiqueta);
    line-height: 1.2;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .nos-animal:hover .nos-animal-nombre {
    text-decoration-color: var(--color-maiz);
  }

  /* ---------- Escritorio: Canela a la izquierda, texto a la derecha ---------- */
  @media (min-width: 48rem) {
    .nos-marco {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      /* Filas 1 y 4 elasticas: cabecera y cuerpo quedan centrados en
         vertical junto a Canela */
      grid-template-rows: minmax(0, 1fr) auto auto minmax(0, 1fr) auto;
      align-content: stretch;
      column-gap: clamp(1.5rem, 4vw, 4rem);
      row-gap: 0;
      padding: clamp(1rem, 3dvh, 2rem) var(--spacing-vista) 0;
    }
    .nos-cabecera {
      grid-column: 2;
      grid-row: 2;
    }
    .nos-escenario {
      grid-column: 1;
      grid-row: 1 / span 4;
      height: auto;
      min-height: 0;
      margin-top: clamp(0.5rem, 2dvh, 1.5rem);
    }
    /* Centrada en vertical, como la columna de texto */
    .nos-canela {
      top: 50%;
      bottom: auto;
      height: min(100%, 27rem);
      transform: translateY(-50%);
    }
    .nos-cuerpo {
      grid-column: 2;
      grid-row: 3;
      margin-top: clamp(1rem, 3dvh, 2rem);
      margin-bottom: clamp(0.75rem, 2dvh, 1.5rem);
      gap: clamp(0.875rem, 2.6dvh, 1.75rem);
    }
    .nos-animales {
      grid-column: 1 / -1;
      grid-row: 5;
      padding-block: clamp(0.625rem, 1.8dvh, 1.125rem) clamp(0.5rem, 1.4dvh, 0.875rem);
    }
    .nos-animales-interior {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }
    .nos-animales-titulo {
      flex: 0 0 auto;
      max-width: 11rem;
      margin: 0;
      line-height: 1.3;
    }
    .nos-lista-animales {
      flex: 1 1 auto;
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }
    .nos-animal-icono {
      width: clamp(2.125rem, 5dvh, 2.875rem);
      height: clamp(2.125rem, 5dvh, 2.875rem);
    }
  }

  /* Pantallas bajas de escritorio (1366x650) */
  @media (min-width: 48rem) and (max-height: 43.75rem) {
    .nos-mision {
      font-size: 1.0625rem;
      line-height: 1.4;
    }
    .nos-razon-texto {
      display: none;
    }
  }

  @media (forced-colors: active) {
    .nos-animales {
      border-top: 1px solid CanvasText;
    }
  }
</style>

<script>
  import '../../lib/video-vista';
  // Entradas unicas de iconos (razones y animales) y del pin (Visitanos)
  import '../../lib/animacion/entradas';
</script>
