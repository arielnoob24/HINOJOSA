  /* ---------- Movil: la vista entera hace scroll interno ---------- */
  @media (max-width: 47.999rem) {
    .prod-escenario {
      height: 15rem;
    }
    .prod-grupo-titulo {
      position: static;
    }
    /* El buscador queda pegado arriba al desplazar la vista: el foco que
       llega con Tab no puede quedar debajo (WCAG 2.4.11) */
    :global(html[data-router] .productos-cuerpo) {
      scroll-padding-top: 8.5rem;
    }
  }

  /* ---------- Escritorio: 55 / 45, solo la lista se desplaza ---------- */
  @media (min-width: 48rem) {
    :global(html[data-router] .productos-cuerpo) {
      overflow: hidden;
    }
    .prod-marco {
