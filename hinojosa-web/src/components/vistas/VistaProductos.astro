---
// Vista 2 - Productos (guia-estilo 7.3, storyboard-carrusel). Rediseno
// 2026-10-16 (opcion 1 "ficha del producto") + bloque 19:
//   Izquierda (60 %): 4 pestanas, escenario del carrusel con flechas y
//   rejilla de respaldo, rotulo y aria-live.
//   Derecha (40 %): buscador compacto con sugerencias (combobox, max. 6),
//   pestanas "Detalle" / "Lista (N)" (2A): la ficha del producto al frente
//   o la lista de la categoria activa (o los resultados de "Ver los N"),
//   en el mismo hueco. Al pie, la linea de compra "Todos estos productos
//   los encuentras en nuestro local · Como llegar" (1A).
//   Sin JS: sin pestanas ni ficha; la lista con los 4 grupos en la columna
//   derecha. La lista sigue en el HTML servido (SEO) y es la alternativa
//   textual del carrusel.
//   Movil: buscador, carrusel con rotulo y "Ver detalle" (abre la hoja de
//   detalle), lista de la categoria activa (sin pestanas) y compra.
//   La ficha solo existe en >= 48rem.
// Rediseno 0-C, bloques 23-24 (2026-10-17) y ajustes 23b (2026-10-17
// noche), >= 64rem: DOS columnas 68/32.
//   Izquierda: titulo y, debajo, las 4 categorias en fila con recuento
//   (se pintan al pasar el cursor o con el foco); debajo, el carrusel
//   grande (frente x1,4, ancho segun el alto del escenario).
//   Derecha: buscador arriba, la tarjeta crema con desvanecido verde
//   (Detalle | Lista; la ficha lleva la descripcion corta) y, al pie, la
//   compra con "Como llegar" en pildora. Sin el aviso legal (riesgo 20).
//   Fondo de la vista: FondoHuellas (salvia con huellas y hojas, bloque 27).
//   Entre 48 y 64rem sigue el 60/40 de arriba (mismas areas).
// Logica en src/lib/catalogo.ts (puntos de enganche documentados alli).
//
// Ganchos de marcado:
//   [data-carrusel] (data-captura-flechas, data-categoria-activa, data-modo)
//   [data-carrusel-escena]            hueco del anillo CSS 3D
//   ul[data-rejilla-categoria=<cat>]  rejilla de respaldo (definitiva sin 3D)
//   [data-rejilla-producto=<id>]      celda; aria-current="true" = al frente
//   [data-carrusel-anterior|siguiente] flechas <button>
//   [data-carrusel-rotulo] [data-rotulo-nombre|categoria|posicion|precio]
//   [data-carrusel-anuncio]           region aria-live (visualmente oculta)
//   [data-panel] (data-pestana="detalle|lista", data-modo-lista=
//     "categoria|busqueda", data-cruzando durante la transicion)
//   [data-franja] [data-franja-categoria] [data-franja-nombre|total]
//   [data-pastilla-panel] (--pastilla-x) [data-panel-cuerpo] (celda unica)
//   [data-pestanas-panel]
//   [data-pestana-boton=detalle|lista] [data-pestana-lista-texto]
//   [data-panel-lista][data-lista-catalogo] #lista-<cat> [data-producto-fila=<id>]
//   [data-filtro-lista] [data-filtro-termino] [data-quitar-filtro]
//   [data-ficha] [data-ficha-*]       ficha del producto al frente (>= 48rem);
//     [data-ficha-descripcion] (hidden si el producto no tiene descripcion)
//   [data-ver-detalle]                abre la hoja de detalle (< 48rem)
//   script#datos-catalogo             JSON con categorias y productos
//   [data-buscador] (combobox) [data-sugerencias] (listbox)
//   [data-resultado-busqueda] [data-ver-resultados]
//   [data-grupo-conteo] ("N productos" / "N de TOTAL" al filtrar)
//   [data-sin-resultados] [data-atajo-categoria=<cat>]
//   [data-entra] + style="--orden: N" (entrada escalonada, la anima
//   src/lib/animacion: cabecera 0, carrusel 1, buscador 1, panel y pie 2)
//   <HojaDetalle> (movil < 48rem, src/lib/hoja-detalle.ts)
//
// Orden del DOM (P6): cabecera, buscador, carrusel, panel (pestanas, ficha,
// lista), pie. En movil el buscador queda ENCIMA del carrusel; en
// escritorio la rejilla lo coloca arriba de la columna derecha.
import Vista from '../Vista.astro';
import Icono from '../Icono.astro';
import HojaDetalle from '../HojaDetalle.astro';
import FondoHuellas from '../FondoHuellas.astro';
import { catalogo, textos, formatoPrecio, miniaturaDe, avifDe } from '../../lib/negocio';
import { altProducto } from '../../lib/seo';
import { textoBusqueda } from '../../lib/busqueda';
import { srcsetProducto, medidasImagen, miniaturaLista, SIZES_ANILLO, SIZES_REJILLA } from '../../lib/srcset-producto';

const t = textos.productos;

type Producto = (typeof catalogo.productos)[number];
const conFondo = (p: Producto) => 'conFondo' in p && Boolean((p as { conFondo?: boolean }).conFondo);
const animalesDe = (p: Producto): string[] => ('animales' in p && Array.isArray(p.animales) ? p.animales : []);
// Descripcion corta (bloque 23b, <= 110 caracteres; la escribe
// contenido-estrategia). Si falta, la ficha y la hoja no dejan hueco.
const descripcionDe = (p: Producto): string | null =>
  'descripcion' in p && typeof p.descripcion === 'string' && p.descripcion.trim() ? p.descripcion.trim() : null;
const textoConteo = (n: number) => (n === 1 ? t.conteoUno : t.conteo.replace('{n}', String(n)));
const [vacioAntes, vacioDespues] = t.sinResultadosTitulo.split('{termino}');

// Miniatura de la lista (P10): hueco de 40 px en movil y 48 px en >= 48rem.
// Descriptores w con el lado mayor (object-fit: contain en caja cuadrada):
// la de 80 px de alto cubre 40 px a 2x; la de 160 px, 48 px a 2x.
const SIZES_MINI = '(min-width: 48rem) 48px, 40px'; // 48 px solo sin JS en escritorio
function miniatura(imagen: string | null) {
  const grande = miniaturaDe(imagen);
  const base = miniaturaLista(grande);
  if (!grande || !base) return null;
  if (!base.srcset) return { src: base.src, w: base.w, h: base.h };
  const mG = medidasImagen(grande);
  const lado = (m: { w: number; h: number }) => Math.max(m.w, m.h);
  return {
    src: base.src,
    srcset: `${base.src} ${lado(base)}w, ${grande} ${lado(mG)}w`,
    w: base.w,
    h: base.h,
  };
}

const grupos = catalogo.categorias
  .slice()
  .sort((a, b) => a.orden - b.orden)
  .map((c) => ({ ...c, productos: catalogo.productos.filter((p) => p.categoria === c.id) }));
const primera = grupos[0]?.id;
// Producto al frente al abrir la vista: el primero con imagen de la primera
// categoria (igual que catalogo.ts y el preload de Layout.astro)
const frente = grupos[0]?.productos.find((p) => p.imagen);
// Variante de 400 px de alto (la que elige el anillo en movil y a 1x); el
// preload de Layout.astro pide exactamente esta AVIF.
const frenteAvif = frente?.imagen ? frente.imagen.replace(/\.webp$/, '-400.avif') : '';
const tabla = catalogo.tablaProteinaTilapia;
// "Para:" de la ficha: clave del campo `animales` -> icono de Icono.astro
const iconoAnimal: Record<string, string> = {
  ave: 'ave', cerdo: 'cerdo', vaca: 'vaca', cuy: 'cuy', conejo: 'conejo', perro: 'perro', gato: 'gato', tilapia: 'pez',
};
const nombresAnimales = t.animales as Record<string, string>;

const datos = {
  categorias: grupos.map(({ id, nombre, nombreCorto }) => ({ id, nombre, nombreCorto })),
  productos: catalogo.productos.map((p) => ({
    id: p.id,
    categoria: p.categoria,
    nombre: p.nombre,
    marca: p.marca,
    presentacion: p.presentacion,
    precioTexto: formatoPrecio(p.precio, p.precioDesde),
    imagen: p.imagen,
    avif: avifDe(p.imagen),
    miniatura: miniaturaDe(p.imagen),
    srcset: srcsetProducto(p.imagen),
    conFondo: conFondo(p),
    animales: animalesDe(p),
    descripcion: descripcionDe(p),
  })),
  sizesAnillo: SIZES_ANILLO,
  textos: {
    etiquetaCarrusel: t.etiquetaCarrusel,
    posicion: t.posicion,
    posicionConFoto: t.posicionConFoto,
    posicionLarga: t.posicionLarga,
    posicionLargaConFoto: t.posicionLargaConFoto,
    sinResultados: t.sinResultados,
    conteo: t.conteo,
    conteoUno: t.conteoUno,
    conteoFiltrado: t.conteoFiltrado,
    resultados: t.resultados,
    resultadosUno: t.resultadosUno,
    verResultados: t.verResultados,
    verCategorias: t.verCategorias,
    filtradoPor: t.filtradoPor,
    pestanaLista: t.pestanaLista,
  },
  tablaTilapia: tabla.producto,
};
const datosJson = JSON.stringify(datos).replace(/</g, '\\u003c');
---
<Vista id="productos" nombre={textos.navegacion.find((n) => n.id === 'productos')!.texto} cuerpo="productos-cuerpo">
  <div class="prod-marco">
    <!-- ================= Cabecera ================= -->
    <header class="prod-cabecera" data-entra style="--orden: 0">
      <h2 id="titulo-productos" tabindex="-1" data-titulo-vista class="text-h2 titulo-vista">{t.titulo}</h2>
    </header>

    <!-- ================= Buscador (movil: encima del carrusel, P6) =================
         Combobox con lista de sugerencias (patron ARIA 1.2): flechas para
         moverse, Enter elige, Esc cierra (y un segundo Esc borra). Elegir
         una sugerencia gira el carrusel hasta ese producto. -->
    <div class="prod-buscador" data-solo-js data-entra style="--orden: 1">
      <label for="buscar-producto" class="prod-etiqueta">{t.etiquetaBuscador}</label>
      <div class="prod-campo">
        <Icono nombre="buscar" class="prod-lupa size-5" />
        <input
          id="buscar-producto"
          type="search"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="sugerencias-producto"
          aria-describedby="resultado-busqueda"
          autocomplete="off"
          spellcheck="false"
          placeholder={t.placeholderBuscador}
          data-buscador
        />
        <button type="button" class="prod-borrar" aria-label={t.borrarBusqueda} data-borrar-busqueda hidden>
          <Icono nombre="cerrar" class="size-5" />
        </button>
        <ul id="sugerencias-producto" class="prod-sugerencias" role="listbox" aria-label={t.etiquetaSugerencias} data-sugerencias hidden></ul>
      </div>
      <div class="prod-resultado">
        <p id="resultado-busqueda" class="prod-resultado-texto" aria-live="polite" data-resultado-busqueda></p>
        <button type="button" class="prod-ver-resultados" aria-controls="panel-lista" data-ver-resultados hidden></button>
      </div>
    </div>

    <!-- ================= Categorias =================
         Fuera de .prod-carrusel desde el bloque 23 para poder apilarlas en
         la columna izquierda (>= 64rem). Movil y tableta: mismo sitio que
         antes (entre el buscador y el carrusel). -->
    <div class="prod-categorias" data-entra style="--orden: 1">
      <div class="prod-pestanas" role="group" aria-label={t.etiquetaPestanas} data-solo-js>
        {grupos.map((g) => (
          <button
            type="button"
            class="prod-pestana"
            aria-pressed={g.id === primera ? 'true' : 'false'}
            aria-controls="carrusel-productos"
            data-categoria-boton={g.id}
          >
            <span class="prod-pestana-nombre">{g.nombreCorto}</span> <span class="prod-cuenta">({g.productos.length})</span>
          </button>
        ))}
      </div>
    </div>

    <!-- ================= Carrusel ================= -->
    <div class="prod-carrusel" data-entra style="--orden: 1">
      <div
        id="carrusel-productos"
        class="prod-escenario"
        data-carrusel
        data-captura-flechas
        data-categoria-activa={primera}
        data-modo="rejilla"
        role="region"
        aria-roledescription="carrusel"
        aria-label={`${t.etiquetaCarrusel}: ${grupos[0]?.nombre ?? ''}`}
        data-solo-js
      >
        <button type="button" class="prod-flecha prod-flecha-izq" aria-label={t.anterior} data-carrusel-anterior>
          <Icono nombre="flecha_izquierda" class="size-6" />
        </button>

        <div class="prod-escena" data-carrusel-escena>
          {frente && (
            /* Tarjeta al frente ya en el HTML (QA M5): ocupa el sitio exacto
               del producto al frente del anillo mientras llega carrusel.ts,
               asi la imagen LCP de #productos no depende del JS diferido.
               Solo se ve con html[data-carrusel-pendiente]. El <img> no lleva
               src en el HTML (en Inicio no debe bajarse): el script inline de
               al lado se lo pone en el acto si se entra directo por
               #productos, y carrusel-carga.ts al entrar desde otra vista.
               (Un fondo CSS o un <img loading="lazy"> no le valian a Chrome
               como LCP a tiempo.) Decorativa: el nombre esta en el rotulo y
               en la lista. */
            <div class="prod-frente" aria-hidden="true" data-frente-provisional={frente.id}>
              <span class:list={['prod-frente-tarjeta', conFondo(frente) && 'prod-frente-placa']}>
                <img data-src={frenteAvif} alt="" width="600" height="800" fetchpriority="high" />
              </span>
            </div>
          )}
          {frente && (
            <script is:inline>
              (function () {
                var h = document.documentElement;
                if (h.getAttribute('data-vista-inicial') !== 'productos' || !h.hasAttribute('data-carrusel-pendiente')) return;
                var i = document.querySelector('[data-frente-provisional] img');
                if (i && !i.src) i.src = i.getAttribute('data-src');
              })();
            </script>
          )}
          {grupos.map((g) => (
            <ul class="prod-rejilla" data-rejilla-categoria={g.id} hidden={g.id !== primera}>
              {g.productos.filter((p) => p.imagen).slice(0, 12).map((p) => (
                <li>
                  <button
                    type="button"
                    class:list={['prod-celda', conFondo(p) && 'prod-celda-placa']}
                    data-rejilla-producto={p.id}
                  >
                    <picture>
                      <source type="image/avif" srcset={srcsetProducto(p.imagen)?.avif ?? avifDe(p.imagen)!} sizes={SIZES_REJILLA} />
                      <img
                        src={p.imagen!}
                        srcset={srcsetProducto(p.imagen)?.webp}
                        sizes={SIZES_REJILLA}
                        alt={altProducto(p)}
                        loading="lazy"
                        decoding="async"
                        width="600"
                        height="800"
                      />
                    </picture>
                    <span class="sr-only" aria-hidden="true">{p.nombre}</span>
                  </button>
                </li>
              ))}
            </ul>
          ))}
        </div>

        <button type="button" class="prod-flecha prod-flecha-der" aria-label={t.siguiente} data-carrusel-siguiente>
          <Icono nombre="flecha_derecha" class="size-6" />
        </button>

        <!-- Rotulo dentro del carrusel: en movil las flechas van a sus lados,
             fuera del escenario (P9). Lo anima carrusel.ts (C2, C3) -->
        <div class="prod-rotulo" data-carrusel-rotulo>
          <p class="prod-rotulo-nombre" data-rotulo-nombre></p>
          <p class="prod-rotulo-meta" data-rotulo-meta>
            <span data-rotulo-categoria></span>
            <!-- Sin posicion (producto sin imagen) el separador no se pinta (P5, CSS :has) -->
            <span class="prod-rotulo-sep" aria-hidden="true">·</span>
            <span data-rotulo-posicion></span>
            <span class="prod-chip cifra" data-rotulo-precio></span>
          </p>
          <button type="button" class="prod-ver-detalle" aria-haspopup="dialog" data-ver-detalle data-solo-js>
            {t.verDetalle}
          </button>
        </div>
      </div>

      <p class="sr-only" aria-live="polite" aria-atomic="true" data-carrusel-anuncio></p>

      <!-- Sin JS: 4 tarjetas de categoria que llevan a su grupo de la lista -->
      <ul class="prod-sinjs" data-sin-js>
        {grupos.map((g) => {
          const rep = g.productos.find((p) => p.imagen);
          return (
            <li>
              <a href={`#lista-${g.id}`} class="prod-sinjs-tarjeta">
                {rep && <img src={miniaturaDe(rep.imagen)!} alt="" loading="lazy" width={medidasImagen(miniaturaDe(rep.imagen)).w} height={medidasImagen(miniaturaDe(rep.imagen)).h} />}
                <span class="font-extrabold">{g.nombre}</span>
                <span class="text-chico">{textoConteo(g.productos.length)}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <!-- ================= Panel derecho: Detalle / Lista (bloque 19, 2A; bloque 20) =================
         Escritorio (>= 48rem): un solo cuadro (fila 3 de la rejilla) con
         una franja superior bosque ([data-franja]) que lleva a la derecha el
         selector segmentado "Detalle | Lista (N)" (tablist) y, en Lista, a
         la izquierda "Categoria · N" o "Resultados para «…» · Quitar filtro".
         Debajo, en la MISMA celda ([data-panel-cuerpo], grid-area 1 / 1 para
         los dos), la ficha (Detalle, sin scroll nunca) o la lista (con scroll
         propio). data-captura-flechas: ←/→ cambian de pestana, no de vista.
         El estado lo llevan data-pestana y data-modo-lista (catalogo.ts).
         Transicion (animacion-interaccion): con data-cruzando en [data-panel]
         se ven los dos paneles a la vez, superpuestos; [data-pastilla-panel]
         es la pastilla del selector (transform por --pastilla-x).
         Movil: sin pestanas ni ficha; la lista de la categoria va bajo el
         carrusel, dentro del scroll de la vista; la franja solo aparece con
         "Resultados para «…» · Quitar filtro".
         Sin JS: sin franja ni ficha; la lista con los 4 grupos ocupa la
         columna derecha (SEO y alternativa textual del carrusel). -->
    <div class="prod-panel" data-panel data-pestana="detalle" data-modo-lista="categoria" data-entra style="--orden: 2">
      {/* Marca de agua de la tarjeta (bloque 23, maqueta Nuevos Req/tarjeta):
          hojas de trazo fino arriba a la derecha y huellas abajo a la
          derecha. Decorativa; solo con la tarjeta (>= 48rem con JS). */}
      <svg class="prod-marca-agua prod-marca-hojas" viewBox="0 0 120 150" aria-hidden="true" focusable="false" data-solo-js>
        <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M118 2C92 30 70 70 58 148" />
          <path d="M100 22c-20-4-38 6-46 24 20 6 40-4 46-24zM100 22L54 46" />
          <path d="M92 38c20-8 30-26 26-44-18 6-28 24-26 44zM92 38l26-44" transform="translate(0 6)" />
          <path d="M78 70c-22-2-40 10-46 30 22 4 42-8 46-30zM78 70l-46 30" />
          <path d="M74 80c22-6 36-24 34-46-20 6-34 24-34 46zM74 80l34-46" />
          <path d="M64 114c-18-2-34 8-40 26 18 4 36-6 40-26zM64 114l-40 26" />
        </g>
      </svg>
      <svg class="prod-marca-agua prod-marca-huellas" viewBox="0 0 110 80" aria-hidden="true" focusable="false" data-solo-js>
        <g fill="currentColor">
          <g transform="translate(26 50) rotate(-14)">
            <ellipse cx="0" cy="8" rx="13" ry="11" />
            <ellipse cx="-14" cy="-9" rx="5" ry="6.5" />
            <ellipse cx="-5" cy="-17" rx="5" ry="6.5" />
            <ellipse cx="6" cy="-17" rx="5" ry="6.5" />
            <ellipse cx="15" cy="-8" rx="5" ry="6.5" />
          </g>
          <g transform="translate(84 34) rotate(12) scale(0.9)">
            <ellipse cx="0" cy="8" rx="13" ry="11" />
            <ellipse cx="-14" cy="-9" rx="5" ry="6.5" />
            <ellipse cx="-5" cy="-17" rx="5" ry="6.5" />
            <ellipse cx="6" cy="-17" rx="5" ry="6.5" />
            <ellipse cx="15" cy="-8" rx="5" ry="6.5" />
          </g>
        </g>
      </svg>
      <div class="prod-franja" data-franja data-solo-js>
        <p class="prod-franja-titulo" tabindex="-1" data-franja-categoria>
          <span data-franja-nombre>{grupos[0]?.nombre}</span>{' '}<span aria-hidden="true">·</span><span class="sr-only">,</span>{' '}<span class="cifra" data-franja-total>{grupos[0]?.productos.length ?? 0}</span><span class="sr-only">{' '}{t.franjaProductos}</span>
        </p>
        <p class="prod-filtro" tabindex="-1" data-filtro-lista hidden>
          <span class="prod-filtro-termino" data-filtro-termino></span>
          <span aria-hidden="true">·</span>
          <button type="button" class="prod-quitar-filtro" data-quitar-filtro>{t.quitarFiltro}</button>
        </p>
        <div class="prod-selector">
          <span class="prod-selector-pastilla" data-pastilla-panel aria-hidden="true"></span>
          <div class="prod-selector-opciones" role="tablist" aria-label={t.etiquetaPanel} data-pestanas-panel data-captura-flechas>
            <button type="button" id="tab-detalle" class="prod-selector-opcion" role="tab" aria-selected="true" aria-controls="panel-detalle" tabindex="0" data-pestana-boton="detalle">
              {t.pestanaDetalle}
            </button>
            <button type="button" id="tab-lista" class="prod-selector-opcion" role="tab" aria-selected="false" aria-controls="panel-lista" tabindex="-1" data-pestana-boton="lista">
              <span data-pestana-lista-texto>{t.pestanaLista.replace('{n}', String(grupos[0]?.productos.length ?? 0))}</span>
            </button>
          </div>
        </div>
      </div>

      <div class="prod-panel-cuerpo" data-panel-cuerpo>
      <!-- Ficha compacta del producto al frente (>= 48rem, bloque 20). La
           pinta catalogo.ts con cada `hinojosa:producto`. Sin scroll: todo
           cabe con los 37 productos a 1440x900 y 1366x650. No es una region
           viva (el producto ya se anuncia en [data-carrusel-anuncio]). -->
      <div id="panel-detalle" class="prod-ficha" role="tabpanel" aria-labelledby="tab-detalle" tabindex="0" data-ficha data-solo-js>
        <div class="prod-ficha-cuerpo" data-ficha-cuerpo>
          <h3 id="ficha-nombre" class="prod-ficha-nombre" data-ficha-nombre></h3>
          <p class="prod-ficha-precio"><span class="prod-chip prod-chip-grande cifra" data-ficha-precio></span></p>
          <p class="prod-ficha-desc" data-ficha-descripcion hidden></p>
          <dl class="prod-ficha-datos" data-ficha-datos>
            <div data-ficha-fila="marca"><dt>{t.fichaMarca}</dt><dd data-ficha-marca></dd></div>
            <div data-ficha-fila="presentacion"><dt>{t.fichaPresentacion}</dt><dd data-ficha-presentacion></dd></div>
          </dl>
          <dl class="prod-ficha-para" data-ficha-para hidden>
            <dt>{t.fichaPara}</dt>
            <dd>
              <ul class="prod-ficha-animales">
                {Object.entries(nombresAnimales).map(([clave, nombre]) => (
                  <li data-ficha-animal={clave} hidden>
                    <Icono nombre={iconoAnimal[clave] ?? 'hoja'} class="size-5 shrink-0" />
                    <span>{nombre}</span>
                  </li>
                ))}
              </ul>
            </dd>
          </dl>
          {/* Solo el tilapero: proteina por etapa en 6 pastillas (2 filas de 3) */}
          <div class="prod-ficha-proteina" data-ficha-tabla hidden>
            <p id="ficha-proteina-titulo" class="prod-ficha-etiqueta">{t.tablaTilapia.tituloCorto}</p>
            <ul class="prod-ficha-etapas" aria-labelledby="ficha-proteina-titulo">
              {tabla.etapas.map((e) => (
                <li>
                  <span>{e.etapa}</span>{' '}<span class="prod-ficha-cifra cifra">{`${e.proteina} ${tabla.unidad}`}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Lista (alternativa textual del carrusel). Con JS, catalogo.ts le
           pone role="tabpanel", aria-labelledby="tab-lista" y tabindex="0"
           (es su contenedor con scroll en escritorio) y muestra solo el
           grupo de la categoria activa (o los resultados de "Ver los N").
           En escritorio, con la categoria (sin busqueda), la cabecera kraft
           del grupo se oculta: la dice la franja. data-teclas-propias:
           AvPag/RePag desplazan la lista, no la vista. -->
      <div id="panel-lista" class="prod-lista-panel" data-panel-lista data-lista-catalogo data-teclas-propias="pagina">
        {grupos.map((g) => (
          <section id={`lista-${g.id}`} class="prod-grupo" aria-labelledby={`grupo-${g.id}`} data-grupo={g.id}>
            <h3 id={`grupo-${g.id}`} class="prod-grupo-titulo" tabindex="-1">
              {g.nombre} <span aria-hidden="true">·</span><span class="sr-only">,</span>{' '}<span data-grupo-conteo>{textoConteo(g.productos.length)}</span>
            </h3>
            <ul>
              {g.productos.map((p) => {
                const mini = miniatura(p.imagen);
                const detalle = [p.marca, p.presentacion].filter(Boolean).join(' · ');
                return (
                  <li
                    data-producto-fila={p.id}
                    data-busqueda={textoBusqueda([p.nombre, p.marca, p.presentacion, g.nombre], animalesDe(p))}
                  >
                    <button type="button" class="prod-fila" data-seleccionar-producto={p.id}>
                      <span class:list={['prod-mini', p.imagen && conFondo(p) && 'prod-mini-placa', !p.imagen && 'prod-mini-costal']} aria-hidden="true">
                        {mini ? (
                          <img src={mini.src} srcset={mini.srcset} sizes={mini.srcset ? SIZES_MINI : undefined} alt="" loading="lazy" decoding="async" width={mini.w} height={mini.h} />
                        ) : (
                          <Icono nombre="costal" class="size-6" />
                        )}
                      </span>
                      <span class="prod-fila-texto">
                        <span class="prod-fila-nombre">{p.nombre}</span>
                        {detalle && <span class="prod-fila-detalle">{detalle}</span>}
                      </span>
                      <span class="prod-fila-precio cifra">{formatoPrecio(p.precio, p.precioDesde)}</span>
                    </button>
                    {/* Tabla de la tilapia: solo sin JS (con JS esta en la ficha) */}
                    {p.id === tabla.producto && (
                      <table class="prod-tabla prod-tabla-lista">
                        <caption>{t.tablaTilapia.titulo}</caption>
                        <thead>
                          <tr>
                            <th scope="col">{t.tablaTilapia.columnaEtapa}</th>
                            <th scope="col">{t.tablaTilapia.columnaProteina}</th>
                          </tr>
                        </thead>
                        <tbody>
                          {tabla.etapas.map((e) => (
                            <tr>
                              <th scope="row">{e.etapa}</th>
                              <td class="cifra">{e.proteina}{tabla.unidad}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    )}
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
        <div class="prod-vacio" data-sin-resultados hidden>
          <p class="prod-vacio-titulo">{vacioAntes}<span data-termino-buscado></span>{vacioDespues}</p>
          <p id="atajos-ayuda">{t.sinResultadosAyuda}</p>
          <ul class="prod-atajos" aria-labelledby="atajos-ayuda">
            {grupos.map((g) => (
              <li>
                <button type="button" class="prod-atajo" data-atajo-categoria={g.id}>
                  {g.nombreCorto}
                </button>
              </li>
            ))}
          </ul>
        </div>
      </div>
      </div>
    </div>

    <!-- ================= Pie: compra (1A) con "Como llegar" en pildora (bloque 24) =================
         >= 48rem: al pie de la columna derecha, bajo la tarjeta (en una fila
         desde 64rem). Movil: al final del scroll de la vista. -->
    <div class="prod-pie" data-entra style="--orden: 2">
      <p class="prod-compra">{t.compraTexto}</p>
      <a href={t.compraDestino} class="prod-llegar">
        <Icono nombre="pin" class="prod-llegar-pin size-5" />
        <span class="prod-llegar-texto">{t.compraEnlace}</span>
        <Icono nombre="flecha_derecha" class="prod-llegar-flecha size-5" />
      </a>
      {/* Sin el aviso legal (precios referenciales y marcas de terceros):
          decision del usuario del 2026-10-17, riesgo 20 del plan. Los textos
          siguen en textos.json (t.avisoPrecios, t.avisoMarcas) por si se
          pintan en Visitanos. */}
    </div>
  </div>

  {/* Fondo comun de huellas y hojas sobre salvia (bloque 27), decorativo */}
  <FondoHuellas id="productos" slot="fuera" />
  <script type="application/json" id="datos-catalogo" set:html={datosJson} />
  <HojaDetalle />
</Vista>

<style>
  /* Movil: una columna en el orden del DOM (cabecera, buscador, carrusel,
     lista). Escritorio: rejilla 55/45 (al final del bloque). */
  .prod-marco {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    width: 100%;
    max-width: var(--container-contenido);
    margin-inline: auto;
    padding: var(--spacing-vista) 1rem;
  }
  .prod-cabecera {
    min-width: 0;
  }
  .prod-carrusel {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* ---------- Pestanas ----------
     Rejilla 2x2 cuando la columna es estrecha y fila de 4 cuando cabe
     (consulta de contenedor sobre .prod-categorias). Antes era una fila con
     scroll horizontal propio y "Granos" quedaba fuera de pantalla en movil
     (QA M1). En >= 64rem, apiladas en la columna izquierda (al final). */
  .prod-categorias {
    min-width: 0;
    container-type: inline-size;
  }
  .prod-pestanas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
  @container (min-width: 34rem) {
    .prod-pestanas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  /* Movil (2026-10-16): las 4 en una fila, sin el recuento (lo dicen la
     posicion del rotulo y la lista completa), para que el carrusel suba */
  @container (min-width: 19rem) and (max-width: 33.999rem) {
    .prod-pestanas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.375rem;
    }
    .prod-pestana {
      padding-inline: 0.25rem;
    }
    .prod-cuenta {
      display: none;
    }
  }
  /* Bloque 23b: la inactiva se "pinta" al pasar el cursor o al recibir el
     foco de teclado: una capa verde (hoja al 40 %) entra de izquierda a derecha
     (background-size 0 -> 100 %), el borde pasa a bosque y el texto a
     bosque. Contrastes: reposo tinta sobre crema-oscuro 11.27 (recuento
     tinta-suave 6.03); pintada (hoja al 40 % sobre hoja-claro, #BEDF9B)
     bosque 6.62 (recuento tinta-suave 5.17) y, a mitad del barrido,
     bosque sobre crema-oscuro 7.73; activa blanco sobre bosque 9.80 y, con hover, sobre bosque-noche
     14.28. El borde (tinta-suave 6.78 / bosque 8.69 contra crema) no baja
     de 3:1. Hover solo con (hover: hover); el foco, siempre. */
  .prod-pestana {
    /* hoja al 40 % sobre hoja-claro = #BEDF9B */
    --pestana-pintada: color-mix(in srgb, var(--color-hoja) 40%, var(--color-hoja-claro));
    min-width: 0;
    min-height: var(--spacing-objetivo);
    border: 1.5px solid var(--color-borde-campo);
    border-radius: var(--radius-chip);
    background:
      linear-gradient(var(--pestana-pintada), var(--pestana-pintada)) no-repeat 0 0 / 0% 100%,
      var(--color-crema-oscuro);
    padding: 0.375rem 0.5rem;
    font-size: var(--text-etiqueta);
    font-weight: 400;
    color: var(--color-tinta);
    white-space: nowrap;
  }
  .prod-pestana[aria-pressed='false']:focus-visible {
    border-color: var(--color-bosque);
    background-size: 100% 100%, auto;
    color: var(--color-bosque);
  }
  @media (hover: hover) {
    .prod-pestana[aria-pressed='false']:hover {
      border-color: var(--color-bosque);
      background-size: 100% 100%, auto;
      color: var(--color-bosque);
    }
    .prod-pestana[aria-pressed='true']:hover {
      border-color: var(--color-bosque-noche);
      background: var(--color-bosque-noche);
    }
  }
  .prod-pestana:active {
    transform: scale(0.97);
  }
  /* C6: color en 180 ms y pulsacion en 90 ms; el barrido del relleno en
     240 ms. Solo con movimiento (ni reduced motion ni la pausa del sitio) */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-movimiento='pausado'])) .prod-pestana {
      transition:
        background-size 240ms var(--ease-vista),
        background-color var(--duracion-pestana) var(--ease-vista),
        border-color var(--duracion-pestana) var(--ease-vista),
        color var(--duracion-pestana) var(--ease-vista),
        transform var(--duracion-presion) ease-out;
    }
  }
  .prod-pestana[aria-pressed='true'] {
    border-color: var(--color-bosque);
    background: var(--color-bosque);
    color: var(--color-blanco);
    font-weight: 800;
  }
  /* El recuento pesa menos que el nombre en las inactivas (P10) */
  .prod-pestana[aria-pressed='false'] .prod-cuenta {
    color: var(--color-tinta-suave);
  }
  @media (forced-colors: active) {
    .prod-pestana[aria-pressed='true'] {
      border-width: 3px;
    }
  }

  /* ---------- Escenario ---------- */
  /* Rejilla del carrusel: fila 1 = escena (el anillo pasa por debajo de
     las flechas), fila 2 = rotulo. En movil las flechas bajan a la fila 2,
     a los lados del rotulo, fuera del escenario (P9). */
  .prod-escenario {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem 0.5rem;
  }
  .prod-escena {
    position: relative;
    grid-area: 1 / 1 / 2 / -1;
    align-self: stretch;
    min-width: 0;
    min-height: 14rem;
    overflow-y: auto;
    padding: 4px;
    border-radius: var(--radius-panel);
    background: radial-gradient(ellipse 60% 70% at 50% 45%, var(--color-foco-estudio), transparent 75%);
  }
  .prod-flecha-izq {
    grid-area: 1 / 1;
  }
  .prod-flecha-der {
    grid-area: 1 / 3;
  }
  .prod-rotulo {
    grid-area: 2 / 1 / 3 / -1;
    min-width: 0;
  }
  /* Con el carrusel 3D montado, la rejilla de respaldo se retira */
  .prod-escenario[data-modo='3d'] .prod-rejilla {
    display: none !important;
  }
  /* Mientras llega el carrusel (navegador con 3D): ni se pinta ni se
     descarga la rejilla (sus imagenes son lazy). Ver Layout.astro y
     carrusel-carga.ts (QA M5). */
  :global(html[data-carrusel-pendiente]) .prod-rejilla {
    display: none !important;
  }
  /* Tarjeta provisional: misma caja y misma linea de suelo que el producto
     al frente del anillo (.anillo / .anillo-item, mas abajo), para que el
     relevo no salte. Montado el anillo, queda DEBAJO de su frente (el
     anillo va despues en el DOM y forma su propio contexto de apilamiento),
     identica y por tanto invisible, hasta la primera interaccion o 1,5 s
     (carrusel-carga.ts). Si se ocultaba al montar, Chrome descartaba su
     candidato LCP antes de anunciarlo y el LCP pasaba al anillo (QA M5). */
  .prod-frente {
    display: none;
    position: absolute;
    inset: 0;
    --anillo-base: max(0.75rem, calc(46% - var(--carrusel-ancho) * 0.667));
    pointer-events: none;
  }
  :global(html[data-carrusel-pendiente]) .prod-frente {
    display: block;
  }
  .prod-frente-tarjeta {
    position: absolute;
    left: 50%;
    bottom: var(--anillo-base);
    display: block;
    width: var(--carrusel-ancho);
    aspect-ratio: 3 / 4;
    margin-left: calc(var(--carrusel-ancho) / -2);
    border-radius: var(--radius-tarjeta);
    /* El frente del anillo arranca "llegado" (C8: 4 px arriba); la
       provisional va igual para seguir identica debajo (regla M5). Con
       `translate` y no `transform`: se aplica DESPUES de la escala del
       realce (--escala-frente), como en el anillo, donde los -4 px van en
       el item y la escala en la tarjeta; con transform quedaba en -5,2 px */
    translate: 0 -4px;
  }
  .prod-frente-tarjeta img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
  }
  .prod-frente-tarjeta img:not([src]) {
    visibility: hidden;
  }
  .prod-frente-placa {
    overflow: hidden;
    border: 1px solid var(--color-crema-oscuro);
    background: var(--color-blanco);
    box-shadow: var(--shadow-tarjeta);
  }
  .prod-frente-placa img {
    object-fit: cover;
    object-position: center;
  }
  .prod-rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(3.75rem, 1fr));
    gap: 0.5rem;
  }
  .prod-rejilla[hidden] {
    display: none;
  }
  .prod-celda {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    border: 2px solid transparent;
    border-radius: var(--radius-tarjeta);
    background: var(--color-blanco);
    padding: 0.25rem;
    transition: transform var(--duracion-hover) var(--ease-vista), border-color var(--duracion-hover) ease;
  }
  .prod-celda img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
  }
  .prod-celda-placa {
    overflow: hidden;
    border-color: var(--color-crema-oscuro);
    padding: 0;
    box-shadow: var(--shadow-tarjeta);
  }
  .prod-celda-placa img {
    object-fit: cover;
    object-position: center;
  }
  .prod-celda:hover {
    border-color: var(--color-borde);
  }
  /* Al frente: borde bosque 3 px + marca de esquina (no solo color) */
  .prod-celda[aria-current='true'] {
    border: 3px solid var(--color-bosque);
    box-shadow: var(--shadow-elevada);
  }
  .prod-celda[aria-current='true']::after {
    content: '';
    position: absolute;
    top: 0.375rem;
    right: 0.375rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-maiz);
    box-shadow: 0 0 0 2px var(--color-bosque);
  }
  .prod-flecha {
    z-index: var(--z-control);
    display: inline-flex;
    width: var(--spacing-objetivo);
    height: var(--spacing-objetivo);
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-bosque);
    border-radius: 50%;
    background: var(--color-blanco);
    color: var(--color-bosque);
  }
  .prod-flecha:hover {
    background: var(--color-bosque);
    color: var(--color-blanco);
  }
  .prod-flecha:active {
    transform: scale(0.94);
  }
  /* C8: el chevron se mueve 3 px en su direccion al pulsar (90 ms) y vuelve (150 ms) */
  .prod-flecha-izq:active :global(svg) {
    transform: translateX(-3px);
  }
  .prod-flecha-der:active :global(svg) {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-movimiento='pausado'])) .prod-flecha {
      transition:
        background-color var(--duracion-hover) ease,
        color var(--duracion-hover) ease,
        transform var(--duracion-presion) ease-out;
    }
    :global(html:not([data-movimiento='pausado'])) .prod-flecha :global(svg) {
      transition: transform 150ms var(--ease-vista);
    }
    :global(html:not([data-movimiento='pausado'])) .prod-flecha:active :global(svg) {
      transition-duration: var(--duracion-presion);
    }
  }

  /* ---------- Rotulo ---------- */
  .prod-rotulo {
    text-align: center;
  }
  /* C2: carrusel.ts anima opacity/translateX de nombre y meta por separado */
  .prod-rotulo-nombre,
  .prod-rotulo-meta {
    will-change: transform, opacity;
  }
  .prod-rotulo-nombre {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--text-producto);
    line-height: var(--text-producto--line-height);
    color: var(--color-tinta);
    text-wrap: balance;
    min-height: 1.1em;
  }
  .prod-rotulo-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem 0.5rem;
    margin-top: 0.25rem;
    /* Sobre la salvia del fondo (bloque 27): tinta 8.01 (7.40 sobre las
       hojas); tinta-suave daria 4.29 */
    color: var(--color-tinta);
  }
  /* C3: carrusel.ts anima su ancho al cambiar ("$2.25" / "Consulta
     precio"); nowrap + overflow para que el texto no salte de linea */
  .prod-chip {
    overflow: hidden;
    border-radius: var(--radius-chip);
    background: var(--color-maiz);
    padding: 0.125rem 0.625rem;
    font-weight: 800;
    color: var(--color-tinta);
    text-align: center;
    white-space: nowrap;
  }
  .prod-chip:empty {
    display: none;
  }
  /* Producto sin posicion en el anillo (sin imagen): sin "·" colgando (P5).
     Lo decide el texto que se ve, asi va sincronizado con el rotulo aunque
     carrusel.ts retrase el cambio al 50 % del giro. */
  .prod-rotulo-meta:has([data-rotulo-posicion]:empty) .prod-rotulo-sep {
    display: none;
  }

  /* ---------- Sin JS ---------- */
  .prod-sinjs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.625rem;
  }
  :global(html.js) .prod-sinjs {
    display: none;
  }
  .prod-sinjs-tarjeta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    border-radius: var(--radius-tarjeta);
    background: var(--color-crema-oscuro);
    padding: 0.75rem;
    text-align: center;
    color: var(--color-bosque); /* 7.73 sobre crema-oscuro */
  }
  .prod-sinjs-tarjeta img {
    height: 5rem;
    width: auto;
  }

  /* ---------- Buscador (combobox) ----------
     Sin tarjeta propia: etiqueta tinta 800 sobre la salvia (8.01) y campo
     blanco con borde tinta-suave (6.78). Las sugerencias flotan encima de
     la ficha (z-index del buscador). */
  .prod-buscador {
    position: relative;
    z-index: 3;
    min-width: 0;
  }
  .prod-etiqueta {
    display: block;
    margin-bottom: 0.25rem;
    font-size: var(--text-etiqueta);
    font-weight: 800;
    color: var(--color-tinta);
  }
  .prod-campo {
    position: relative;
    display: flex;
    align-items: center;
  }
  .prod-campo :global(.prod-lupa) {
    position: absolute;
    left: 0.875rem;
    color: var(--color-tinta-suave);
    pointer-events: none;
  }
  .prod-campo input {
    width: 100%;
    min-height: 2.75rem;
    border: 1.5px solid var(--color-borde-campo);
    border-radius: var(--radius-campo);
    background: var(--color-blanco);
    padding: 0.5rem 3rem 0.5rem 2.75rem;
    font-size: max(16px, var(--text-cuerpo)); /* evita el zoom de iOS */
    color: var(--color-tinta);
    text-overflow: ellipsis; /* el ejemplo del placeholder, si no cabe */
  }
  .prod-campo input::placeholder {
    color: var(--color-tinta-suave);
  }
  .prod-campo input::-webkit-search-cancel-button {
    display: none;
  }
  .prod-campo input:focus-visible {
    outline-offset: 1px;
  }
  .prod-borrar {
    position: absolute;
    right: 0.125rem;
    display: inline-flex;
    width: var(--spacing-objetivo);
    height: var(--spacing-objetivo);
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--color-tinta);
  }
  .prod-borrar[hidden] {
    display: none;
  }

  /* Sugerencias: las crea catalogo.ts (sin el atributo de ambito de Astro,
     de ahi los :global). Opcion activa: fondo hoja-claro + barra bosque de
     4 px (no solo color). */
  .prod-sugerencias {
    position: absolute;
    top: calc(100% + 0.375rem);
    left: 0;
    right: 0;
    z-index: var(--z-control);
    max-height: min(26rem, 62dvh);
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--color-crema-oscuro);
    border-radius: var(--radius-campo);
    background: var(--color-blanco);
    padding: 0.375rem;
    box-shadow: var(--shadow-flotante);
  }
  .prod-sugerencias[hidden] {
    display: none;
  }
  .prod-sugerencias :global(.prod-sug) {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    min-height: 3rem;
    border-radius: 0.5rem;
    padding: 0.25rem 0.625rem 0.25rem 0.5rem;
    color: var(--color-tinta);
    cursor: pointer;
  }
  .prod-sugerencias :global(.prod-sug:hover),
  .prod-sugerencias :global(.prod-sug[aria-selected='true']) {
    background: var(--color-hoja-claro);
  }
  .prod-sugerencias :global(.prod-sug[aria-selected='true']) {
    box-shadow: inset 4px 0 0 var(--color-bosque);
  }
  .prod-sugerencias :global(.prod-sug-mini) {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: var(--radius-miniatura);
    background: var(--color-crema);
    color: var(--color-canela-oscuro);
  }
  .prod-sugerencias :global(.prod-sug-mini img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .prod-sugerencias :global(.prod-sug-nombre) {
    min-width: 0;
    line-height: 1.25;
  }
  .prod-sugerencias :global(.prod-sug-nombre small) {
    display: block;
    font-size: var(--text-chico);
    color: var(--color-tinta-suave);
  }
  .prod-sugerencias :global(.prod-sug-precio) {
    font-weight: 800;
    color: var(--color-bosque);
    white-space: nowrap;
  }
  /* Ultima opcion: "Ver los N" (abre la lista completa filtrada) */
  .prod-sugerencias :global(.prod-sug-todos) {
    grid-template-columns: minmax(0, 1fr);
    margin-top: 0.25rem;
    border-top: 1px solid var(--color-crema-oscuro);
    border-radius: 0 0 0.5rem 0.5rem;
    font-weight: 800;
    color: var(--color-marca-fuerte); /* 5.38 sobre blanco */
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prod-sugerencias :global(.prod-sug-vacio) {
    padding: 0.75rem 0.625rem;
    color: var(--color-tinta);
  }

  /* Resultado de la busqueda: siempre visible (es la unica senal en
     pantalla de que la busqueda filtra) + enlace a la lista filtrada */
  .prod-resultado {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.75rem;
  }
  .prod-resultado-texto {
    font-size: var(--text-chico);
    line-height: var(--text-chico--line-height);
    color: var(--color-tinta); /* sobre la salvia del fondo (bloque 27): 8.01, 7.40 sobre las hojas */
  }
  .prod-resultado-texto:not(:empty) {
    margin-top: 0.25rem;
  }
  .prod-ver-resultados {
    min-height: 1.5rem;
    font-size: var(--text-chico);
    font-weight: 800;
    color: var(--color-bosque); /* sobre la salvia del fondo: 5.50, 5.08 sobre las hojas */
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prod-ver-resultados[hidden] {
    display: none;
  }

  /* ---------- Ficha del producto al frente: tarjeta crema (bloques 23-24) ----------
     Maqueta: Nuevos Req/tarjeta. Anula la ficha bosque del bloque 18. SIN
     scroll nunca (prueba 23: los 37 productos caben a 1440x900 y
     1366x650). Contrastes (sobre crema #F6F1E4 y, desde el bloque 23b,
     sobre el peor punto del desvanecido verde de la base, hoja al 22 %
     sobre crema = #DBE6BF): nombre bosque Nunito 800 (8.69 / 7.50),
     etiquetas tinta 800 en mayusculas (12.67 / 10.94), valores y
     descripcion tinta-suave (6.78 / 5.85), chip de precio maiz con tinta
     (7.93, fondo propio), pastillas "Para" blancas con bosque (9.80, fondo
     propio), etapas del tilapero crema-oscuro con tinta (11.27). Foco bosque (8.69). Letra y huecos escalan con el
     alto (dvh). Es el tabpanel de la pestana Detalle. */
  .prod-ficha {
    display: none;
  }
  .prod-ficha-cuerpo {
    display: flex;
    min-height: 0;
    flex-direction: column;
    gap: var(--ficha-hueco);
  }
  /* Nada se encoge para caber (bloque 23b): con flex-shrink el nombre y la
     descripcion se aplastaban en silencio y la prueba 23 no lo veia */
  .prod-ficha-cuerpo > * {
    flex-shrink: 0;
  }
  .prod-ficha-nombre {
    /* Lo primero que se reduce si no cabe (bloque 20); hasta 3 lineas y,
       si aun asi no cabe, "..." (el nombre entero esta en la lista, en el
       anuncio del carrusel y en el alt) */
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(1.375rem, min(2.45vw, 4.6dvh), 2.625rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-bosque);
    text-wrap: balance;
  }
  .prod-ficha-precio {
    line-height: 1;
  }
  /* Descripcion corta (bloque 23b): 1-2 lineas en tinta-suave (6.78 sobre
     crema, 5.85 sobre el verde mas intenso del desvanecido); si un texto
     largo no cabe en 2 lineas, "..." (entero en la hoja de detalle movil) */
  .prod-ficha-desc {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    max-width: 34rem;
    font-size: clamp(0.875rem, 2.2dvh, 1.0625rem);
    line-height: 1.35;
    color: var(--color-tinta-suave);
    text-wrap: pretty;
  }
  .prod-ficha-desc[hidden] {
    display: none;
  }
  .prod-chip-grande {
    display: inline-block;
    line-height: 1.35;
    padding: 0.1875rem 1rem;
    font-size: clamp(1rem, min(1.4vw, 2.6dvh), 1.375rem);
    box-shadow: 0 4px 12px -6px rgb(217 158 15 / 0.7);
  }
  /* Etiqueta en mayusculas (tinta 800), encima del valor */
  .prod-ficha-datos dt,
  .prod-ficha-para dt,
  .prod-ficha-etiqueta {
    margin-bottom: 0.125rem;
    font-size: var(--text-etiqueta);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-tinta);
  }
  /* Marca | Presentacion en dos columnas iguales; si falta una, la otra
     ocupa el ancho (data-pares="1", lo pone catalogo.ts) */
  .prod-ficha-datos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ficha-hueco) clamp(0.75rem, 1.5vw, 1.25rem);
  }
  .prod-ficha-datos[data-pares='1'] {
    grid-template-columns: minmax(0, 1fr);
  }
  .prod-ficha-datos[data-pares='0'],
  .prod-ficha-datos > div[hidden] {
    display: none;
  }
  .prod-ficha-datos dd {
    color: var(--color-tinta-suave);
    font-size: clamp(0.9375rem, 2.5dvh, 1.125rem);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .prod-ficha-para[hidden],
  .prod-ficha-proteina[hidden] {
    display: none;
  }
  /* "Para": etiqueta a la izquierda de las pastillas (como la maqueta) */
  .prod-ficha-para:not([hidden]) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .prod-ficha-para dt {
    flex: none;
    margin-bottom: 0;
  }
  .prod-ficha-para dd {
    min-width: 0;
    flex: 1 1 auto;
  }
  .prod-ficha-animales {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 0.5rem;
  }
  .prod-ficha-animales li {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    /* Blanco con filete hoja (bloque 23b): sobre el desvanecido verde la
       pastilla hoja-claro se perdia. Bosque sobre blanco 9.80 */
    border: 1px solid rgb(123 191 58 / 0.55);
    border-radius: var(--radius-chip);
    background: var(--color-blanco);
    padding: 0.125rem 0.875rem 0.125rem 0.5rem;
    font-size: var(--text-chico);
    font-weight: 800;
    color: var(--color-bosque);
  }
  .prod-ficha-animales li :global(svg) {
    color: var(--color-bosque);
  }
  .prod-ficha-animales li[hidden] {
    display: none;
  }
  /* Tilapero: 6 pastillas en 2 filas de 3 */
  .prod-ficha-etapas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.375rem;
  }
  /* Cada etapa en dos lineas (nombre y cifra): en una sola no cabian
     "Crecimiento 32 %" y vecinas en la columna de ~370 px */
  .prod-ficha-etapas li {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    border-radius: 0.625rem;
    background: var(--color-crema-oscuro);
    padding: 0.0625rem 0.25rem;
    font-size: var(--text-chico);
    line-height: 1.15;
    color: var(--color-tinta);
    text-align: center;
  }
  .prod-ficha-etapas li > span:first-child {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .prod-ficha-cifra {
    font-weight: 800;
    white-space: nowrap;
  }

  /* ---------- Pie: compra (1A) + "Como llegar" en pildora (bloque 24) ----------
     Frase tinta sobre la salvia del fondo (8.01; 7.40 sobre las hojas,
     bloque 27). La pildora es un enlace con forma de
     boton: bosque con texto blanco (9.80), pin maiz (decorativo, 5.44) y
     flecha que se desplaza 4 px al pasar el raton; el texto se subraya con
     un trazo blanco que crece. Hover y foco: bosque-noche (blanco 14.38)
     y, con raton, se eleva 1 px. Foco: anillo bosque por fuera (5.50
     sobre la salvia). Alto 44 px en todas las anchuras. */
  .prod-pie {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.375rem;
  }
  .prod-compra {
    color: var(--color-tinta);
    font-size: var(--text-chico);
    line-height: var(--text-chico--line-height);
  }
  .prod-llegar {
    display: inline-flex;
    min-height: var(--spacing-objetivo);
    align-items: center;
    gap: 0.5rem;
    border-radius: var(--radius-boton);
    background: var(--color-bosque);
    padding: 0.5rem 1.125rem 0.5rem 0.875rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-blanco);
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 6px 16px -8px rgb(20 48 29 / 0.55);
  }
  .prod-llegar :global(svg) {
    flex: none;
  }
  .prod-llegar :global(.prod-llegar-pin) {
    color: var(--color-maiz);
  }
  .prod-llegar-texto {
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0% 2px;
    padding-bottom: 1px;
  }
  .prod-llegar:hover,
  .prod-llegar:focus-visible {
    background-color: var(--color-bosque-noche);
  }
  .prod-llegar:focus-visible {
    outline: 3px solid var(--color-foco);
    outline-offset: 3px;
  }
  .prod-llegar:active {
    transform: scale(0.97);
  }
  @media (hover: hover) {
    .prod-llegar:hover {
      transform: translateY(-1px);
      box-shadow: 0 10px 22px -10px rgb(20 48 29 / 0.6);
    }
  }
  .prod-llegar:hover .prod-llegar-texto,
  .prod-llegar:focus-visible .prod-llegar-texto {
    background-size: 100% 2px;
  }
  .prod-llegar:hover :global(.prod-llegar-flecha),
  .prod-llegar:focus-visible :global(.prod-llegar-flecha) {
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-movimiento='pausado'])) .prod-llegar {
      transition:
        background-color var(--duracion-hover) ease,
        box-shadow var(--duracion-hover) ease,
        transform var(--duracion-presion) ease-out;
    }
    :global(html:not([data-movimiento='pausado'])) .prod-llegar-texto {
      transition: background-size 220ms var(--ease-vista);
    }
    :global(html:not([data-movimiento='pausado'])) .prod-llegar :global(.prod-llegar-flecha) {
      transition: transform 220ms var(--ease-vista);
    }
  }
  @media (forced-colors: active) {
    .prod-llegar {
      border: 2px solid ButtonText;
    }
  }

  /* ---------- Tarjeta: Detalle / Lista (2A, bloque 20; crema desde el 23) ----------
     Un solo cuadro crema (>= 48rem). Arriba, la franja sin fondo propio:
     a la derecha el selector segmentado "Detalle | Lista (N)" y, en Lista,
     "Categoria · N" (o el filtro) a la izquierda. En movil no hay
     selector: la franja solo aparece con "Resultados para «…»", sobre
     crema-oscuro. */
  .prod-panel {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
  }
  .prod-marca-agua {
    display: none;
  }
  .prod-panel-cuerpo {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }
  .prod-franja {
    display: none;
    align-items: center;
    gap: 0.5rem 0.75rem;
    border-radius: var(--radius-panel) var(--radius-panel) 0 0;
    background: var(--color-crema-oscuro);
    padding: 0.5rem 0.75rem 0.5rem 1rem;
  }
  .prod-panel[data-modo-lista='busqueda'] .prod-franja {
    display: flex;
  }
  .prod-franja-titulo,
  .prod-filtro {
    min-width: 0;
    flex: 1 1 auto;
    font-size: var(--text-etiqueta);
    font-weight: 800;
    line-height: 1.3;
    color: var(--color-tinta); /* 11.27 crema-oscuro, 12.67 crema */
  }
  /* Una sola linea; si no cabe, "..." (el nombre completo lo dicen la
     pestana de categoria y el rotulo del carrusel) */
  .prod-franja-titulo {
    display: none;
    overflow: hidden;
    color: var(--color-bosque); /* 8.69 sobre crema */
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .prod-franja-titulo [data-franja-total],
  .prod-franja-titulo [aria-hidden='true'] {
    color: var(--color-tinta-suave); /* 6.78 */
  }
  .prod-filtro {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
  }
  .prod-filtro[hidden] {
    display: none;
  }
  .prod-franja-titulo:focus-visible,
  .prod-filtro:focus-visible {
    outline-offset: 2px;
  }
  .prod-quitar-filtro {
    min-height: 1.5rem;
    font-weight: 800;
    color: var(--color-bosque); /* 7.73 crema-oscuro, 8.69 crema */
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* Selector segmentado Detalle | Lista (N) en claro: carril crema-oscuro
     con borde kraft, pastilla bosque con texto crema en la activa (8.69),
     texto bosque en la inactiva (7.73 sobre crema-oscuro). La pastilla es
     un elemento propio ([data-pastilla-panel]) que se coloca con
     --pastilla-x (0 % Detalle, 100 % Lista); la anima
     animacion-interaccion. Las dos opciones miden lo mismo (1fr 1fr). */
  .prod-selector {
    position: relative;
    display: none;
    flex: none;
    margin-left: auto;
    border: 1px solid var(--color-kraft);
    border-radius: var(--radius-chip);
    background: var(--color-crema-oscuro);
    padding: 3px;
  }
  .prod-selector-opciones {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .prod-selector-pastilla {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 3px;
    width: calc((100% - 6px) / 2);
    border-radius: var(--radius-chip);
    background: var(--color-bosque);
    box-shadow: 0 2px 6px -2px rgb(20 48 29 / 0.45);
    transform: translateX(var(--pastilla-x, 0%));
    /* Sin movimiento, salto seco (no la transicion de 0,01 ms de
       global.css, que Chrome resuelve 2-3 fotogramas tarde); la de 240 ms
       esta en la media query >= 48rem */
    transition-property: none;
  }
  .prod-panel[data-pestana='lista'] .prod-selector-pastilla {
    --pastilla-x: 100%;
  }
  .prod-selector-opcion {
    min-width: 4.5rem;
    min-height: 1.875rem;
    border-radius: var(--radius-chip);
    padding: 0.125rem 0.75rem;
    font-size: var(--text-etiqueta);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-bosque); /* 7.73 sobre crema-oscuro */
    white-space: nowrap;
  }
  .prod-selector-opcion[aria-selected='false']:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prod-selector-opcion[aria-selected='true'] {
    color: var(--color-crema); /* 8.69 sobre bosque */
  }
  .prod-selector-opcion:focus-visible {
    outline-offset: 1px;
  }
  @media (forced-colors: active) {
    .prod-selector-pastilla {
      display: none;
    }
    .prod-selector-opcion[aria-selected='true'] {
      outline: 2px solid Highlight;
    }
  }

  /* ---------- Lista (pestana Lista; movil bajo el carrusel; sin JS en la
     columna derecha) ----------
     Panel hoja-claro: tinta 12.56, bosque 8.62, tinta-suave 6.72,
     marca-fuerte 4.73. Cabeceras de grupo kraft. */
  .prod-lista-panel {
    min-width: 0;
    /* clip (no hidden): recorta la cabecera kraft a las esquinas sin crear
       contenedor de scroll, asi la cabecera pegajosa sigue funcionando */
    overflow: clip;
    border-radius: var(--radius-panel);
    background: var(--color-hoja-claro);
    padding: 0 0.5rem 0.5rem;
    color: var(--color-tinta);
  }
  /* Cabecera de grupo: banda kraft de 36 px a sangre del panel (sustituye
     al subrayado hoja de 3 px). Nombre bosque 800 (6.41 sobre kraft),
     recuento tinta-suave (5.00). */
  .prod-grupo-titulo {
    position: sticky;
    top: var(--alto-buscador, 0);
    z-index: 1;
    display: flex;
    min-height: 2.25rem;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.375rem;
    margin: 0 -0.5rem 0.25rem;
    background: var(--color-kraft);
    padding: 0.375rem 1rem;
    font-family: var(--font-sans);
    font-size: var(--text-etiqueta);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-bosque);
  }
  .prod-grupo-titulo [data-grupo-conteo],
  .prod-grupo-titulo [aria-hidden='true'] {
    color: var(--color-tinta-suave);
  }
  .prod-grupo + .prod-grupo {
    margin-top: 0.5rem;
  }
  .prod-grupo[hidden],
  [data-producto-fila][hidden] {
    display: none;
  }
  .prod-fila {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 3.5rem;
    border-left: 4px solid transparent;
    border-radius: 0.5rem;
    padding: 0.375rem 0.5rem;
    text-align: left;
  }
  .prod-fila:hover {
    background: var(--color-crema);
  }
  /* Fila activa (C4): aria-current lo pone catalogo.ts en el acto; el
     resaltado VISUAL va en data-resaltada, que llega al asentarse el anillo
     (o en el acto si se toco la fila). Fondo por capa (opacidad) y barra
     bosque de 4 px que crece con scaleY; nombre 800. */
  .prod-fila::before,
  .prod-fila::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }
  .prod-fila::before {
    top: 0;
    bottom: 0;
    left: -4px;
    width: 4px;
    border-radius: 4px 0 0 4px;
    background: var(--color-bosque);
    transform: scaleY(0);
  }
  .prod-fila::after {
    inset: 0 0 0 -4px;
    z-index: -1;
    border-radius: inherit;
    background: var(--color-fila-activa-panel); /* blanco sobre el panel hoja-claro: tinta 14.28 */
    opacity: 0;
  }
  .prod-fila[data-resaltada]::before {
    transform: scaleY(1);
  }
  .prod-fila[data-resaltada]::after {
    opacity: 1;
  }
  .prod-fila[data-resaltada] .prod-fila-nombre {
    font-weight: 800;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-movimiento='pausado'])) .prod-fila::before {
      transition: transform 150ms var(--ease-salida);
    }
    :global(html:not([data-movimiento='pausado'])) .prod-fila[data-resaltada]::before {
      transition: transform 250ms var(--ease-vista);
    }
    :global(html:not([data-movimiento='pausado'])) .prod-fila::after {
      transition: opacity 200ms var(--ease-vista);
    }
  }
  @media (forced-colors: active) {
    .prod-fila[data-resaltada] {
      border-left-color: Highlight;
    }
  }
  .prod-mini {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: var(--radius-miniatura);
    background: var(--color-crema);
  }
  .prod-mini img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .prod-mini-placa img {
    object-fit: cover;
  }
  .prod-fila-texto {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }
  .prod-fila-nombre {
    color: var(--color-tinta);
    line-height: 1.25;
  }
  .prod-fila-detalle {
    font-size: var(--text-chico);
    line-height: var(--text-chico--line-height);
    color: var(--color-tinta-suave);
  }
  .prod-fila-precio {
    font-weight: 800;
    color: var(--color-bosque);
    white-space: nowrap;
    text-align: right;
  }
  .prod-tabla {
    margin: 0.25rem 0 0.75rem 3.75rem;
    font-size: var(--text-chico);
    color: var(--color-tinta);
    border-collapse: collapse;
  }
  .prod-tabla caption {
    text-align: left;
    font-weight: 800;
    color: var(--color-tinta-suave);
    padding-bottom: 0.25rem;
  }
  .prod-tabla th,
  .prod-tabla td {
    padding: 0.125rem 0.75rem 0.125rem 0;
    text-align: left;
    font-weight: 400;
  }
  .prod-tabla thead th {
    font-weight: 800;
  }
  /* Con JS (bloque 19, 2A): filas de una linea (miniatura 40 px, nombre
     con elipsis, precio) y sin la tabla de la tilapia, que esta en la
     ficha. Sin JS la lista conserva marca, presentacion y la tabla. */
  :global(html.js) .prod-fila {
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    min-height: 3rem;
    padding-block: 0.25rem;
  }
  :global(html.js) .prod-mini {
    width: 2.5rem;
    height: 2.5rem;
  }
  :global(html.js) .prod-fila-nombre {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(html.js) .prod-fila-detalle,
  :global(html.js) .prod-tabla-lista {
    display: none;
  }
  .prod-vacio {
    padding: 1.25rem 0.5rem;
    color: var(--color-tinta);
  }
  .prod-vacio[hidden] {
    display: none;
  }
  .prod-vacio-titulo {
    font-weight: 800;
  }
  /* Sin resultados: las 4 categorias como atajos (botones secundarios) */
  .prod-atajos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .prod-atajo {
    width: 100%;
    min-height: var(--spacing-objetivo);
    border: 2px solid var(--color-bosque);
    border-radius: var(--radius-boton);
    background: var(--color-blanco);
    padding: 0.375rem 0.75rem;
    font-weight: 800;
    color: var(--color-bosque);
  }
  .prod-atajo:hover {
    background: var(--color-bosque);
    color: var(--color-blanco);
  }
  .prod-grupo-titulo:focus-visible {
    outline-offset: -3px;
  }
  .prod-mini-costal {
    background: var(--color-kraft);
    color: var(--color-canela-oscuro);
  }
  /* "Ver detalle" (movil): abre la hoja de detalle del producto al frente */
  .prod-ver-detalle {
    display: inline-flex;
    min-height: var(--spacing-objetivo);
    align-items: center;
    justify-content: center;
    margin-top: 0.375rem;
    border: 2px solid var(--color-bosque);
    border-radius: var(--radius-boton);
    padding: 0.25rem 1rem;
    font-weight: 800;
    color: var(--color-bosque);
  }

  /* ---------- Movil: la vista entera hace scroll interno ---------- */
  @media (max-width: 47.999rem) {
    /* El tamano del carrusel en movil NO se agranda (bloque 23, probado):
       con 8rem (128 px) la tarjeta provisional de M5 (variante de 400 px
       de alto) se muestra por encima de su tamano natural a DPR 2,6, Chrome
       recorta su area de LCP y el frente del anillo (variante de 800 px)
       pasa a ser el LCP: 3,9 s y Lighthouse 72-88. Sigue el token (116 px). */
    .prod-escena {
      height: 15rem;
    }
    /* Con "Resultados para «…»" la franja va pegada encima de la lista */
    .prod-panel[data-modo-lista='busqueda'] .prod-lista-panel {
      border-top-left-radius: 0;
      border-top-right-radius: 0;
    }
    .prod-quitar-filtro {
      min-height: var(--spacing-objetivo);
    }
    /* P9: flechas fuera del escenario, a los lados del rotulo (junto a la
       linea de categoria y posicion) para no tapar los renders */
    .prod-flecha-izq {
      grid-area: 2 / 1;
      align-self: end;
    }
    .prod-flecha-der {
      grid-area: 2 / 3;
      align-self: end;
    }
    .prod-rotulo {
      grid-area: 2 / 2;
    }
    /* C3: el nombre reserva dos lineas para que el rotulo no salte */
    .prod-rotulo-nombre {
      min-height: 2.4em;
      min-height: 2lh;
    }
    /* En movil el buscador va justo despues de la cabecera: entra con el
       carrusel (orden 1), no despues de el */
    .prod-buscador[data-entra] {
      --orden: 1 !important;
    }
    /* Que quepa el ejemplo del placeholder a 360 px: sin el hueco del boton
       de borrar mientras el campo esta vacio */
    .prod-campo input:placeholder-shown {
      padding-right: 0.5rem;
    }
    /* "Como llegar" a todo el ancho, centrado */
    .prod-llegar {
      align-self: stretch;
      justify-content: center;
    }
  }

  /* ---------- Tableta (48-64rem): carrusel 60 % | buscador, tarjeta y pie 40 % ----------
     Desde 64rem, tres columnas (mas abajo). */
  @media (min-width: 48rem) {
    :global(html[data-router] .productos-cuerpo) {
      overflow: hidden;
    }
    .prod-marco {
      flex: 1 1 auto;
      min-height: 0;
      grid-template-columns: minmax(0, 60fr) minmax(0, 40fr);
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      gap: 0.75rem clamp(1.5rem, 3vw, 3rem);
      padding-inline: var(--spacing-vista);
    }
    :global(html[data-router]) .prod-marco {
      height: 100%;
    }
    .prod-cabecera {
      grid-area: 1 / 1;
      align-self: end;
    }
    .prod-categorias {
      grid-area: 2 / 1;
    }
    .prod-carrusel {
      grid-area: 3 / 1 / 5 / 2;
      min-height: 0;
    }
    /* El campo queda a la altura de las pestanas */
    .prod-buscador {
      grid-area: 1 / 2 / 3 / 3;
      align-self: end;
    }
    .prod-resultado {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
    }
    /* Tarjeta (2A, bloque 20; crema desde el 23): un solo cuadro con la
       franja arriba y, debajo, la ficha o la lista en la MISMA celda (los
       dos con grid-area 1 / 1), asi cambiar de pestana no cambia el
       tamano. El margen deja sitio a "N productos encontrados · Ver los
       N", que cuelga del buscador. */
    .prod-panel {
      grid-area: 3 / 2;
      min-height: 0;
      margin-top: 1.25rem;
    }
    :global(html.js) .prod-panel {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr);
      overflow: clip;
      isolation: isolate;
      border: 1px solid var(--color-kraft); /* decorativo (no es control) */
      border-radius: var(--radius-tarjeta-grande);
      /* Crema que se aclara hacia arriba (solo aclara: los contrastes
         calculados sobre crema son el peor caso) */
      /* Desvanecido verde (bloque 23b): de abajo arriba, hoja al 22 %
         (sobre crema: tinta 10.94, bosque 7.50, tinta-suave 5.85) que se
         funde en hoja-claro y se pierde hacia la mitad; arriba, el crema
         aclarado. Calculos en marca-hinojosa 5. */
      background:
        radial-gradient(120% 70% at 0% 0%, rgb(255 255 255 / 0.55), transparent 70%),
        linear-gradient(0deg, rgb(123 191 58 / 0.22) 0%, rgb(234 244 220 / 0.9) 40%, rgb(234 244 220 / 0) 72%),
        var(--color-crema);
      box-shadow: var(--shadow-tarjeta);
    }
    /* Marca de agua: hojas (trazo hoja, arriba a la derecha) y huellas
       (kraft, abajo a la derecha). Debajo del contenido. */
    :global(html.js) .prod-marca-agua {
      position: absolute;
      z-index: 0;
      display: block;
      pointer-events: none;
    }
    .prod-marca-hojas {
      top: 2.5rem;
      right: -0.5rem;
      width: clamp(6rem, 36%, 9rem);
      height: auto;
      color: var(--color-hoja);
      opacity: 0.4;
    }
    /* En Lista, las hojas casi desaparecen: no compiten con los precios */
    .prod-panel[data-pestana='lista'] .prod-marca-hojas {
      opacity: 0.14;
    }
    .prod-marca-huellas {
      right: 0.75rem;
      bottom: 0.75rem;
      width: clamp(5rem, 30%, 7.5rem);
      height: auto;
      /* Sobre el desvanecido verde: huellas verde oscuro muy tenues */
      color: var(--color-bosque);
      opacity: 0.1;
    }
    .prod-franja,
    .prod-panel-cuerpo {
      position: relative;
      z-index: 1;
    }
    .prod-franja {
      display: flex;
      min-height: 2.5rem;
      border-radius: 0;
      background: transparent;
      padding: clamp(0.375rem, 1.2dvh, 0.75rem) clamp(0.5rem, 1dvh, 0.75rem) clamp(0.125rem, 0.6dvh, 0.375rem) clamp(1.25rem, 2vw, 1.75rem);
    }
    .prod-selector {
      display: block;
    }
    /* En Detalle la franja no lleva titulo; en Lista, la categoria o el filtro */
    .prod-panel[data-pestana='lista'][data-modo-lista='categoria'] .prod-franja-titulo {
      display: block;
    }
    .prod-panel[data-pestana='detalle'] .prod-filtro {
      display: none;
    }
    :global(html.js) .prod-panel-cuerpo {
      display: grid;
      min-height: 0;
      grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    }
    :global(html.js) .prod-panel-cuerpo > * {
      grid-area: 1 / 1;
      min-height: 0;
    }
    .prod-ficha {
      --ficha-hueco: clamp(0.5rem, 1.6dvh, 1rem);
      display: flex;
      flex-direction: column;
      /* Sin scroll a 1440x900, 1366x650 y >= 600 px de alto con >= 1280 de
         ancho (prueba 23). auto es solo la red de seguridad para pantallas
         estrechas y bajas a la vez (p. ej. 1024x600 con el tilapero):
         mejor desplazar que recortar; el tabpanel es enfocable. */
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: clamp(0.25rem, 1dvh, 0.75rem) clamp(1.25rem, 2vw, 1.75rem) clamp(0.75rem, 2.4dvh, 1.75rem);
      /* Esquinas de abajo del cuadro: el anillo de foco las sigue */
      border-radius: 0 0 var(--radius-tarjeta-grande) var(--radius-tarjeta-grande);
    }
    .prod-ficha:focus-visible {
      outline-offset: -4px;
    }
    :global(html.js) .prod-lista-panel {
      overflow-y: auto;
      overscroll-behavior: contain;
      border-radius: 0 0 var(--radius-tarjeta-grande) var(--radius-tarjeta-grande);
      /* En claro, sobre el crema de la tarjeta: tinta 12.67, bosque 8.69,
         tinta-suave 6.78, marca-fuerte 4.77; fila activa blanca (14.28) */
      background: transparent;
    }
    :global(html.js) .prod-fila:hover {
      background: var(--color-crema-oscuro); /* tinta 11.27 */
    }
    /* En categoria la cabecera kraft del grupo repite la franja: fuera */
    :global(html.js) .prod-panel[data-modo-lista='categoria'] .prod-grupo-titulo {
      display: none;
    }
    :global(html.js) .prod-panel[data-modo-lista='categoria'] .prod-lista-panel {
      padding-top: 0.25rem;
    }
    /* Panel inactivo fuera; con data-cruzando (transicion) se ven los dos */
    .prod-panel:not([data-cruzando])[data-pestana='lista'] .prod-ficha,
    :global(html.js) .prod-panel:not([data-cruzando])[data-pestana='detalle'] .prod-lista-panel {
      display: none;
    }
    /* Transicion (bloque 20, catalogo.ts cruzarPaneles): la entrante por
       encima; la saliente no recibe el puntero mientras se funde */
    .prod-panel[data-cruzando][data-pestana='detalle'] .prod-ficha,
    .prod-panel[data-cruzando][data-pestana='lista'] .prod-lista-panel {
      z-index: 1;
    }
    .prod-panel[data-cruzando][data-pestana='lista'] .prod-ficha,
    .prod-panel[data-cruzando][data-pestana='detalle'] .prod-lista-panel {
      pointer-events: none;
    }
    /* Pastilla del selector: se desliza 240 ms; con reduced motion o la
       pausa del sitio, salta (la pausa no anula transition en global.css) */
    @media (prefers-reduced-motion: no-preference) {
      :global(html:not([data-movimiento='pausado'])) .prod-selector-pastilla {
        transition: transform 240ms var(--ease-vista);
      }
      /* El color del rotulo cambia de golpe cuando la pastilla ya cubre
         media opcion (~60 ms con ease-vista), como el texto activo de la
         barra: asi no hay crema sobre crema ni bosque sobre bosque */
      :global(html:not([data-movimiento='pausado'])) .prod-selector-opcion {
        transition: color 0s linear 60ms;
      }
    }
    .prod-pie {
      grid-area: 4 / 2;
      padding-bottom: 0.25rem;
    }
    /* Pantallas bajas (1366x650): menos aire bajo el pie, para que la
       ficha quepa sin scroll (bloque 20: el tilapero necesita ~290 px) */
    @media (max-height: 47.5rem) {
      .prod-marco {
        padding-bottom: 1.25rem;
      }
      /* Bloque 23b (descripcion en la ficha): huecos y nombre algo menores */
      .prod-ficha {
        --ficha-hueco: clamp(0.3125rem, 0.9dvh, 0.625rem);
        padding-bottom: clamp(0.5rem, 1.4dvh, 1rem);
      }
      .prod-ficha-nombre {
        font-size: clamp(1.375rem, min(2.45vw, 4dvh), 2.625rem);
      }
      .prod-franja {
        padding-top: 0.25rem;
        padding-bottom: 0;
      }
    }
    /* Muy bajas (alto 600-640 px): menos aire arriba y entre bloques */
    @media (max-height: 40rem) {
      .prod-marco {
        padding-top: 1.5rem;
      }
      .prod-ficha {
        --ficha-hueco: 0.3125rem;
      }
    }
    /* La ficha ya dice nombre y precio: bajo el anillo queda solo la meta
       (categoria y posicion) */
    .prod-rotulo-nombre,
    .prod-rotulo-meta .prod-chip,
    .prod-ver-detalle {
      display: none;
    }
    /* Sin JS: la lista (4 grupos) ocupa la columna derecha, como antes */
    :global(html:not(.js)) .prod-panel {
      grid-area: 1 / 2 / 4 / 3;
      margin-top: 0;
    }
    /* Miniaturas de 48 px y filas de 64 px (P10); con JS las anula la
       fila de una linea (40 px, mas arriba) */
    .prod-fila {
      grid-template-columns: 3rem minmax(0, 1fr) auto;
      min-height: 4rem;
    }
    .prod-mini {
      width: 3rem;
      height: 3rem;
    }
    .prod-tabla {
      margin-left: 4.25rem;
    }
    .prod-atajos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .prod-escenario {
      flex: 1 1 auto;
      min-height: 0;
    }
    .prod-escena {
      min-height: 0;
    }
    /* Sin anillo 3D, la rejilla de respaldo va entre las flechas */
    .prod-escenario:not([data-modo='3d']) .prod-escena {
      grid-column: 2;
    }
    .prod-rejilla {
      grid-template-columns: repeat(auto-fill, minmax(clamp(5rem, 8vw, 7.5rem), 1fr));
      gap: 0.75rem;
    }
    .prod-flecha {
      width: 3.25rem;
      height: 3.25rem;
    }
  }

  /* ---------- Escritorio (>= 64rem, bloque 23b, 2026-10-17 noche) ----------
     Dos columnas: el carrusel ocupa la izquierda y el centro (68 %) con el
     titulo y las categorias en fila encima; la derecha (32 %) lleva el
     buscador arriba, la tarjeta (Detalle | Lista) y, al pie, la compra con
     "Como llegar". Mismas areas que la tableta (48-64rem, mas arriba); aqui
     cambian las proporciones y el tamano del anillo. La tarjeta va por
     encima del anillo en el apilado: el anillo puede asomar por el hueco
     entre columnas, nunca bajo texto. */
  @media (min-width: 64rem) {
    .prod-marco {
      --hueco-col: clamp(1.25rem, 2.2vw, 2.5rem);
      max-width: 100rem;
      grid-template-columns: minmax(0, 68fr) minmax(0, 32fr);
      gap: clamp(0.5rem, 1.6dvh, 1rem) var(--hueco-col);
      padding-block: clamp(0.75rem, 2.6dvh, 1.75rem) clamp(0.75rem, 2.4dvh, 1.5rem);
    }
    .prod-buscador,
    .prod-categorias,
    .prod-pie,
    .prod-panel {
      position: relative;
      z-index: 2;
    }
    .prod-buscador {
      z-index: 3;
    }
    .prod-cabecera :global(.titulo-vista) {
      font-size: clamp(1.625rem, min(2.4vw, 4.6dvh), 2.5rem);
    }
    /* Las 4 categorias en fila, con el recuento, sin estirarse de mas */
    .prod-categorias {
      max-width: 46rem;
    }
    .prod-pestana {
      min-height: clamp(2.5rem, 5.4dvh, 2.875rem);
      padding-inline: 0.875rem;
    }
    .prod-cuenta {
      font-variant-numeric: tabular-nums;
    }
    .prod-carrusel {
      z-index: 1;
    }
    /* El buscador solo en la fila del titulo; la tarjeta sube a la fila de
       las categorias (gana ~50 px de alto para la ficha sin scroll) */
    .prod-buscador {
      grid-area: 1 / 2;
    }
    :global(html.js) .prod-panel {
      grid-area: 2 / 2 / 4 / 3;
      max-height: 38rem;
    }
    /* Sin JS: la lista completa (4 grupos) ocupa la columna derecha y la
       compra va debajo de ella, sin tope de alto */
    :global(html:not(.js)) .prod-pie {
      grid-area: 5 / 2;
    }
    /* Producto al frente (bloque 23b): el ancho del anillo sale del
       espacio real del escenario (consulta de contenedor de tamano), asi el
       frente crece cuanto puede sin tapar las categorias de arriba ni el
       rotulo de abajo a 1440x900, 1366x650 y 1024x768. Lo heredan el
       anillo (.anillo-item), la tarjeta provisional de M5 (.prod-frente) y
       carrusel.ts (mide el ancho real del item). 53cqh - 2.75rem: lo que
       cabe del frente (3:4 x --escala-frente) en la escena (escenario menos
       el rotulo) con la linea de suelo a 1.5rem. Tope 16rem (a 1x, la
       variante de 400 px se amplia como mucho un 20 %; ver SIZES_ANILLO en
       src/lib/srcset-producto.ts, que declara 18rem). */
    .prod-escenario {
      container-type: size;
      --carrusel-ancho: clamp(10rem, min(calc(53cqh - 2.75rem), 30cqw), 16rem);
      --carrusel-perspectiva: 1100px;
    }
    .prod-escenario[data-modo='3d'] .prod-escena {
      margin-inline: calc(var(--hueco-col) * -1);
    }
    .prod-rotulo {
      padding-bottom: 0.25rem;
    }
    /* Compra en una fila: la frase a la izquierda y la pildora a la derecha */
    .prod-pie {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }
    .prod-compra {
      max-width: 15rem;
    }
    .prod-llegar {
      flex: none;
    }
  }
  /* Columna derecha estrecha (64-80rem, p. ej. 1024 px): huecos de la
     ficha menores para que el tilapero quepa con su descripcion */
  @media (min-width: 64rem) and (max-width: 79.999rem) {
    .prod-ficha {
      --ficha-hueco: clamp(0.3125rem, 1dvh, 0.625rem);
    }
  }

  /* Tarjeta ancha (>= 24rem, p. ej. 1366 px): cada etapa del tilapero en
     una sola linea ("Alevin 45 %"); asi la ficha con descripcion cabe sin
     scroll a 1366x650 (bloque 23b) */
  @container tarjeta (min-width: 24rem) {
    /* Columnas al ancho de su contenido (la de "Crecimiento" es la mas
       ancha): ninguna etiqueta se corta con "..." */
    .prod-ficha-etapas {
      grid-template-columns: repeat(3, auto);
    }
    .prod-ficha-etapas li {
      flex-direction: row;
      justify-content: center;
      gap: 0.3em;
      padding-block: 0.1875rem;
      white-space: nowrap;
    }
  }

  /* Tarjeta estrecha (p. ej. 1024 px de ancho: ~270 px): la franja pone
     el selector arriba y "Categoria · N" debajo, y en la Lista el precio
     pasa bajo el nombre para que ninguno se corte. Consulta de contenedor
     sobre la propia tarjeta (.prod-panel, >= 48rem con JS). */
  @media (min-width: 48rem) {
    :global(html.js) .prod-panel {
      container: tarjeta / inline-size;
    }
  }
  @container tarjeta (max-width: 22rem) {
    .prod-franja {
      flex-wrap: wrap;
      row-gap: 0.25rem;
    }
    .prod-franja-titulo,
    .prod-filtro {
      order: 2;
      flex-basis: 100%;
    }
    :global(html.js) .prod-fila {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      grid-template-rows: auto auto;
      row-gap: 0;
    }
    :global(html.js) .prod-mini {
      grid-row: 1 / 3;
    }
    .prod-fila-precio {
      grid-column: 2;
      text-align: left;
      font-size: var(--text-chico);
    }
    .prod-ficha-datos {
      grid-template-columns: minmax(0, 1fr);
    }
    /* Etapas en 3 columnas con letra algo menor (cabe "Crecimiento") */
    .prod-ficha-etapas li {
      font-size: 0.8125rem;
    }
    /* La descripcion admite una linea mas en la tarjeta estrecha */
    .prod-ficha-desc {
      -webkit-line-clamp: 4;
      line-clamp: 4;
      font-size: 0.9375rem;
    }
  }

  /* Realce del producto al frente (bloque 23, PLAN 0-C "Producto
     seleccionado"):
       --escala-frente  escala de la tarjeta al frente respecto al resto del
                        anillo. carrusel.ts la lee de aqui y la escribe con
                        la propiedad `scale` en cada .anillo-tarjeta,
                        interpolada por la distancia al frente (el frente que
                        sale encoge mientras el que entra crece, sin salto al
                        cambiar data-frente). La tarjeta provisional de M5
                        lleva la misma escala para seguir identica debajo.
     El sombreado de anterior/siguiente y del resto (tinta, opacidad,
     saturacion) lo pinta carrusel.ts con los tokens --carrusel-*. */
  .prod-escenario {
    --escala-frente: 1.15;
  }
  @media (min-width: 48rem) {
    .prod-escenario {
      --escala-frente: 1.3;
    }
  }
  /* Bloque 23b: un poco mas grande con el carrusel a dos tercios */
  @media (min-width: 64rem) {
    .prod-escenario {
      --escala-frente: 1.4;
    }
  }
  .prod-frente-tarjeta {
    scale: var(--escala-frente);
    transform-origin: 50% 100%;
  }

  /* Tiempo local de C6 (no hay token en tokens.css) */
  .prod-categorias,
  .prod-carrusel {
    --duracion-pestana: 180ms;
  }
</style>

<!-- Carrusel CSS 3D (src/lib/animacion/carrusel.ts). El JS crea el anillo,
     asi que estas reglas son globales (sin el atributo de ambito de Astro). -->
<style is:global>
  /* La escena (fila 1 del carrusel, de borde a borde: el anillo pasa por
     debajo de las flechas) es la referencia del anillo; deja de recortar. */
  .prod-escenario[data-modo='3d'] .prod-escena {
    overflow: visible;
    padding: 0;
  }
  .anillo {
    /* Linea de suelo: el producto al frente queda algo por debajo del
       centro del escenario, sea cual sea su alto (2/3 = mitad de la tarjeta 3:4) */
    --anillo-base: max(0.75rem, calc(46% - var(--carrusel-ancho) * 0.667));
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    cursor: grab;
    touch-action: pan-y; /* el gesto vertical sigue desplazando la vista en movil */
    -webkit-user-select: none;
    user-select: none;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .anillo.arrastrando {
    cursor: grabbing;
  }
  .anillo-escena {
    position: absolute;
    inset: 0;
    perspective: var(--carrusel-perspectiva);
    perspective-origin: 50% var(--carrusel-origen-y);
    transform-origin: 50% 70%;
  }
  .anillo-tarima {
    position: absolute;
    left: 50%;
    bottom: var(--anillo-base);
    /* Tarima kraft (guia 2.2): radial kraft -> transparente, filete canela
       oscuro al 35 %. Une los costales con la marca. */
    border: 1.5px solid var(--color-filete-canela);
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--color-kraft), transparent);
    pointer-events: none;
  }
  .anillo-item {
    position: absolute;
    left: 50%;
    bottom: var(--anillo-base);
    width: var(--carrusel-ancho);
    aspect-ratio: 3 / 4;
    margin-left: calc(var(--carrusel-ancho) / -2);
    will-change: transform, opacity;
  }
  .anillo-item:not([data-frente]) {
    cursor: pointer;
  }
  /* Realce del frente: carrusel.ts escribe `scale` (y `filter` en los que
     no estan al frente) en cada tarjeta, interpolado por la distancia al
     frente; crece desde la linea de suelo, como la provisional de M5 */
  .anillo-tarjeta {
    transform-origin: 50% 100%;
  }
  .anillo.arrastrando .anillo-item {
    cursor: grabbing;
  }
  .anillo-tarjeta {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: var(--radius-tarjeta);
  }
  /* Silueta 3:4 mientras llega la imagen, sin shimmer (capa propia para
     poder fundirla con la imagen, C1) */
  .anillo-tarjeta::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-silueta-carga);
    opacity: 0;
    pointer-events: none;
  }
  .anillo-tarjeta.cargando::before {
    opacity: 1;
  }
  .anillo-tarjeta.cargando img {
    opacity: 0;
  }
  .anillo-tarjeta picture,
  .anillo-tarjeta img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .anillo-tarjeta picture {
    position: relative; /* por encima de la silueta */
  }
  /* C1: la imagen que llega despues del primer montaje se funde en 200 ms
     (la clase .fundir no la lleva nunca el primer montaje: regla M5) */
  @media (prefers-reduced-motion: no-preference) {
    html:not([data-movimiento='pausado']) .anillo-tarjeta.fundir::before,
    html:not([data-movimiento='pausado']) .anillo-tarjeta.fundir img {
      transition: opacity 200ms var(--ease-vista);
    }
  }
  .anillo-tarjeta img {
    object-fit: contain;
    object-position: 50% 100%;
    pointer-events: none;
    -webkit-user-drag: none;
  }
  /* Modo placa: imagenes con fondo, como foto de producto */
  .anillo-placa {
    overflow: hidden;
    border: 1px solid var(--color-crema-oscuro);
    background: var(--color-blanco);
    box-shadow: var(--shadow-tarjeta);
  }
  .anillo-placa img {
    object-fit: cover;
    object-position: center;
  }
  /* Oscurecido por capa (no por filter): silueta del recorte con mask */
  .anillo-oscuro {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-tinta);
    opacity: 0;
    pointer-events: none;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-position: 50% 100%;
    mask-position: 50% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }
  .anillo-tarjeta:not(.anillo-placa):not(.listo) .anillo-oscuro {
    visibility: hidden;
  }
  .anillo-sombra {
    position: absolute;
    left: 15%;
    bottom: -6px;
    width: 70%;
    height: 12px;
    border-radius: 50%;
    background: var(--color-tinta);
    filter: blur(6px);
  }
  /* P5: costal generico al frente para productos sin foto, con el nombre
     en HTML encima de la etiqueta del dibujo (x 23-77 %, y 40-70 % del
     SVG de 200x260, que en la tarjeta 3:4 queda apoyado abajo) */
  .anillo-costal {
    container-type: inline-size;
  }
  .anillo-costal-nombre {
    position: absolute;
    top: 41.5%;
    left: 23%;
    right: 23%;
    height: 29.25%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 8.5cqi;
    line-height: 1.05;
    text-align: center;
    text-wrap: balance;
    overflow-wrap: anywhere;
    color: var(--color-bosque);
  }
  .anillo-sombra {
    transform-origin: 50% 50%;
  }
  .anillo-tarjeta.sin-imagen {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-crema-oscuro);
    padding: 0.75rem;
    text-align: center;
    font-weight: 800;
    font-size: var(--text-chico);
    color: var(--color-bosque);
  }
  /* Bloque 23b (>= 64rem): la linea de suelo baja lo que haga falta para
     que el frente realzado (3:4 x --escala-frente) no suba por encima de
     la escena, donde estan las categorias; nunca por debajo de 1.5rem.
     Mismo valor en el anillo y en la tarjeta provisional (regla M5). */
  @media (min-width: 64rem) {
    .prod-escenario .anillo,
    .prod-escenario .prod-escena > .prod-frente {
      --anillo-base: max(
        1.5rem,
        min(
          calc(46% - var(--carrusel-ancho) * 0.667),
          calc(100% - var(--carrusel-ancho) * 1.3333 * var(--escala-frente) - 0.75rem)
        )
      );
    }
  }
  .anillo-error {
    position: relative;
    z-index: var(--z-control);
    max-width: 22rem;
    margin-inline: auto;
    border-radius: var(--radius-tarjeta);
    background: var(--color-blanco);
    padding: 1rem;
    text-align: center;
    color: var(--color-tinta);
    box-shadow: var(--shadow-tarjeta);
  }
  .anillo-error[hidden] {
    display: none;
  }
  .anillo-reintentar {
    min-height: var(--spacing-objetivo);
    margin-top: 0.75rem;
    border: 2px solid var(--color-bosque);
    border-radius: var(--radius-boton);
    padding: 0.375rem 1.25rem;
    font-weight: 800;
    color: var(--color-bosque);
  }
  .anillo-reintentar:hover {
    background: var(--color-bosque);
    color: var(--color-blanco);
  }
</style>

<script>
  import '../../lib/catalogo';
