---
// Pagina unica con 5 vistas a pantalla completa (PLAN.md, secciones 3 y 4;
// contrato en la skill vistas-hinojosa). Las 5 vistas van SIEMPRE en el
// HTML servido (SEO); src/lib/router.ts muestra una y oculta las demas
// con hidden + inert. Sin JS se ven apiladas.
import Layout from '../layouts/Layout.astro';
import Barra from '../components/Barra.astro';
import VistaInicio from '../components/vistas/VistaInicio.astro';
import VistaNosotros from '../components/vistas/VistaNosotros.astro';
import VistaProductos from '../components/vistas/VistaProductos.astro';
import VistaPorQue from '../components/vistas/VistaPorQue.astro';
import VistaVisitanos from '../components/vistas/VistaVisitanos.astro';
---
<Layout>
  <Barra />
  <main id="contenido" tabindex="-1">
    <VistaInicio />
    <VistaNosotros />
    <VistaProductos />
    <VistaPorQue />
    <VistaVisitanos />
  </main>
</Layout>
