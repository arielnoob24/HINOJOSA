---
// Fuentes autoalojadas (@fontsource): 3 familias y 4 pesos (presupuesto de
// src/styles/tokens.css). Baloo 2 se retiro: Nunito 800 hace de titulo.
// Caveat Brush NO viene de @fontsource: es un subconjunto propio de ~9 kB
// (src/assets/fonts/caveat-brush-acento.woff2, @font-face en global.css).
import '@fontsource/nunito/latin-400.css';
import '@fontsource/nunito/latin-800.css';
import '@fontsource/cormorant-garamond/latin-700.css';
import '../styles/global.css';
import { negocio, catalogo } from '../lib/negocio';
import { IMAGEN_SOCIAL, TITULO, DESCRIPCION, urlAbsoluta, urlCanonica, localeOg, datosEstructurados, jsonLd } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
}

// Titulo y descripcion del negocio completo (src/lib/seo.ts). El router
// cambia document.title por vista en el cliente; el HTML servido lleva este.
const { title = TITULO, description = DESCRIPCION } = Astro.props;

// Sin `site` en astro.config.mjs (aun no hay dominio) estas URLs son null y
// se omiten canonical, og:url y og:image: Open Graph exige URL absoluta.
// Canonical unica: la portada (los hashes de vista no son paginas).
const canonical = urlCanonica(Astro.site);
const imagenSocial = urlAbsoluta(IMAGEN_SOCIAL.ruta, Astro.site);
const sitemap = Astro.site ? urlAbsoluta('/sitemap.xml', Astro.site) : null;
const esquema = jsonLd(datosEstructurados(Astro.site));

// QA M5: al entrar directo por #productos, la imagen LCP es el producto al
// frente. VistaProductos.astro la pinta ya en el HTML como fondo CSS de una
// tarjeta provisional (variante -400.avif) hasta que llega carrusel.ts. El
// script inline de abajo la precarga SOLO si la vista inicial es productos
// (en Inicio no se baja). Es la misma URL que elige el anillo en movil.
const primeraCategoria = catalogo.categorias.slice().sort((a, b) => a.orden - b.orden)[0]?.id;
const productoFrente = catalogo.productos.find((p) => p.categoria === primeraCategoria && p.imagen);
const precargaProductos = productoFrente?.imagen ? productoFrente.imagen.replace(/\.webp$/, '-400.avif') : null;
const arranque = `(function () {
  var html = document.documentElement;
  html.classList.add('js');
  // Bloque 14: sin boton de pausa no se restaura una pausa guardada (no
  // habria forma de quitarla); se borra la clave de visitas anteriores.
  try { localStorage.removeItem('hinojosa-movimiento'); } catch (e) {}
  var vistas = ['inicio', 'productos', 'nosotros', 'por-que', 'visitanos'];
  var h = location.hash.slice(1);
  var inicial = vistas.indexOf(h) > -1 ? h : 'inicio';
  html.setAttribute('data-router', 'arrancando');
  html.setAttribute('data-vista-inicial', inicial);
  // Con CSS 3D, la rejilla de respaldo no se pinta mientras llega el
  // carrusel: sus ~17 imagenes competian por la red con carrusel.js y
  // retrasaban el LCP de #productos (QA M5). carrusel-carga.ts quita la
  // marca si la carga falla o tarda (la rejilla vuelve a ser el respaldo).
  try {
    if (CSS.supports('perspective', '1px') && CSS.supports('transform-style', 'preserve-3d')) {
      html.setAttribute('data-carrusel-pendiente', '');
    }
  } catch (e) {}
  var pre = ${JSON.stringify(precargaProductos).replace(/</g, '\\u003c')};
  if (inicial === 'productos' && pre) {
    var l = document.createElement('link');
    l.rel = 'preload';
    l.as = 'image';
    l.type = 'image/avif';
    l.href = pre;
    l.setAttribute('fetchpriority', 'high');
    document.head.appendChild(l);
  }
})();`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b4d2b" />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
    {sitemap && <link rel="sitemap" type="application/xml" href={sitemap} />}

    <!-- Open Graph / redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeOg()} />
    <meta property="og:site_name" content={negocio.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {imagenSocial && (
      <>
        <meta property="og:image" content={imagenSocial} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content={String(IMAGEN_SOCIAL.width)} />
        <meta property="og:image:height" content={String(IMAGEN_SOCIAL.height)} />
        <meta property="og:image:alt" content={IMAGEN_SOCIAL.alt} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imagenSocial && (
      <>
        <meta name="twitter:image" content={imagenSocial} />
        <meta name="twitter:image:alt" content={IMAGEN_SOCIAL.alt} />
      </>
    )}

    <!-- Datos estructurados (schema.org): solo datos confirmados de negocio.json -->
    <script is:inline type="application/ld+json" set:html={esquema} />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Estado inicial, antes del primer pintado:
         - .js y la preferencia "Pausar animacion" guardada;
         - data-router + data-vista-inicial: solo la vista del hash se pinta
           mientras carga router.ts (sin esto se veria un instante la pagina
           apilada). Sin JS no se pone nada y las 5 vistas quedan apiladas.
         - si se entra por #productos: preload de la imagen del producto al
           frente (QA M5). -->
    <script is:inline set:html={arranque} />
  </head>
  <body>
    <a
      href="#contenido"
      class="saltar-contenido sr-only rounded-boton bg-bosque font-extrabold text-blanco shadow-elevada focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:px-5 focus:py-3"
      data-saltar-contenido
    >
      Saltar al contenido
    </a>
    <slot />

    <!-- Router de vistas (src/lib/router.ts). Las animaciones de la fase 4
         se enganchan a sus eventos; ver la cabecera de router.ts. -->
    <script>
      import '../lib/router';
      import '../lib/indicador-scroll';
    </script>
  </body>
</html>
